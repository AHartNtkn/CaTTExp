------------------------------------------------------------------------
-- ν(K) is generated by its atoms as an ω-category (ledger A5): every
-- cell is the value of an expression in the atoms. With
-- `Strict.Expr.FromWords`, existence in N2 reduces to the word problem
-- (Def) + (Inv) for these expressions.
------------------------------------------------------------------------
module CaTTExp.Strict.NuWords where

open import CaTTExp.Prelude
open import CaTTExp.Strict.Omega using (ωCat; _≤_; _<_)
open import CaTTExp.Strict.Nu
open import CaTTExp.Strict.FreeADC
open import CaTTExp.Strict.Atoms
open import CaTTExp.Strict.Generation
open import CaTTExp.Strict.Expr

module _ {N : Nat} (B : Basis N) (H : Hyp B) (L : Nat) where
  open Gen B H L
  open Atom B using (deg; K)

  -- Generators: atoms of dimension ≤ L.
  AtomG : Set
  AtomG = Σ Nat (λ i → (i < N) × (deg i ≤ L))

  ιν : AtomG → Cell K L
  ιν (i , iN , iL) = atom i iN iL

  open Eval (nu K L) ιν

  private
    module ν = ωCat (nu K L)

  gen-expr : ∀ {x} → Gen x → (cx : IsCell K L x) → Σ (Expr AtomG) (λ e → Ev e (x , cx))
  gen-expr (g-atom i iN iL) cx =
    gen (i , iN , iL) , subst (Ev (gen (i , iN , iL))) (≡-cell K L refl) (ev-gen (i , iN , iL))
  gen-expr (g-comp n {y} {z} gy gz m) cx =
    let (ey , vy) = gen-expr gy (gen-cell gy)
        (ez , vz) = gen-expr gz (gen-cell gz)
    in cmp n ey ez , subst (Ev (cmp n ey ez)) (≡-cell K L refl) (ev-cmp n vy vz (≡-cell K L m))

  generated : ∀ x → Σ (Expr AtomG) (λ e → Ev e x)
  generated (x , cx) = gen-expr (generation x cx) cx
