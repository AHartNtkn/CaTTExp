------------------------------------------------------------------------
-- Expressions over generators, and functors from the word problem
-- (ledger A5, existence half of N2, step E1).
--
-- An expression is a formal composite of generators, with boundaries.
-- In a strict ω-category with values for the generators it has at most
-- one value (`Ev`, a relation because composition is partial).
--
-- `functor`: let 𝒜 be generated by ι (every cell is the value of some
-- expression). Suppose that, for a second ω-category 𝒟 with values κ,
--   (Def) every expression with a value in 𝒜 has a value in 𝒟, and
--   (Inv) two expressions with the same value in 𝒜 have the same value
--         in 𝒟.
-- Then there is a strict functor 𝒜 → 𝒟 sending ι g to κ g. So, for
-- ν(K) generated by its atoms (`Strict.Generation`), existence in N2
-- is the word problem (Def) + (Inv).
------------------------------------------------------------------------
module CaTTExp.Strict.Expr where

open import CaTTExp.Prelude
open import CaTTExp.Strict.Omega

data Expr (G : Set) : Set where
  gen  : G → Expr G
  cmp  : Nat → Expr G → Expr G → Expr G
  bsrc : Nat → Expr G → Expr G
  btgt : Nat → Expr G → Expr G

module Eval (𝒞 : ωCat) {G : Set} (ι : G → ωCat.C 𝒞) where
  open ωCat 𝒞

  data Ev : Expr G → C → Set where
    ev-gen : ∀ g → Ev (gen g) (ι g)
    ev-cmp : ∀ n {e e′ x y} → Ev e x → Ev e′ y → (p : tgt n x ≡ src n y) → Ev (cmp n e e′) (comp n x y p)
    ev-src : ∀ n {e x} → Ev e x → Ev (bsrc n e) (src n x)
    ev-tgt : ∀ n {e x} → Ev e x → Ev (btgt n e) (tgt n x)

  ev-det : ∀ {e x y} → Ev e x → Ev e y → x ≡ y
  ev-det (ev-gen g)       (ev-gen .g)        = refl
  ev-det (ev-cmp n a b p) (ev-cmp .n a′ b′ q) = go (ev-det a a′) (ev-det b b′) p q
    where
    go : ∀ {x x′ y y′} → x ≡ x′ → y ≡ y′ → (p : tgt n x ≡ src n y) (q : tgt n x′ ≡ src n y′) →
         comp n x y p ≡ comp n x′ y′ q
    go refl refl p q = cong (comp n _ _) (uip p q)
  ev-det (ev-src n a)     (ev-src .n a′)     = cong (src n) (ev-det a a′)
  ev-det (ev-tgt n a)     (ev-tgt .n a′)     = cong (tgt n) (ev-det a a′)

record Functor (𝒜 𝒟 : ωCat) : Set where
  private
    module A = ωCat 𝒜
    module D = ωCat 𝒟
  field
    F      : A.C → D.C
    F-src  : ∀ n x → F (A.src n x) ≡ D.src n (F x)
    F-tgt  : ∀ n x → F (A.tgt n x) ≡ D.tgt n (F x)
    F-comp : ∀ n x y p q → F (A.comp n x y p) ≡ D.comp n (F x) (F y) q

module FromWords (𝒜 𝒟 : ωCat) {G : Set} (ι : G → ωCat.C 𝒜) (κ : G → ωCat.C 𝒟) where
  private
    module A = ωCat 𝒜
    module D = ωCat 𝒟
  module EA = Eval 𝒜 ι
  module ED = Eval 𝒟 κ

  Generated : Set
  Generated = ∀ x → Σ (Expr G) (λ e → EA.Ev e x)

  Def : Set
  Def = ∀ e x → EA.Ev e x → Σ D.C (λ y → ED.Ev e y)

  Inv : Set
  Inv = ∀ e e′ x y y′ → EA.Ev e x → EA.Ev e′ x → ED.Ev e y → ED.Ev e′ y′ → y ≡ y′

  module _ (gend : Generated) (def : Def) (inv : Inv) where
    private
      ex : ∀ x → Expr G
      ex x = fst (gend x)
      evx : ∀ x → EA.Ev (ex x) x
      evx x = snd (gend x)

    F : A.C → D.C
    F x = fst (def (ex x) x (evx x))

    F-ev : ∀ x → ED.Ev (ex x) (F x)
    F-ev x = snd (def (ex x) x (evx x))

    -- Any expression for x has value F x in 𝒟, when it has one.
    F-any : ∀ {e x y} → EA.Ev e x → ED.Ev e y → y ≡ F x
    F-any {e} {x} {y} a d = inv e (ex x) x y (F x) a (evx x) d (F-ev x)

    F-gen : ∀ g → F (ι g) ≡ κ g
    F-gen g = sym (F-any (EA.ev-gen g) (ED.ev-gen g))

    functor : Functor 𝒜 𝒟
    functor = record
      { F      = F
      ; F-src  = λ n x → sym (F-any (EA.ev-src n (evx x)) (ED.ev-src n (F-ev x)))
      ; F-tgt  = λ n x → sym (F-any (EA.ev-tgt n (evx x)) (ED.ev-tgt n (F-ev x)))
      ; F-comp = λ n x y p q → sym (F-any (EA.ev-cmp n (evx x) (evx y) p) (ED.ev-cmp n (F-ev x) (F-ev y) q))
      }
