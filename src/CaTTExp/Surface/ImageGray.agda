------------------------------------------------------------------------
-- The model.

envTops : Env → List TSet
envTops []ₑ      = []
envTops (ρ ,ₑ X) = envTops ρ ++ (top X ∷ [])

cohTL : Ctx → Ty → Tm → Tm → Env → Bag
cohTL Δ A t u ρ = applyF (envTops ρ) (if cohCase Δ A t u then [] else topT (homs Δ))

UnitL : Tower → Set
UnitL (base _)                 = ⊥
UnitL (step (base a) U c)      = (base a ≈w U) × (c ≈ ([] ∷ []))
UnitL (step (step S S′ d) U c) = (step S S′ d ≈w U) × (c ≈ [])

unit-parL : ∀ S U c → UnitL (step S U c) → S ≈w U
unit-parL (base _)     U c u = fst u
unit-parL (step _ _ _) U c u = fst u

------------------------------------------------------------------------
-- Generalities.

private
  infixr 1 _∙_
  _∙_ : ∀ {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
  _∙_ = trans

  ==-refl : ∀ n → (n ==ℕ n) ≡ true
  ==-refl zero    = refl
  ==-refl (suc n) = ==-refl n

  +0 : ∀ a → a + 0 ≡ a
  +0 zero    = refl
  +0 (suc a) = cong suc (+0 a)

  +s : ∀ a b → a + suc b ≡ suc (a + b)
  +s zero    b = refl
  +s (suc a) b = cong suc (+s a b)

  T-true : ∀ b → T b → b ≡ true
  T-true true _ = refl

  lenT : ∀ {A : Set} → List A → Nat
  lenT []       = 0
  lenT (_ ∷ xs) = suc (lenT xs)

  lenT-snoc : ∀ {A : Set} (xs : List A) x → lenT (xs ++ x ∷ []) ≡ suc (lenT xs)
  lenT-snoc []       x = refl
  lenT-snoc (y ∷ xs) x = cong suc (lenT-snoc xs x)

  map-++ : ∀ {A B : Set} (f : A → B) xs ys → map f (xs ++ ys) ≡ map f xs ++ map f ys
  map-++ f []       ys = refl
  map-++ f (x ∷ xs) ys = cong (f x ∷_) (map-++ f xs ys)

  filter-++ : ∀ {A : Set} (p : A → Bool) xs ys → filter p (xs ++ ys) ≡ filter p xs ++ filter p ys
  filter-++ p []       ys = refl
  filter-++ p (x ∷ xs) ys with p x
  ... | true  = cong (x ∷_) (filter-++ p xs ys)
  ... | false = filter-++ p xs ys

  concatMap-++ : ∀ {A B : Set} (f : A → List B) xs ys → concatMap f (xs ++ ys) ≡ concatMap f xs ++ concatMap f ys
  concatMap-++ f []       ys = refl
  concatMap-++ f (x ∷ xs) ys = cong (f x ++_) (concatMap-++ f xs ys) ∙ sym (++-assocL (f x) _ _)
    where
    ++-assocL : ∀ {A : Set} (xs ys zs : List A) → (xs ++ ys) ++ zs ≡ xs ++ (ys ++ zs)
    ++-assocL []       ys zs = refl
    ++-assocL (x ∷ xs) ys zs = cong (x ∷_) (++-assocL xs ys zs)

------------------------------------------------------------------------
-- The environment's tops, by level.

private
  nth-snoc : ∀ L (x : TSet) v → nth v (L ++ x ∷ []) ≡ (if v ==ℕ lenT L then x else nth v L)
  nth-snoc []      x zero    = refl
  nth-snoc []      x (suc v) = refl
  nth-snoc (y ∷ L) x zero    = refl
  nth-snoc (y ∷ L) x (suc v) = nth-snoc L x v

  len-envTops : ∀ ρ → lenT (envTops ρ) ≡ lenₑ ρ
  len-envTops []ₑ      = refl
  len-envTops (ρ ,ₑ X) = lenT-snoc (envTops ρ) (top X) ∙ cong suc (len-envTops ρ)

nth-envTops : ∀ ρ v → nth v (envTops ρ) ≡ top (lookupₑ ρ v)
nth-envTops []ₑ      zero    = refl
nth-envTops []ₑ      (suc v) = refl
nth-envTops (ρ ,ₑ X) v rewrite nth-snoc (envTops ρ) (top X) v | len-envTops ρ with v ==ℕ lenₑ ρ
... | true  = refl
... | false = nth-envTops ρ v

------------------------------------------------------------------------
-- Products with the unit tuple.

private
  map-id : ∀ (Y : TSet) → map (λ y → y) Y ≡ Y
  map-id []      = refl
  map-id (y ∷ Y) = cong (y ∷_) (map-id Y)

  prodT-unitʳ : ∀ X → prodT X ([] ∷ []) ≡ X
  prodT-unitʳ []      = refl
  prodT-unitʳ (x ∷ X) = cong₂ _∷_ (++-[]L x) (prodT-unitʳ X)

  prodT-unitˡ : ∀ Y → prodT ([] ∷ []) Y ≡ Y
  prodT-unitˡ Y = ++-[]L (map (λ y → y) Y) ∙ map-id Y

  unitL-prod : ∀ X Y → X ≈ ([] ∷ []) → prodT X Y ≈ Y
  unitL-prod X Y p =
    ≈-trans (≡→≈ (prodT-prod X Y))
      (≈-trans (prod-congˡ Y p) (≡→≈ (sym (prodT-prod ([] ∷ []) Y) ∙ prodT-unitˡ Y)))

  unitR-prod : ∀ X Y → Y ≈ ([] ∷ []) → prodT X Y ≈ X
  unitR-prod X Y p =
    ≈-trans (≡→≈ (prodT-prod X Y))
      (≈-trans (prod-congʳ X p) (≡→≈ (sym (prodT-prod X ([] ∷ [])) ∙ prodT-unitʳ X)))

  tp : Env → Nat → Bag
  tp ρ v = top (lookupₑ ρ v)

  FT1 : ∀ ρ a → Ftuple (envTops ρ) (a ∷ []) ≡ tp ρ a
  FT1 ρ a = prodT-unitʳ (nth a (envTops ρ)) ∙ nth-envTops ρ a

  FT2 : ∀ ρ a b → Ftuple (envTops ρ) (a ∷ b ∷ []) ≡ prodT (tp ρ a) (tp ρ b)
  FT2 ρ a b = cong₂ prodT (nth-envTops ρ a) (prodT-unitʳ (nth b (envTops ρ)) ∙ nth-envTops ρ b)

  -- c + 0 = c and 0 + c = c
  plus0 : ∀ X Y → Y ≈ [] → X ++ (Y ++ []) ≈ X
  plus0 X Y p = ≈-trans (++-cong (≈-refl {X}) (≡→≈ (++-[]L Y))) (≈-trans (++-cong (≈-refl {X}) p) (≡→≈ (++-[]L X)))

  zplus : ∀ X Y → X ≈ [] → X ++ (Y ++ []) ≈ Y
  zplus X Y p = ≈-trans (++-cong p (≈-refl {Y ++ []})) (≡→≈ (++-[]L Y))

------------------------------------------------------------------------
-- Identities.

private
  utop1 : ∀ X → tdim X ≡ 1 → UnitL X → top X ≈ ([] ∷ [])
  utop1 (base _)                _  ()
  utop1 (step (base _) U c)     _  u = snd u
  utop1 (step (step _ _ _) U c) () u

  utop2 : ∀ X m → tdim X ≡ suc (suc m) → UnitL X → top X ≈ []
  utop2 (base _)                m _  ()
  utop2 (step (base _) U c)     m () u
  utop2 (step (step _ _ _) U c) m _  u = snd u

------------------------------------------------------------------------
-- The top chain of a single-hom context ΣΘ: the top-dimensional
-- cells of Θ, as 1-tuples.

private
  prod1-nil : ∀ xs → prod1 xs [] ≡ []
  prod1-nil []       = refl
  prod1-nil (x ∷ xs) = prod1-nil xs

  prod1-unit : ∀ xs → prod1 xs ([] ∷ []) ≡ map (_∷ []) xs
  prod1-unit []       = refl
  prod1-unit (x ∷ xs) = cong ((x ∷ []) ∷_) (prod1-unit xs)

  chain0 : ∀ s m → T (0 <ℕ m) → chainT s m [] ≡ []
  chain0 s (suc m) _ = refl

  ∸-pos : ∀ k i → T (i <ℕ k) → T (0 <ℕ k ∸ i)
  ∸-pos (suc k) zero    _ = tt
  ∸-pos (suc k) (suc i) p = ∸-pos k i p

  ∸-self : ∀ k → k ∸ k ≡ 0
  ∸-self zero    = refl
  ∸-self (suc k) = ∸-self k

  filter-upto : ∀ m n → T (n <ℕ suc m) → filter (λ i → i <ℕ suc m) (upto n) ≡ upto n
  filter-upto m zero    _ = refl
  filter-upto m (suc n) p =
    filter-++ (λ i → i <ℕ suc m) (upto n) (suc n ∷ [])
    ∙ cong₂ _++_ (filter-upto m n (<-suc n m p)) (lem (T-true (suc n <ℕ suc m) p))
    where
    lem : (suc n <ℕ suc m) ≡ true → filter (λ i → i <ℕ suc m) (suc n ∷ []) ≡ suc n ∷ []
    lem e rewrite e = refl

  cm-zero-upto : ∀ (f : Nat → TSet) m → (∀ i → T (i <ℕ suc m) → f i ≡ []) → concatMap f (upto m) ≡ []
  cm-zero-upto f zero    h = cong (_++ []) (h 0 tt)
  cm-zero-upto f (suc m) h =
    concatMap-++ f (upto m) (suc m ∷ [])
    ∙ cong₂ _++_ (cm-zero-upto f m (λ i p → h i (<-suc i (suc m) p))) (cong (_++ []) (h (suc m) (n<sn (suc m))))

  cm-upto : ∀ (f : Nat → TSet) k → (∀ i → T (i <ℕ k) → f i ≡ []) → concatMap f (upto k) ≡ f k ++ []
  cm-upto f zero    h = refl
  cm-upto f (suc m) h =
    concatMap-++ f (upto m) (suc m ∷ []) ∙ cong (_++ (f (suc m) ++ [])) (cm-zero-upto f m h)

  chain1 : ∀ h s k → chainT s k (h ∷ []) ≡ map (_∷ []) (piece h k s)
  chain1 h s k =
    cong (concatMap f) (filter-upto k k (n<sn k))
    ∙ cm-upto f k (λ i p → cong (prod1 (piece h i s)) (chain0 (if odd i then not s else s) (k ∸ i) (∸-pos k i p)) ∙ prod1-nil (piece h i s))
    ∙ ++-[]L (f k)
    ∙ cong (λ m → prod1 (piece h k s) (chainT (if odd k then not s else s) m [])) (∸-self k)
    ∙ prod1-unit (piece h k s)
    where
    f : Nat → TSet
    f i = prod1 (piece h i s) (chainT (if odd i then not s else s) (k ∸ i) [])

  piece-top : ∀ h s → piece h (hd h) s ≡ map lvl (filter (λ c → hdim c ==ℕ hd h) (hcs h))
  piece-top h s rewrite ==-refl (hd h) = refl

  mkC-filter : ∀ d es → map (_∷ []) (map lvl (filter (λ c → hdim c ==ℕ d) (map mkC es)))
                        ≡ map (λ e → S (fst e) ∷ []) (filter (λ e → dim (snd e) ==ℕ d) es)
  mkC-filter d []       = refl
  mkC-filter d (e ∷ es) with dim (snd e) ==ℕ d
  ... | true  = cong ((S (fst e) ∷ []) ∷_) (mkC-filter d es)
  ... | false = mkC-filter d es

topΣ : ∀ Θ → topT (homs (Σctx Θ)) ≡ map (λ e → S (fst e) ∷ []) (filter (λ e → dim (snd e) ==ℕ dimCtx Θ) (entries Θ))
topΣ Θ =
  cong topT (homsΣ Θ)
  ∙ chain1 (hΣ Θ) true (hd (hΣ Θ) + 0)
  ∙ cong (λ n → map (_∷ []) (piece (hΣ Θ) n true)) (+0 (hd (hΣ Θ)))
  ∙ cong (map (_∷ [])) (piece-top (hΣ Θ) true)
  ∙ cong₂ (λ d cs → map (_∷ []) (map lvl (filter (λ c → hdim c ==ℕ d) cs))) (hdΣ Θ) (hcsΣ Θ ∙ cellsΣ Θ)
  ∙ mkC-filter (dimCtx Θ) (entries Θ)

------------------------------------------------------------------------
-- As a bag, the top-dimensional entries of Θ are its top-dimensional
-- variables (Strict.PsFacts.Wb).

Gt : Ctx → Nat → Bag
Gt Θ d = map (λ e → fst e ∷ []) (filter (λ e → dim (snd e) ==ℕ d) (entries Θ))

private
  len-last : ∀ Γ A → dimv (Γ ▸ A) (len Γ) ≡ dim A
  len-last Γ A rewrite ==-refl (len Γ) = refl

  Gt-snoc : ∀ Θ A d → Gt (Θ ▸ A) d ≡ Gt Θ d ++ (if dim A ==ℕ d then tup (len Θ) ∷ [] else [])
  Gt-snoc Θ A d =
    cong (map (λ e → fst e ∷ [])) (filter-++ (λ e → dim (snd e) ==ℕ d) (entries Θ) ((len Θ , A) ∷ []))
    ∙ map-++ (λ e → fst e ∷ []) (filter (λ e → dim (snd e) ==ℕ d) (entries Θ)) _
    ∙ cong (Gt Θ d ++_) (lem (dim A ==ℕ d))
    where
    lem : ∀ b → map (λ e → fst e ∷ []) (if b then (len Θ , A) ∷ [] else []) ≡ (if b then tup (len Θ) ∷ [] else [])
    lem true  = refl
    lem false = refl

  Wb-snoc : ∀ Θ A d → Wb (Θ ▸ A) d ≡ (if dim A ==ℕ d then tup (len Θ) ∷ Wb Θ d else Wb Θ d)
  Wb-snoc Θ A d =
    cong (λ n → if n ==ℕ d then tup (len Θ) ∷ R else R) (len-last Θ A)
    ∙ cong (λ X → if dim A ==ℕ d then tup (len Θ) ∷ X else X) (sel-ext Θ A d (downFrom (len Θ)) (Below-downFrom (len Θ)))
    where
    R = sel (Θ ▸ A) d (downFrom (len Θ))

GW : ∀ Θ d → Gt Θ d ≈ Wb Θ d
GW ε       d = ≈-refl
GW (Θ ▸ A) d = ≈-trans (≡→≈ (Gt-snoc Θ A d)) (≈-trans (stp (dim A ==ℕ d)) (≡→≈ (sym (Wb-snoc Θ A d))))
  where
  stp : ∀ b → Gt Θ d ++ (if b then tup (len Θ) ∷ [] else []) ≈ (if b then tup (len Θ) ∷ Wb Θ d else Wb Θ d)
  stp true  = ≈-trans (++-comm (Gt Θ d) (tup (len Θ) ∷ [])) (++-cong (≈-refl {tup (len Θ) ∷ []}) (GW Θ d))
  stp false = ≈-trans (≡→≈ (++-[]L (Gt Θ d))) (GW Θ d)

Wb-Dsk : ∀ n → Wb (Dsk n) n ≡ tup (dbl n) ∷ []
Wb-Dsk n =
  sel-hit (Dsk n) n (len (Sph n)) (downFrom (len (Sph n))) (len-last (Sph n) (aL n) ∙ dim-aL n)
  ∙ cong₂ _∷_ (cong tup (D.len-Sph n))
      (selDown (Dsk n) n (len (Sph n))
         (λ v p → subst (λ e → T (e <ℕ n)) (sym (dimv-wk (Sph n) (aL n) v p)) (sph-dv n v p)))

------------------------------------------------------------------------
-- Images of the top chains of the heads.

private
  aF-map : ∀ E (L : List (Nat × Ty)) →
           applyF E (map (λ e → S (fst e) ∷ []) L) ≡ cm (λ t → Ftuple E (map S t)) (map (λ e → fst e ∷ []) L)
  aF-map E []      = refl
  aF-map E (e ∷ L) = cong (Ftuple E (S (fst e) ∷ []) ++_) (aF-map E L)

  aF-mapq : ∀ E (q : Tuple → Tuple) (L : List (Nat × Ty)) →
            applyF E (map q (map (λ e → S (fst e) ∷ []) L)) ≡ cm (λ t → Ftuple E (q (map S t))) (map (λ e → fst e ∷ []) L)
  aF-mapq E q []      = refl
  aF-mapq E q (e ∷ L) = cong (Ftuple E (q (S (fst e) ∷ [])) ++_) (aF-mapq E q L)

-- k ≥ 1: single hom.
coreΣ : ∀ Θ Γ → Σctx Θ ≡ Γ → ∀ E →
        applyF E (topT (homs Γ)) ≈ cm (λ t → Ftuple E (map S t)) (Wb Θ (dimCtx Θ))
coreΣ Θ _ refl E =
  ≈-trans (≡→≈ (cong (applyF E) (topΣ Θ) ∙ aF-map E (filter (λ e → dim (snd e) ==ℕ dimCtx Θ) (entries Θ))))
          (cm-cong _ _ _ (GW Θ (dimCtx Θ)))

-- k = 0, right whiskers: the tuple (x, h).
coreW : ∀ j E → applyF E (topT (homs (BK 0 j))) ≈ Ftuple E (cJ j ∷ hJ j ∷ []) ++ []
coreW j E = subst (λ Γ → applyF E (topT (homs Γ)) ≈ Ftuple E (cJ j ∷ hJ j ∷ []) ++ []) (eqW j) inner
  where
  n = j + 0
  Θ = Dsk n
  g : Tuple → Bag
  g t = Ftuple E (app Θ (map S t))
  inner : applyF E (topT (homs (W Θ))) ≈ Ftuple E (cJ j ∷ hJ j ∷ []) ++ []
  inner =
    ≈-trans (≡→≈ (cong (applyF E) (topW Θ ∙ cong (map (app Θ)) (topΣ Θ))
                  ∙ aF-mapq E (app Θ) (filter (λ e → dim (snd e) ==ℕ dimCtx Θ) (entries Θ))))
      (≈-trans (cm-cong g _ _ (GW Θ (dimCtx Θ)))
        (≡→≈ (cong (λ d → cm g (Wb Θ d)) (D.dimCtx-Dsk n)
              ∙ cong (cm g) (Wb-Dsk n)
              ∙ cong (λ h → Ftuple E (cJ j ∷ h ∷ []) ++ []) (hl≡ j))))

-- k = 0, left whiskers: the tuple (h, x).
coreLW : ∀ j E → applyF E (topT (homs (LK 0 j))) ≈ Ftuple E (2 ∷ tL 0 j ∷ []) ++ []
coreLW j E = subst (λ Γ → applyF E (topT (homs Γ)) ≈ Ftuple E (2 ∷ tL 0 j ∷ []) ++ []) (eqLW j) inner
  where
  n = j + 0
  Θ = Dsk n
  g : Tuple → Bag
  g t = Ftuple E (F (map S t))
  inner : applyF E (topT (homs (LW Θ))) ≈ Ftuple E (2 ∷ tL 0 j ∷ []) ++ []
  inner =
    ≈-trans (≡→≈ (cong (applyF E) (topLW Θ (goodD n) ∙ cong (map F) (topΣ Θ))
                  ∙ aF-mapq E F (filter (λ e → dim (snd e) ==ℕ dimCtx Θ) (entries Θ))))
      (≈-trans (cm-cong g _ _ (GW Θ (dimCtx Θ)))
        (≡→≈ (cong (λ d → cm g (Wb Θ d)) (D.dimCtx-Dsk n) ∙ cong (cm g) (Wb-Dsk n))))

------------------------------------------------------------------------
-- The coherence case never applies to a head with k ≥ 1.

private
  sig : SigOK
  sig {k = ()} _ _

  sle : ∀ n → suc n ≤ n → ⊥
  sle zero    ()
  sle (suc n) (s≤s p) = sle n p

  nocoh : ∀ Γ → PsFacts Γ → ∀ A t u → Γ ⊢tm t ∶ A → dim A ≡ dimK (homs Γ) → cohCase Γ A t u ≡ false
  nocoh Γ P ⋆            t u dt e = refl
  nocoh Γ P (arr B s s′) t u dt e with cohCase Γ (arr B s s′) t u in q
  ... | false = refl
  ... | true  = ⊥-elim (sle (dimK (homs Γ))
                  (subst (λ k → suc (dimK (homs Γ)) ≤ k) e
                         (CD.cohB< closed (λ {G} {k} → sig {G} {k}) Γ P B s s′ t dt u (subst T (sym q) tt))))

  PB : ∀ k j → PsFacts (BK k j)
  PB k j with D.BK-ps k j
  ... | ps d = fst (ps-facts d)

  PL : ∀ k j → PsFacts (LK k j)
  PL k j with D.LK-ps k j
  ... | ps d = fst (ps-facts d)

  srcOf : ∀ {Γ A t u} → Γ ⊢ty arr A t u → Γ ⊢tm t ∶ A
  srcOf (arr-wf dt du) = dt

  dimKΣ′ : ∀ Θ Γ → Σctx Θ ≡ Γ → dimK (homs Γ) ≡ dimCtx Θ
  dimKΣ′ Θ _ refl = dimKΣ Θ

  ncR0 : ∀ k → cohCase (BK (suc k) 0) (aL (suc k)) (var (dbl (suc k))) (var (zK (suc k) 0)) ≡ false
  ncR0 k = nocoh (BK (suc k) 0) (PB (suc k) 0) (aL (suc k)) (var (dbl (suc k))) (var (zK (suc k) 0)) (srcOf (wK-wf (suc k) 0))
             (dim-aL (suc k) ∙ sym (dimKΣ′ (BK k 0) _ (Σ-BK k 0) ∙ D.dimCtx-BK k 0))

  ncR : ∀ k j → cohCase (BK (suc k) (suc j)) (wK (suc k) j [ ρsK (suc k) j ]ty)
                        (coh (BK (suc k) j) (wK (suc k) j) (ρsK (suc k) j))
                        (coh (BK (suc k) j) (wK (suc k) j) (ρtK (suc k) j)) ≡ false
  ncR k j = nocoh (BK (suc k) (suc j)) (PB (suc k) (suc j)) (wK (suc k) j [ ρsK (suc k) j ]ty) (coh (BK (suc k) j) (wK (suc k) j) (ρsK (suc k) j)) (coh (BK (suc k) j) (wK (suc k) j) (ρtK (suc k) j))
              (srcOf (wK-wf (suc k) (suc j)))
              (dim[] (wK (suc k) j) (ρsK (suc k) j) ∙ dim-wK (suc k) j ∙ cong suc (+s j k)
               ∙ sym (dimKΣ′ (BK k (suc j)) _ (Σ-BK k (suc j)) ∙ D.dimCtx-BK k (suc j)))

  ncLs : ∀ k j → cohCase (LK (suc k) (suc j)) (lK (suc k) j [ λsK (suc k) j ]ty)
                         (coh (LK (suc k) j) (lK (suc k) j) (λsK (suc k) j))
                         (coh (LK (suc k) j) (lK (suc k) j) (λtK (suc k) j)) ≡ false
  ncLs k j = nocoh (LK (suc k) (suc j)) (PL (suc k) (suc j)) (lK (suc k) j [ λsK (suc k) j ]ty) (coh (LK (suc k) j) (lK (suc k) j) (λsK (suc k) j)) (coh (LK (suc k) j) (lK (suc k) j) (λtK (suc k) j))
               (srcOf (lK-wf (suc k) (suc j)))
               (dim[] (lK (suc k) j) (λsK (suc k) j) ∙ dim-lK (suc k) j ∙ cong suc (+s j k)
                ∙ sym (dimKΣ′ (LK k (suc j)) _ (Σ-LK k (suc j)) ∙ D.dimCtx-LK k (suc j)))

  cohTL-op : ∀ Δ A t u ρ → cohCase Δ A t u ≡ false → cohTL Δ A t u ρ ≡ applyF (envTops ρ) (topT (homs Δ))
  cohTL-op Δ A t u ρ e rewrite e = refl

  -- the head (k+1, 0): top chain h + x (h at suc (zK (k+1) 0), x at dbl (k+2))
  core0 : ∀ k ρ → cohTL (BK (suc k) 0) (aL (suc k)) (var (dbl (suc k))) (var (zK (suc k) 0)) ρ
                  ≈ tp ρ (suc (zK (suc k) 0)) ++ (tp ρ (dbl (suc (suc k))) ++ [])
  core0 k ρ =
    ≈-trans (≡→≈ (cohTL-op (BK (suc k) 0) (aL (suc k)) (var (dbl (suc k))) (var (zK (suc k) 0)) ρ (ncR0 k)))
      (≈-trans (coreΣ (BK k 0) (BK (suc k) 0) (Σ-BK k 0) (envTops ρ))
        (≡→≈ (cong (λ d → cm g (Wb (BK k 0) d)) (D.dimCtx-BK k 0)
              ∙ cong (cm g) (Wb-BK0 k)
              ∙ cong₂ (λ X Y → X ++ (Y ++ [])) (FT1 ρ _) (FT1 ρ _))))
    where
    g : Tuple → Bag
    g t = Ftuple (envTops ρ) (map S t)

------------------------------------------------------------------------
-- Strict unitality on the heads.

HR0L : ∀ k ρ → tdim (lookupₑ ρ (suc (zK k 0))) ≡ suc k → UnitL (lookupₑ ρ (suc (zK k 0))) →
       cohTL (BK k 0) (aL k) (var (dbl k)) (var (zK k 0)) ρ ≈ top (lookupₑ ρ (dbl (nB k 0)))
HR0L zero ρ d u =
  ≈-trans (coreW 0 (envTops ρ))
    (≈-trans (≡→≈ (++-[]L _ ∙ FT2 ρ (cJ 0) (hJ 0))) (unitR-prod _ _ (utop1 _ d u)))
HR0L (suc k) ρ d u = ≈-trans (core0 k ρ) (zplus _ _ (utop2 _ k d u))

HRL : ∀ k j ρ → tdim (lookupₑ ρ (suc (zK k (suc j)))) ≡ suc k → UnitL (lookupₑ ρ (suc (zK k (suc j)))) →
      cohTL (BK k (suc j)) (wK k j [ ρsK k j ]ty)
            (coh (BK k j) (wK k j) (ρsK k j)) (coh (BK k j) (wK k j) (ρtK k j)) ρ
        ≈ top (lookupₑ ρ (dbl (nB k (suc j))))
HRL zero j ρ d u =
  ≈-trans (≡→≈ (cohTL-op (BK 0 (suc j)) (wK 0 j [ ρsK 0 j ]ty) (coh (BK 0 j) (wK 0 j) (ρsK 0 j)) (coh (BK 0 j) (wK 0 j) (ρtK 0 j)) ρ (nc0 (suc j))))
    (≈-trans (coreW (suc j) (envTops ρ))
      (≈-trans (≡→≈ (++-[]L _ ∙ FT2 ρ (cJ (suc j)) (hJ (suc j)))) (unitR-prod _ _ (utop1 _ d u))))
HRL (suc k) j ρ d u =
  ≈-trans (≡→≈ (cohTL-op (BK (suc k) (suc j)) (wK (suc k) j [ ρsK (suc k) j ]ty) (coh (BK (suc k) j) (wK (suc k) j) (ρsK (suc k) j)) (coh (BK (suc k) j) (wK (suc k) j) (ρtK (suc k) j)) ρ (ncR k j)))
    (≈-trans (coreΣ (BK k (suc j)) (BK (suc k) (suc j)) (Σ-BK k (suc j)) (envTops ρ))
      (≡→≈ (cong (λ d → cm g (Wb (BK k (suc j)) d)) (D.dimCtx-BK k (suc j))
            ∙ cong (cm g) (Wb-BK k j)
            ∙ ++-[]L _ ∙ FT1 ρ _
            ∙ cong (λ m → tp ρ (dbl (suc (suc m)))) (sym (+s j k)))))
  where
  g : Tuple → Bag
  g t = Ftuple (envTops ρ) (map S t)

HL0L : ∀ k ρ → tdim (lookupₑ ρ (dbl (suc k))) ≡ suc k → UnitL (lookupₑ ρ (dbl (suc k))) →
       cohTL (LK k 0) (aL k) (var (dbl k)) (var (zK k 0)) ρ ≈ top (lookupₑ ρ (tL k 0))
HL0L zero ρ d u =
  ≈-trans (coreW 0 (envTops ρ))
    (≈-trans (≡→≈ (++-[]L _ ∙ FT2 ρ (cJ 0) (hJ 0))) (unitL-prod _ _ (utop1 _ d u)))
HL0L (suc k) ρ d u = ≈-trans (core0 k ρ) (plus0 _ _ (utop2 _ k d u))

HLL : ∀ k j ρ → tdim (lookupₑ ρ (dbl (suc k))) ≡ suc k → UnitL (lookupₑ ρ (dbl (suc k))) →
      cohTL (LK k (suc j)) (lK k j [ λsK k j ]ty)
            (coh (LK k j) (lK k j) (λsK k j)) (coh (LK k j) (lK k j) (λtK k j)) ρ
        ≈ top (lookupₑ ρ (tL k (suc j)))
HLL zero j ρ d u =
  ≈-trans (≡→≈ (cohTL-op (LK 0 (suc j)) (lK 0 j [ λsK 0 j ]ty) (coh (LK 0 j) (lK 0 j) (λsK 0 j)) (coh (LK 0 j) (lK 0 j) (λtK 0 j)) ρ (ncL (suc j))))
    (≈-trans (coreLW (suc j) (envTops ρ))
      (≈-trans (≡→≈ (++-[]L _ ∙ FT2 ρ 2 (tL 0 (suc j)))) (unitL-prod _ _ (utop1 _ d u))))
HLL (suc k) j ρ d u =
  ≈-trans (≡→≈ (cohTL-op (LK (suc k) (suc j)) (lK (suc k) j [ λsK (suc k) j ]ty) (coh (LK (suc k) j) (lK (suc k) j) (λsK (suc k) j)) (coh (LK (suc k) j) (lK (suc k) j) (λtK (suc k) j)) ρ (ncLs k j)))
    (≈-trans (coreΣ (LK k (suc j)) (LK (suc k) (suc j)) (Σ-LK k (suc j)) (envTops ρ))
      (≡→≈ (cong (λ d → cm g (Wb (LK k (suc j)) d)) (D.dimCtx-LK k (suc j))
            ∙ cong (cm g) (Wb-LK k j)
            ∙ ++-[]L _ ∙ FT1 ρ _
            ∙ cong (λ m → tp ρ (dbl (suc (suc (suc m))))) (sym (+s j k)))))
  where
  g : Tuple → Bag
  g t = Ftuple (envTops ρ) (map S t)

