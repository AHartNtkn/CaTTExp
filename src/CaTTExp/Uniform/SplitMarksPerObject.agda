------------------------------------------------------------------------
-- Split marks imposed per object (ledger E15(d); notes/design-decisions.md
-- §1.9; spec §2.3).
--
-- CaTTExp.Uniform.SplitMarks computes a head's law set as the meet S(Γ)
-- of the splits carried by its objects a₁ … aₙ. The finer reading of the
-- marks imposes each split only on the inner crossings that land in an
-- object carrying it. Here the instances of the two split laws on raw
-- degree-4 syntax (CaTTExp.Join.SwitchLaws) are gated by the marks of a
-- landing object, given abstractly:
--
--   land F G   the object the crossing ι(F, G) lands in (the target of
--              its hom), for a crossing of a composite operand;
--   mk o       the split marks carried by object o.
--
-- Proved (no postulates):
--   * with constant marks s, the per-object laws are exactly the
--     setting-s laws                                   (const-⊆, const-⊇)
--   * a lower bound s of all marks (e.g. the meet S∧) gives fewer
--     laws, and an upper bound (e.g. both splits) more:
--     Law S∧ ⊆ LawO ⊆ Law allS, and so on their generated congruences
--     (split laws only, untyped raw 4-terms; V's own equations and
--     T₁₂ are not modelled here)                     (lower-⊆, upper-⊆)
--   * stronger marks give more laws                    (mark-mono)
--   * all of these lift to the generated congruences   (cong-map)
--   * both sides of every per-object law are pure inner, so seed lists
--     are kept                                         (lawO-inner, seedsO-≈)
-- Not mechanized: the landing-object function on actual pasting
-- contexts (`land` is a free parameter); substitution (mark-mono
-- covers re-marking one context only); the decision procedure (paper, design-
-- decisions.md §1.9, extending r10 Response 3 to a selected sublist of
-- ground instances).
------------------------------------------------------------------------
module CaTTExp.Uniform.SplitMarksPerObject where

open import CaTTExp.Prelude
import CaTTExp.Join.SwitchLaws as SL
open SL using (Switches; IsTrue)
open SL.Switches using (icc; rsp)

module PerObject (G1 G2 G3 G4 Obj : Set) where
  open SL.PartA G1 G2 G3 G4
  open import CaTTExp.Join.SepAlgebra using (module Theory)
  open Theory G1 G2 G3 G4

  -- The congruence generated by any relation on 4-terms.
  infix 3 _⊢_≈_
  data _⊢_≈_ (R : T4 → T4 → Set) : T4 → T4 → Set where
    law    : ∀ {X Y} → R X Y → R ⊢ X ≈ Y
    rfl    : ∀ {X} → R ⊢ X ≈ X
    sym≈   : ∀ {X Y} → R ⊢ X ≈ Y → R ⊢ Y ≈ X
    trans≈ : ∀ {X Y Z} → R ⊢ X ≈ Y → R ⊢ Y ≈ Z → R ⊢ X ≈ Z
    ·-cong : ∀ {X X′ Y Y′} → R ⊢ X ≈ X′ → R ⊢ Y ≈ Y′ → R ⊢ X · Y ≈ X′ · Y′
    ctx-c  : ∀ p q {X X′} → R ⊢ X ≈ X′ → R ⊢ ctx p X q ≈ ctx p X′ q
    wl4-c  : ∀ a {X X′} → R ⊢ X ≈ X′ → R ⊢ wl4 a X ≈ wl4 a X′
    wr4-c  : ∀ {X X′} a → R ⊢ X ≈ X′ → R ⊢ wr4 X a ≈ wr4 X′ a
    w1L-c  : ∀ f {X X′} → R ⊢ X ≈ X′ → R ⊢ w1L₄ f X ≈ w1L₄ f X′
    w1R-c  : ∀ {X X′} f → R ⊢ X ≈ X′ → R ⊢ w1R₄ X f ≈ w1R₄ X′ f

  cong-map : ∀ {R R′ : T4 → T4 → Set} → (∀ {X Y} → R X Y → R′ X Y) →
             ∀ {X Y} → R ⊢ X ≈ Y → R′ ⊢ X ≈ Y
  cong-map f (law l)       = law (f l)
  cong-map f rfl           = rfl
  cong-map f (sym≈ p)      = sym≈ (cong-map f p)
  cong-map f (trans≈ p q)  = trans≈ (cong-map f p) (cong-map f q)
  cong-map f (·-cong p q)  = ·-cong (cong-map f p) (cong-map f q)
  cong-map f (ctx-c p q e) = ctx-c p q (cong-map f e)
  cong-map f (wl4-c a e)   = wl4-c a (cong-map f e)
  cong-map f (wr4-c a e)   = wr4-c a (cong-map f e)
  cong-map f (w1L-c g e)   = w1L-c g (cong-map f e)
  cong-map f (w1R-c g e)   = w1R-c g (cong-map f e)

  -- The per-object laws: a split instance is present iff the object its
  -- crossing lands in carries that split.
  data LawO (land : T3 → T3 → Obj) (mk : Obj → Switches) : T4 → T4 → Set where
    splitL : ∀ F F′ G v v′ e e′ → IsTrue (icc (mk (land (F ⨾ F′) G))) →
             LawO land mk (ι (F ⨾ F′) G)
                  (ctx (id3 e) (ι F G) (wr F′ v′) · ctx (wr F v) (ι F′ G) (id3 e′))
    splitR : ∀ F G G′ u u′ e e′ → IsTrue (rsp (mk (land F (G ⨾ G′)))) →
             LawO land mk (ι F (G ⨾ G′))
                  (ctx (wl u G) (ι F G′) (id3 e) · ctx (id3 e′) (ι F G) (wl u′ G′))

  module _ (land : T3 → T3 → Obj) where

    -- Constant marks give exactly the old setting.
    const-⊆ : ∀ s (mk : Obj → Switches) → (∀ o → mk o ≡ s) →
              ∀ {X Y} → LawO land mk X Y → Law s X Y
    const-⊆ s mk e (splitL F F′ G v v′ e₁ e₂ h)
      rewrite e (land (F ⨾ F′) G) = splitL h F F′ G v v′ e₁ e₂
    const-⊆ s mk e (splitR F G G′ u u′ e₁ e₂ h)
      rewrite e (land F (G ⨾ G′)) = splitR h F G G′ u u′ e₁ e₂

    const-⊇ : ∀ s (mk : Obj → Switches) → (∀ o → mk o ≡ s) →
              ∀ {X Y} → Law s X Y → LawO land mk X Y
    const-⊇ s mk e (splitL h F F′ G v v′ e₁ e₂) =
      splitL F F′ G v v′ e₁ e₂ (subst (λ z → IsTrue (icc z)) (sym (e _)) h)
    const-⊇ s mk e (splitR h F G G′ u u′ e₁ e₂) =
      splitR F G G′ u u′ e₁ e₂ (subst (λ z → IsTrue (rsp z)) (sym (e _)) h)

    -- A lower bound of the marks (the meet) gives a sub-relation.
    lower-⊆ : ∀ s (mk : Obj → Switches) → (∀ o → s ≤S mk o) →
              ∀ {X Y} → Law s X Y → LawO land mk X Y
    lower-⊆ s mk le (splitL h F F′ G v v′ e₁ e₂) =
      splitL F F′ G v v′ e₁ e₂ (fst (le _) h)
    lower-⊆ s mk le (splitR h F G G′ u u′ e₁ e₂) =
      splitR F G G′ u u′ e₁ e₂ (snd (le _) h)

    -- An upper bound (both splits: T₁₂) gives a super-relation.
    upper-⊆ : ∀ s (mk : Obj → Switches) → (∀ o → mk o ≤S s) →
              ∀ {X Y} → LawO land mk X Y → Law s X Y
    upper-⊆ s mk le (splitL F F′ G v v′ e₁ e₂ h) = splitL (fst (le _) h) F F′ G v v′ e₁ e₂
    upper-⊆ s mk le (splitR F G G′ u u′ e₁ e₂ h) = splitR (snd (le _) h) F G G′ u u′ e₁ e₂

    -- Stronger marks give more laws.
    mark-mono : ∀ (mk mk′ : Obj → Switches) → (∀ o → mk o ≤S mk′ o) →
                ∀ {X Y} → LawO land mk X Y → LawO land mk′ X Y
    mark-mono mk mk′ le (splitL F F′ G v v′ e₁ e₂ h) =
      splitL F F′ G v v′ e₁ e₂ (fst (le _) h)
    mark-mono mk mk′ le (splitR F G G′ u u′ e₁ e₂ h) =
      splitR F G G′ u u′ e₁ e₂ (snd (le _) h)

    -- The chain V + meet → V + per-object → T₁₂ on the congruences.
    meet→perObject : ∀ s mk → (∀ o → s ≤S mk o) →
                     ∀ {X Y} → Law s ⊢ X ≈ Y → LawO land mk ⊢ X ≈ Y
    meet→perObject s mk le = cong-map (lower-⊆ s mk le)

    perObject→all : ∀ mk → ∀ {X Y} → LawO land mk ⊢ X ≈ Y → Law SL.allS ⊢ X ≈ Y
    perObject→all mk = cong-map (upper-⊆ SL.allS mk (λ o → (λ _ → SL.tt′) , (λ _ → SL.tt′)))

    -- Both sides are pure inner, so seed lists are kept.
    lawO-inner : ∀ {mk X Y} → LawO land mk X Y → Inner4 X × Inner4 Y
    lawO-inner (splitL F F′ G v v′ e e′ _) =
      i-ι _ _ , i-· (i-ctx _ _ (i-ι F G)) (i-ctx _ _ (i-ι F′ G))
    lawO-inner (splitR F G G′ u u′ e e′ _) =
      i-ι _ _ , i-· (i-ctx _ _ (i-ι F G′)) (i-ctx _ _ (i-ι F G))

    seedsO-≈ : ∀ {mk X Y} → LawO land mk ⊢ X ≈ Y → seeds4 X ≡ seeds4 Y
    seedsO-≈ (law l) with lawO-inner l
    ... | x , y = trans (inner-seeds x) (sym (inner-seeds y))
    seedsO-≈ rfl            = refl
    seedsO-≈ (sym≈ p)       = sym (seedsO-≈ p)
    seedsO-≈ (trans≈ p q)   = trans (seedsO-≈ p) (seedsO-≈ q)
    seedsO-≈ (·-cong p q)   = cong₂ _++_ (seedsO-≈ p) (seedsO-≈ q)
    seedsO-≈ (ctx-c p q e)  = seedsO-≈ e
    seedsO-≈ (wl4-c a e)    = seedsO-≈ e
    seedsO-≈ (wr4-c a e)    = seedsO-≈ e
    seedsO-≈ (w1L-c f e)    = seedsO-≈ e
    seedsO-≈ (w1R-c f e)    = seedsO-≈ e
