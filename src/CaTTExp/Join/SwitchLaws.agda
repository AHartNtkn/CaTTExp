------------------------------------------------------------------------
-- The law switches of J keep seed lists
-- (notes/design-decisions.md §1, ledger E12; joining-completion.md §8).
--
-- The side condition computes in V + S, where the switch set S ranges
-- over the laws visible on pasting diagrams (design-decisions.md §1.7):
-- the inner composite-crossing law and the right split R. Each is a
-- split equation for the inner interchanger ι. The left splits L_p and
-- the D_{d,p} are invisible on pasting diagrams, so they are not
-- switches. The settings offered are none (V) and all (T₁₂'s profile).
--
-- Part A (raw syntax of T, from CaTTExp.Join.SepAlgebra):
--   Inner4         4-terms built from ι, identities, composition,
--                  contexts and whiskerings only (no r, t, generators);
--   Law sw X Y     the switched laws, as schemas on raw terms:
--                  splitL / splitR (binary unrestricted splits of either
--                  operand, the inner composite-crossing law),
--                  and splitR alone (R), each available when its
--                  switch is on;
--   law-inner      both sides of every switched law are Inner4;
--   seeds4         the seed list of a 4-term: its r, t and generator
--                  letters, in order;
--   seeds4-≈       the congruence generated by any switched laws keeps
--                  seed lists.
--
-- Part B (comparison-quiver level, CaTTExp.Join.Cospan): adding any
-- family Eq of equations between inner words to the completion's ~
-- keeps seed lists (seeds-~L).
--
-- Not mechanized: the link between Parts A and B. There is no map from
-- Inner4 terms to inner words, and no proof that the switched laws
-- instantiate Eq; that they do is by inspection (ι-instances are inner
-- arrows, the rest is context).
--
-- Part C records the paper argument that with 3-cells as vertices a
-- setting does not depend on its switches; it is a definition, not a
-- proof (see there).
------------------------------------------------------------------------
open import CaTTExp.Prelude
open import CaTTExp.Join.Quiver
import CaTTExp.Join.SepAlgebra as Sep
import CaTTExp.Join.Cospan as Cospan
import CaTTExp.Join.SwitchCospan as SC

module CaTTExp.Join.SwitchLaws where

-- Which visible laws are on.
record Switches : Set where
  field
    icc  : Bool          -- inner composite-crossing law (both splits)
    rsp  : Bool          -- right split R
open Switches

-- The settings offered (design-decisions.md §1.7): vS, no switch on,
-- the default, where the side condition computes in V; and allS, both
-- on, which has T₁₂'s pasting profile. Intermediate settings wait on r9.
vS allS : Switches
vS   = record { icc = false ; rsp = false }
allS = record { icc = true  ; rsp = true  }

data IsTrue : Bool → Set where
  tt′ : IsTrue true

module PartA (G1 G2 G3 G4 : Set) where
  open Sep.Theory G1 G2 G3 G4

  -- Pure-ι 4-terms.
  data Inner4 : T4 → Set where
    i-id   : ∀ F → Inner4 (id4 F)
    i-ι    : ∀ F G → Inner4 (ι F G)
    i-·    : ∀ {X Y} → Inner4 X → Inner4 Y → Inner4 (X · Y)
    i-ctx  : ∀ p {X} q → Inner4 X → Inner4 (ctx p X q)
    i-wl4  : ∀ a {X} → Inner4 X → Inner4 (wl4 a X)
    i-wr4  : ∀ {X} a → Inner4 X → Inner4 (wr4 X a)
    i-w1L  : ∀ f {X} → Inner4 X → Inner4 (w1L₄ f X)
    i-w1R  : ∀ {X} f → Inner4 X → Inner4 (w1R₄ X f)

  -- The switched laws.
  data Law (sw : Switches) : T4 → T4 → Set where
    splitL : IsTrue (icc sw) → ∀ F F′ G v v′ e e′ →
             Law sw (ι (F ⨾ F′) G)
                    (ctx (id3 e) (ι F G) (wr F′ v′) · ctx (wr F v) (ι F′ G) (id3 e′))
    splitR-icc : IsTrue (icc sw) → ∀ F G G′ u u′ e e′ →
             Law sw (ι F (G ⨾ G′))
                    (ctx (wl u G) (ι F G′) (id3 e) · ctx (id3 e′) (ι F G) (wl u′ G′))
    splitR : IsTrue (rsp sw) → ∀ F G G′ u u′ e e′ →
             Law sw (ι F (G ⨾ G′))
                    (ctx (wl u G) (ι F G′) (id3 e) · ctx (id3 e′) (ι F G) (wl u′ G′))

  law-inner : ∀ {sw X Y} → Law sw X Y → Inner4 X × Inner4 Y
  law-inner (splitL _ F F′ G v v′ e e′) =
    i-ι _ _ , i-· (i-ctx _ _ (i-ι F G)) (i-ctx _ _ (i-ι F′ G))
  law-inner (splitR-icc _ F G G′ u u′ e e′) =
    i-ι _ _ , i-· (i-ctx _ _ (i-ι F G′)) (i-ctx _ _ (i-ι F G))
  law-inner (splitR _ F G G′ u u′ e e′) =
    i-ι _ _ , i-· (i-ctx _ _ (i-ι F G′)) (i-ctx _ _ (i-ι F G))

  -- Seed letters of a 4-term.
  data Seed4 : Set where
    s-gen : G4 → Seed4
    s-r   : T3 → T2 → Seed4
    s-t   : T2 → T3 → Seed4

  seeds4 : T4 → List Seed4
  seeds4 (gen4 g)     = s-gen g ∷ []
  seeds4 (id4 F)      = []
  seeds4 (ι F G)      = []
  seeds4 (r A b)      = s-r A b ∷ []
  seeds4 (t a B)      = s-t a B ∷ []
  seeds4 (X · Y)      = seeds4 X ++ seeds4 Y
  seeds4 (ctx p X q)  = seeds4 X
  seeds4 (wl4 a X)    = seeds4 X
  seeds4 (wr4 X a)    = seeds4 X
  seeds4 (w1L₄ f X)   = seeds4 X
  seeds4 (w1R₄ X f)   = seeds4 X

  inner-seeds : ∀ {X} → Inner4 X → seeds4 X ≡ []
  inner-seeds (i-id F)      = refl
  inner-seeds (i-ι F G)     = refl
  inner-seeds (i-· x y)     = cong₂ _++_ (inner-seeds x) (inner-seeds y)
  inner-seeds (i-ctx p q x) = inner-seeds x
  inner-seeds (i-wl4 a x)   = inner-seeds x
  inner-seeds (i-wr4 a x)   = inner-seeds x
  inner-seeds (i-w1L f x)   = inner-seeds x
  inner-seeds (i-w1R f x)   = inner-seeds x

  law-seeds : ∀ {sw X Y} → Law sw X Y → seeds4 X ≡ seeds4 Y
  law-seeds l with law-inner l
  ... | x , y = trans (inner-seeds x) (sym (inner-seeds y))

  -- The congruence generated by the switched laws.
  infix 3 _⊢_≈L_
  data _⊢_≈L_ (sw : Switches) : T4 → T4 → Set where
    law    : ∀ {X Y} → Law sw X Y → sw ⊢ X ≈L Y
    rfl    : ∀ {X} → sw ⊢ X ≈L X
    sym≈   : ∀ {X Y} → sw ⊢ X ≈L Y → sw ⊢ Y ≈L X
    trans≈ : ∀ {X Y Z} → sw ⊢ X ≈L Y → sw ⊢ Y ≈L Z → sw ⊢ X ≈L Z
    ·-cong : ∀ {X X′ Y Y′} → sw ⊢ X ≈L X′ → sw ⊢ Y ≈L Y′ → sw ⊢ X · Y ≈L X′ · Y′
    ctx-c  : ∀ p q {X X′} → sw ⊢ X ≈L X′ → sw ⊢ ctx p X q ≈L ctx p X′ q
    wl4-c  : ∀ a {X X′} → sw ⊢ X ≈L X′ → sw ⊢ wl4 a X ≈L wl4 a X′
    wr4-c  : ∀ {X X′} a → sw ⊢ X ≈L X′ → sw ⊢ wr4 X a ≈L wr4 X′ a
    w1L-c  : ∀ f {X X′} → sw ⊢ X ≈L X′ → sw ⊢ w1L₄ f X ≈L w1L₄ f X′
    w1R-c  : ∀ {X X′} f → sw ⊢ X ≈L X′ → sw ⊢ w1R₄ X f ≈L w1R₄ X′ f

  seeds4-≈ : ∀ {sw X Y} → sw ⊢ X ≈L Y → seeds4 X ≡ seeds4 Y
  seeds4-≈ (law l)        = law-seeds l
  seeds4-≈ rfl            = refl
  seeds4-≈ (sym≈ p)       = sym (seeds4-≈ p)
  seeds4-≈ (trans≈ p q)   = trans (seeds4-≈ p) (seeds4-≈ q)
  seeds4-≈ (·-cong p q)   = cong₂ _++_ (seeds4-≈ p) (seeds4-≈ q)
  seeds4-≈ (ctx-c p q e)  = seeds4-≈ e
  seeds4-≈ (wl4-c a e)    = seeds4-≈ e
  seeds4-≈ (wr4-c a e)    = seeds4-≈ e
  seeds4-≈ (w1L-c f e)    = seeds4-≈ e
  seeds4-≈ (w1R-c f e)    = seeds4-≈ e

  -- Switching more laws on is the identity on terms and enlarges ≈L.
  _≤S_ : Switches → Switches → Set
  s ≤S s′ = (IsTrue (icc s) → IsTrue (icc s′)) ×
            (IsTrue (rsp s) → IsTrue (rsp s′))

  law-mono : ∀ {s s′} → s ≤S s′ → ∀ {X Y} → Law s X Y → Law s′ X Y
  law-mono (i , _) (splitL h F F′ G v v′ e e′)     = splitL (i h) F F′ G v v′ e e′
  law-mono (i , _) (splitR-icc h F G G′ u u′ e e′) = splitR-icc (i h) F G G′ u u′ e e′
  law-mono (_ , j) (splitR h F G G′ u u′ e e′)     = splitR (j h) F G G′ u u′ e e′

  vS≤allS : vS ≤S allS
  vS≤allS = (λ ()) , (λ ())

  ≈-mono : ∀ {s s′} → s ≤S s′ → ∀ {X Y} → s ⊢ X ≈L Y → s′ ⊢ X ≈L Y
  ≈-mono le (law l)       = law (law-mono le l)
  ≈-mono le rfl           = rfl
  ≈-mono le (sym≈ p)      = sym≈ (≈-mono le p)
  ≈-mono le (trans≈ p q)  = trans≈ (≈-mono le p) (≈-mono le q)
  ≈-mono le (·-cong p q)  = ·-cong (≈-mono le p) (≈-mono le q)
  ≈-mono le (ctx-c p q e) = ctx-c p q (≈-mono le e)
  ≈-mono le (wl4-c a e)   = wl4-c a (≈-mono le e)
  ≈-mono le (wr4-c a e)   = wr4-c a (≈-mono le e)
  ≈-mono le (w1L-c f e)   = w1L-c f (≈-mono le e)
  ≈-mono le (w1R-c f e)   = w1R-c f (≈-mono le e)

------------------------------------------------------------------------
-- Part B: switched equations between inner words keep seed lists in
-- the cospan completion.

module PartB {V : Set} (E P : V → V → Set)
             (Eq : ∀ {a b} → Path E a b → Path E a b → Set) where
  open Cospan E P

  infix 4 _~L_
  data _~L_ {a b} : Word a b → Word a b → Set where
    base   : ∀ {w w′} → w ~ w′ → w ~L w′
    eq     : ∀ {c d} (l : Word a c) {I J : Path E c d} (r : Word d b) →
             Eq I J → l ++ᵖ (innW I ++ᵖ r) ~L l ++ᵖ (innW J ++ᵖ r)
    sym~L  : ∀ {w w′} → w ~L w′ → w′ ~L w
    trans~L : ∀ {w w′ w″} → w ~L w′ → w′ ~L w″ → w ~L w″

  private
    seeds-++ : ∀ {a b c} (p : Word a b) (q : Word b c) →
               seeds (p ++ᵖ q) ≡ seeds p ++ seeds q
    seeds-++ []               q = refl
    seeds-++ (inn e ∷ p)      q = seeds-++ p q
    seeds-++ (jn α I R ∷ p)   q = cong (seed α ∷_) (seeds-++ p q)

  seeds-~L : ∀ {a b} {w w′ : Word a b} → w ~L w′ → seeds w ≡ seeds w′
  seeds-~L (base p)      = seeds-~ p
  seeds-~L (eq l {I} {J} r _) =
    trans (seeds-++ l (innW I ++ᵖ r))
      (trans (cong (seeds l ++_) (trans (seeds-innW I r) (sym (seeds-innW J r))))
             (sym (seeds-++ l (innW J ++ᵖ r))))
  seeds-~L (sym~L p)     = sym (seeds-~L p)
  seeds-~L (trans~L p q) = trans (seeds-~L p) (seeds-~L q)

------------------------------------------------------------------------
-- Part C (definitional, not a proof): at the level whose vertices are
-- 3-cells, a law setting should not depend on its switches, because the
-- 3-equations ≈3 of T carry no switch and every switched law relates
-- 4-terms. That is argued on paper only. Here J3 is *defined* to be
-- constant, so switch3 = idS holds by definition; nothing derives S3
-- from ≈3.

module PartC (S3 : SC.Setting) where
  J3 : Switches → SC.Setting
  J3 _ = S3

  switch3 : ∀ s s′ → SC.Switch (J3 s) (J3 s′)
  switch3 s s′ = SC.idS
