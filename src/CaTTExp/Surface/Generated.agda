------------------------------------------------------------------------
-- The surface equality generated by a relation on typed terms.
--
-- Given any relation `Base Γ t u` (in the intended instances: t and u
-- are well typed over Γ and have the same image in the strict model
-- F(Γ)), this module builds the smallest relation that
--   * contains Base,
--   * is an equivalence,
--   * is a congruence for coh (head type compared over the head's own
--     context, arguments over Γ),
--   * is stable under kernel substitution,
-- and relates types structurally (⋆ to ⋆, arr to arr componentwise).
-- The result is a SurfaceEq (hypothesis (E) of
-- CaTTExp.Surface.Conservativity), and it satisfies Theorem B's
-- arr-inversion and dimension hypotheses by construction (`inv-arr`,
-- `dim-≈`).
--
-- Why a generated relation rather than "equal images" outright: the
-- SurfaceEq fields are unconditional (congruence for arbitrary raw σ,
-- reflexivity on raw terms), and the image of a raw, ill-typed term is
-- junk. Generating the relation from typed pairs keeps every field
-- provable without a junk convention. On typed terms the generated
-- relation is contained in image equality exactly when image equality
-- is itself a congruence stable under substitution, which is Lemma 1.3
-- of notes/surface-conservativity.md (argued, not formalized here).
------------------------------------------------------------------------
open import CaTTExp.Prelude
open import CaTTExp.Signature
import CaTTExp.Subst as SubstM

module CaTTExp.Surface.Generated
  (𝕊 : Signature)
  (side : Signature.Ctx 𝕊 → Signature.Ty 𝕊 → Signature.Tm 𝕊 → Signature.Tm 𝕊 → Bool)
  (closed : SubstM.Closed 𝕊 side)
  (Base : Signature.Ctx 𝕊 → Signature.Tm 𝕊 → Signature.Tm 𝕊 → Set)
  where

open Signature 𝕊
open import CaTTExp.TypingWith 𝕊 side
open import CaTTExp.Surface.Conservativity 𝕊 side closed using (SurfaceEq; Pw; pw⟨⟩; pw,)

infix 4 _∣_≈g_ _∣_≈G_

mutual
  data _∣_≈g_ : Ctx → Tm → Tm → Set where
    g-base  : ∀ {Γ t u} → Base Γ t u → Γ ∣ t ≈g u
    g-refl  : ∀ {Γ t} → Γ ∣ t ≈g t
    g-sym   : ∀ {Γ t u} → Γ ∣ t ≈g u → Γ ∣ u ≈g t
    g-trans : ∀ {Γ t u v} → Γ ∣ t ≈g u → Γ ∣ u ≈g v → Γ ∣ t ≈g v
    g-coh   : ∀ {Γ Δ A A′ σ σ′} → Δ ∣ A ≈G A′ → Pw (Γ ∣_≈g_) σ σ′ →
              Γ ∣ coh Δ A σ ≈g coh Δ A′ σ′
    g-sub   : ∀ {Γ Δ σ t u} → Γ ⊢sub σ ∶ Δ → Δ ∣ t ≈g u →
              Γ ∣ t [ σ ]tm ≈g u [ σ ]tm

  data _∣_≈G_ : Ctx → Ty → Ty → Set where
    G⋆   : ∀ {Γ} → Γ ∣ ⋆ ≈G ⋆
    Garr : ∀ {Γ A A′ t t′ u u′} → Γ ∣ A ≈G A′ → Γ ∣ t ≈g t′ → Γ ∣ u ≈g u′ →
           Γ ∣ arr A t u ≈G arr A′ t′ u′

G-refl : ∀ {Γ A} → Γ ∣ A ≈G A
G-refl {A = ⋆}         = G⋆
G-refl {A = arr A t u} = Garr G-refl g-refl g-refl

G-sym : ∀ {Γ A B} → Γ ∣ A ≈G B → Γ ∣ B ≈G A
G-sym G⋆             = G⋆
G-sym (Garr e p q)   = Garr (G-sym e) (g-sym p) (g-sym q)

G-trans : ∀ {Γ A B C} → Γ ∣ A ≈G B → Γ ∣ B ≈G C → Γ ∣ A ≈G C
G-trans G⋆           G⋆              = G⋆
G-trans (Garr e p q) (Garr e′ p′ q′) = Garr (G-trans e e′) (g-trans p p′) (g-trans q q′)

G-sub : ∀ {Γ Δ σ A A′} → Γ ⊢sub σ ∶ Δ → Δ ∣ A ≈G A′ → Γ ∣ A [ σ ]ty ≈G A′ [ σ ]ty
G-sub wσ G⋆           = G⋆
G-sub wσ (Garr e p q) = Garr (G-sub wσ e) (g-sub wσ p) (g-sub wσ q)

E : SurfaceEq
E = record
  { _∣_≈t_ = _∣_≈g_ ; _∣_≈T_ = _∣_≈G_
  ; t-refl = g-refl ; t-sym = g-sym ; t-trans = g-trans
  ; T-refl = G-refl ; T-sym = G-sym ; T-trans = G-trans
  ; arr-cong = Garr
  ; coh-cong = g-coh
  ; stable-T = G-sub
  }

-- Theorem B's hypotheses (Inv) and (Dim).
inv-arr : ∀ {Γ A A′ a a′ b b′} → Γ ∣ arr A a b ≈G arr A′ a′ b′ →
          (Γ ∣ A ≈G A′) × (Γ ∣ a ≈g a′) × (Γ ∣ b ≈g b′)
inv-arr (Garr e p q) = e , p , q

dim-≈ : ∀ {Γ A A′} → Γ ∣ A ≈G A′ → dim A ≡ dim A′
dim-≈ G⋆           = refl
dim-≈ (Garr e _ _) = cong suc (dim-≈ e)
