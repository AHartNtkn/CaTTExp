------------------------------------------------------------------------
-- Theorem B for plain CaTT with image equality in ν(λΓ), complete.
--
-- The strict model is the one of CaTTExp.Strict.Interp: a cell is a
-- tower of chains of λΓ (basis: the variables), and the top chain of an
-- operation-case coherence is the sum of the images of the top-
-- dimensional variables of its pasting context (`cohTop`); a
-- coherence-case one has top chain 0. A cell is an identity iff its
-- top chain is 0 (`UnitP`; source = target is then part of the
-- statement).
--
-- This module discharges the hypotheses of CaTTExp.Surface.WhiskerImage
-- for that model: the four whisker heads have as top-dimensional
-- variables exactly the whiskered cell, plus the whiskering cell when
-- the whisker is a composite along a codimension-1 boundary (j = 0)
-- (`Wb-BK0`, `Wb-BK`, `Wb-LK`). Strict unitality then is 0 + c = c.
--
-- Result (`Instance`): TheoremB.Hyp and Thm instantiated with every
-- hypothesis discharged, for the surface equality generated by image
-- equality in ν(λΓ) (CaTTExp.Surface.Generated). So `kc-from-el` holds
-- for plain CaTT with this ≈ with no open module parameter: relative
-- coherence (ELAt) at Γ implies kernel conversion (KC) at Γ.
-- `conservative-from-el` still takes the side-condition hypothesis
-- (SC, `SideResp`) as an argument; SC for this ≈ is not proved here
-- (it is part of Lemma 1.3 of the note).
------------------------------------------------------------------------
module CaTTExp.Surface.ImageCatt where

open import CaTTExp.Prelude
open import CaTTExp.Pure using (∅; cattSide)
open import CaTTExp.Signature
open Signature ∅
open import CaTTExp.GrayCtx.Natural using (dbl; aL)
open import CaTTExp.GrayCtx.NaturalWF using (dim-aL; <-suc; n<sn; ≤-<-trans; max-l; max-r)
import CaTTExp.Derived as D
open D using (nB; zK; BK; wK; LK; LPK; lK; ρsK; ρtK; λsK; λtK; tL; bLK; hTy; Sph; Dsk)
open import CaTTExp.DerivedBoundary using (dim[])
open import CaTTExp.Strict.Bag using (Bag; Tuple; _≈_; at; count; ≈-refl; ≈-sym; ≈-trans; ≡→≈; ++-cong; ++-[]L; cm; cm-ext'; cm-cong; cm-fuse)
import CaTTExp.Subst as SubstM
open import CaTTExp.Strict.Cell using (Tower; base; step; top; _≈w_; ≈w-top)
open import CaTTExp.Surface.TowerDim using (tdim)
open import CaTTExp.Strict.PsFacts ∅ using (Wb; sel; dimv; dimM; tup; sel-hit; sel-miss; dimv-wk)
open import CaTTExp.Strict.Interp ∅ (λ ()) using (Env; _,ₑ_; lenₑ; lookupₑ; Fv; cohTop)

------------------------------------------------------------------------
-- The model.

cohTP : Ctx → Ty → Tm → Tm → Env → Bag
cohTP Δ A _ _ ρ = cohTop Δ A ρ

UnitP : Tower → Set
UnitP (base _)     = ⊥
UnitP (step S U c) = (S ≈w U) × (c ≈ [])

unit-parP : ∀ S U c → UnitP (step S U c) → S ≈w U
unit-parP S U c u = fst u

unit-top : ∀ X → UnitP X → top X ≈ []
unit-top (base _)     ()
unit-top (step S U c) u = snd u

------------------------------------------------------------------------
-- Arithmetic.

private
  ==-refl : ∀ n → (n ==ℕ n) ≡ true
  ==-refl zero    = refl
  ==-refl (suc n) = ==-refl n

  <→≢ : ∀ i n → T (i <ℕ n) → (i ==ℕ n) ≡ false
  <→≢ zero    (suc n) _ = refl
  <→≢ (suc i) (suc n) p = <→≢ i n p

  <suc-≢ : ∀ a b → T (a <ℕ suc b) → (a ==ℕ b) ≡ false → T (a <ℕ b)
  <suc-≢ zero    zero    _ ()
  <suc-≢ zero    (suc b) _ _ = tt
  <suc-≢ (suc a) zero    p _ = ⊥-elim (z a p)
    where
    z : ∀ a → T (suc a <ℕ 1) → ⊥
    z zero    ()
    z (suc a) ()
  <suc-≢ (suc a) (suc b) p q = <suc-≢ a b p q

  no<0 : ∀ v → T (v <ℕ 0) → ⊥
  no<0 zero    ()
  no<0 (suc v) ()

  len-last : ∀ Γ A → dimv (Γ ▸ A) (len Γ) ≡ dim A
  len-last Γ A rewrite ==-refl (len Γ) = refl

infixr 1 _∙_
_∙_ : ∀ {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
_∙_ = trans

------------------------------------------------------------------------
-- Dimensions of variables.

-- Every variable of Γ has dimension at most dimCtx Γ.
dimv-le : ∀ Γ v → T (v <ℕ len Γ) → T (dimv Γ v <ℕ suc (dimCtx Γ))
dimv-le ε       v p = ⊥-elim (no<0 v p)
dimv-le (Γ ▸ A) v p with v ==ℕ len Γ in e
... | true  = max-l (dim A) (dimCtx Γ)
... | false = ≤-<-trans (dimM (lookup Γ v)) (dimCtx Γ) (suc (max (dim A) (dimCtx Γ)))
                (dimv-le Γ v (<suc-≢ v (len Γ) p e)) (max-r (dim A) (dimCtx Γ))

-- The variables of a sphere Sph m have dimension < m.
sph-dv : ∀ m v → T (v <ℕ len (Sph m)) → T (dimv (Sph m) v <ℕ m)
sph-dv zero    v p = ⊥-elim (no<0 v p)
sph-dv (suc k) v p with v ==ℕ len (Sph k ▸ aL k) in e₁
... | true  rewrite dim-aL k = n<sn k
... | false with v ==ℕ len (Sph k) in e₂
...   | true  rewrite dim-aL k = n<sn k
...   | false = <-suc (dimM (lookup (Sph k) v)) k
                  (sph-dv k v (<suc-≢ v (len (Sph k)) (<suc-≢ v (suc (len (Sph k))) p e₁) e₂))

-- No variable below m has dimension n.
selDown : ∀ Γ n m → (∀ v → T (v <ℕ m) → T (dimv Γ v <ℕ n)) → sel Γ n (downFrom m) ≡ []
selDown Γ n zero    h = refl
selDown Γ n (suc m) h =
  trans (sel-miss Γ n m (downFrom m) (<→≢ (dimv Γ m) n (h m (n<sn m))))
        (selDown Γ n m (λ v p → h v (<-suc v m p)))

------------------------------------------------------------------------
-- The top-dimensional variables of the whisker heads.

private
  -- k < suc (j + k), as a disequality
  k≢n : ∀ j k → (k ==ℕ suc (j + k)) ≡ false
  k≢n j k = <→≢ k (suc (j + k)) (D.k<n j k)

  sk≢n : ∀ j k → (suc k ==ℕ suc (suc (j + k))) ≡ false
  sk≢n j k = k≢n j k

  -- the sphere part of BK k j is below its dimension
  BK-low : ∀ k j v → T (v <ℕ len (Sph (nB k j))) → T (dimv (BK k j) v <ℕ nB k j)
  BK-low k j v p =
    subst (λ d → T (d <ℕ nB k j))
      (sym (trans (dimv-wk (Dsk n ▸ aL k) (hTy k j) v (<-suc v (suc (len (Sph n))) (<-suc v (len (Sph n)) p)))
           (trans (dimv-wk (Dsk n) (aL k) v (<-suc v (len (Sph n)) p))
                  (dimv-wk (Sph n) (aL n) v p))))
      (sph-dv n v p)
    where n = nB k j

  dv-c : ∀ k j → dimv (BK k j) (len (Sph (nB k j))) ≡ nB k j
  dv-c k j =
    trans (dimv-wk (Dsk n ▸ aL k) (hTy k j) (len (Sph n)) (<-suc (len (Sph n)) (suc (len (Sph n))) (n<sn (len (Sph n)))))
   (trans (dimv-wk (Dsk n) (aL k) (len (Sph n)) (n<sn (len (Sph n))))
   (trans (len-last (Sph n) (aL n)) (dim-aL n)))
    where n = nB k j

  dv-z : ∀ k j → dimv (BK k j) (len (Dsk (nB k j))) ≡ k
  dv-z k j = trans (dimv-wk (Dsk (nB k j) ▸ aL k) (hTy k j) (len (Dsk (nB k j))) (n<sn (len (Dsk (nB k j)))))
                   (trans (len-last (Dsk (nB k j)) (aL k)) (dim-aL k))

  dv-h : ∀ k j → dimv (BK k j) (len (Dsk (nB k j) ▸ aL k)) ≡ suc k
  dv-h k j = trans (len-last (Dsk (nB k j) ▸ aL k) (hTy k j)) (cong suc (dim-aL k))

  tup-c : ∀ k j → tup (len (Sph (nB k j))) ≡ tup (dbl (nB k j))
  tup-c k j = cong tup (D.len-Sph (nB k j))

  tup-h : ∀ k j → tup (len (Dsk (nB k j) ▸ aL k)) ≡ tup (suc (zK k j))
  tup-h k j = cong (λ m → tup (suc (suc m))) (D.len-Sph (nB k j))

Wb-BK0 : ∀ k → Wb (BK k 0) (suc k) ≡ tup (suc (zK k 0)) ∷ tup (dbl (suc k)) ∷ []
Wb-BK0 k =
  sel-hit Γ (suc k) a (b ∷ c ∷ rest) (dv-h k 0)
  ∙ cong (tup a ∷_)
      (sel-miss Γ (suc k) b (c ∷ rest) (trans (cong (_==ℕ suc k) (dv-z k 0)) (k≢n 0 k))
       ∙ sel-hit Γ (suc k) c rest (dv-c k 0)
       ∙ cong (tup c ∷_) (selDown Γ (suc k) (len (Sph n)) (BK-low k 0)))
  ∙ cong₂ (λ x y → x ∷ y ∷ []) (tup-h k 0) (tup-c k 0)
  where
  n = nB k 0
  Γ = BK k 0
  a = len (Dsk n ▸ aL k)
  b = len (Dsk n)
  c = len (Sph n)
  rest = downFrom (len (Sph n))

Wb-BK : ∀ k j → Wb (BK k (suc j)) (nB k (suc j)) ≡ tup (dbl (nB k (suc j))) ∷ []
Wb-BK k j =
  sel-miss Γ n a (b ∷ c ∷ rest) (trans (cong (_==ℕ n) (dv-h k (suc j))) (sk≢n j k))
  ∙ sel-miss Γ n b (c ∷ rest) (trans (cong (_==ℕ n) (dv-z k (suc j))) (k≢n (suc j) k))
  ∙ sel-hit Γ n c rest (dv-c k (suc j))
  ∙ cong₂ _∷_ (tup-c k (suc j)) (selDown Γ n (len (Sph n)) (BK-low k (suc j)))
  where
  n = nB k (suc j)
  Γ = BK k (suc j)
  a = len (Dsk n ▸ aL k)
  b = len (Dsk n)
  c = len (Sph n)
  rest = downFrom (len (Sph n))

Wb-LK : ∀ k j → Wb (LK k (suc j)) (nB k (suc j)) ≡ tup (tL k (suc j)) ∷ []
Wb-LK k j =
  sel-hit Γ n a (b ∷ rest) (len-last (LK k j ▸ bLK k (suc j)) (bLK k (suc (suc j)))
                            ∙ D.dim-bLK k (suc (suc j)))
  ∙ cong₂ _∷_ (cong (λ m → tup (suc m)) (D.len-LK k j))
      (sel-miss Γ n b rest
         (trans (cong (_==ℕ n) (dimv-wk (LK k j ▸ bLK k (suc j)) (bLK k (suc (suc j))) b (n<sn b)
                                ∙ len-last (LK k j) (bLK k (suc j)) ∙ D.dim-bLK k (suc j)))
                (<→≢ (nB k j) n (n<sn (nB k j))))
       ∙ selDown Γ n (len (LK k j)) low)
  where
  Γ = LK k (suc j)
  n = nB k (suc j)
  a = len (LK k j ▸ bLK k (suc j))
  b = len (LK k j)
  rest = downFrom (len (LK k j))
  low : ∀ v → T (v <ℕ len (LK k j)) → T (dimv Γ v <ℕ n)
  low v p =
    subst (λ d → T (d <ℕ n))
      (sym (dimv-wk (LK k j ▸ bLK k (suc j)) (bLK k (suc (suc j))) v (<-suc v b p)
            ∙ dimv-wk (LK k j) (bLK k (suc j)) v p))
      (≤-<-trans (dimv (LK k j) v) (nB k j) n
         (subst (λ m → T (dimv (LK k j) v <ℕ suc m)) (D.dimCtx-LK k j) (dimv-le (LK k j) v p))
         (n<sn (nB k j)))

------------------------------------------------------------------------
-- Dimensions of the head types.

dim-wK : ∀ k j → dim (wK k j) ≡ nB k j
dim-wK k zero    = cong suc (dim-aL k)
dim-wK k (suc j) = cong suc (trans (dim[] (wK k j) (ρsK k j)) (dim-wK k j))

dim-lK : ∀ k j → dim (lK k j) ≡ nB k j
dim-lK k zero    = dim-wK k zero
dim-lK k (suc j) = cong suc (trans (dim[] (lK k j) (λsK k j)) (dim-lK k j))

------------------------------------------------------------------------
-- Strict unitality on the heads.

private
  -- the operation case fires
  op-fire : ∀ Δ A ρ n → suc (dim A) ≡ n → dimCtx Δ ≡ n →
            cohTop Δ A ρ ≡ cm (Fv ρ) (Wb Δ n)
  op-fire Δ A ρ n e₁ e₂ rewrite e₁ | e₂ | ==-refl n = refl

  -- c + 0 = c and 0 + c = c
  plus0 : ∀ X Y → Y ≈ [] → X ++ (Y ++ []) ≈ X
  plus0 X Y p = ≈-trans (++-cong (≈-refl {X}) (≡→≈ (++-[]L Y))) (≈-trans (++-cong (≈-refl {X}) p) (≡→≈ (++-[]L X)))

  zplus : ∀ X Y → X ≈ [] → X ++ (Y ++ []) ≈ Y
  zplus X Y p = ≈-trans (++-cong p (≈-refl {Y ++ []})) (≡→≈ (++-[]L Y))

HR0P : ∀ k ρ → tdim (lookupₑ ρ (suc (zK k 0))) ≡ suc k → UnitP (lookupₑ ρ (suc (zK k 0))) →
       cohTP (BK k 0) (aL k) (var (dbl k)) (var (zK k 0)) ρ ≈ top (lookupₑ ρ (dbl (nB k 0)))
HR0P k ρ _ u =
  subst (_≈ top (lookupₑ ρ (dbl (suc k))))
        (sym (trans (op-fire (BK k 0) (aL k) ρ (suc k) (cong suc (dim-aL k)) (D.dimCtx-BK k 0))
                    (cong (cm (Fv ρ)) (Wb-BK0 k))))
        (zplus _ _ (unit-top _ u))

HRP : ∀ k j ρ → tdim (lookupₑ ρ (suc (zK k (suc j)))) ≡ suc k → UnitP (lookupₑ ρ (suc (zK k (suc j)))) →
      cohTP (BK k (suc j)) (wK k j [ ρsK k j ]ty)
            (coh (BK k j) (wK k j) (ρsK k j)) (coh (BK k j) (wK k j) (ρtK k j)) ρ
        ≈ top (lookupₑ ρ (dbl (nB k (suc j))))
HRP k j ρ _ u =
  subst (_≈ top (lookupₑ ρ (dbl (nB k (suc j)))))
        (sym (trans (op-fire (BK k (suc j)) (wK k j [ ρsK k j ]ty) ρ (nB k (suc j))
                       (cong suc (trans (dim[] (wK k j) (ρsK k j)) (dim-wK k j))) (D.dimCtx-BK k (suc j)))
                    (cong (cm (Fv ρ)) (Wb-BK k j))))
        (≡→≈ (++-[]L _))

HL0P : ∀ k ρ → tdim (lookupₑ ρ (dbl (suc k))) ≡ suc k → UnitP (lookupₑ ρ (dbl (suc k))) →
       cohTP (LK k 0) (aL k) (var (dbl k)) (var (zK k 0)) ρ ≈ top (lookupₑ ρ (tL k 0))
HL0P k ρ _ u =
  subst (_≈ top (lookupₑ ρ (tL k 0)))
        (sym (trans (op-fire (BK k 0) (aL k) ρ (suc k) (cong suc (dim-aL k)) (D.dimCtx-BK k 0))
                    (cong (cm (Fv ρ)) (Wb-BK0 k))))
        (plus0 _ _ (unit-top _ u))

HLP : ∀ k j ρ → tdim (lookupₑ ρ (dbl (suc k))) ≡ suc k → UnitP (lookupₑ ρ (dbl (suc k))) →
      cohTP (LK k (suc j)) (lK k j [ λsK k j ]ty)
            (coh (LK k j) (lK k j) (λsK k j)) (coh (LK k j) (lK k j) (λtK k j)) ρ
        ≈ top (lookupₑ ρ (tL k (suc j)))
HLP k j ρ _ u =
  subst (_≈ top (lookupₑ ρ (tL k (suc j))))
        (sym (trans (op-fire (LK k (suc j)) (lK k j [ λsK k j ]ty) ρ (nB k (suc j))
                       (cong suc (trans (dim[] (lK k j) (λsK k j)) (dim-lK k j))) (D.dimCtx-LK k (suc j)))
                    (cong (cm (Fv ρ)) (Wb-LK k j))))
        (≡→≈ (++-[]L _))

------------------------------------------------------------------------
-- The instance.

open import CaTTExp.Surface.WhiskerImage cattSide D.closed
  (λ k → D.sideK k 0) (λ k j → D.sideK k (suc j)) (λ k j → D.sideLK k (suc j))
  cohTP UnitP unit-parP HR0P HRP HL0P HLP public

------------------------------------------------------------------------
-- Soundness of the generated relation for top chains, and
-- non-triviality.
--
-- The generated ≈ (CaTTExp.Surface.Generated) is the closure of image
-- equality on typed terms under congruence and substitution. Here we
-- show it never identifies terms with different top chains: there is a
-- semantics μ of raw terms in an arbitrary valuation f : Nat → Bag of
-- the variables (total, so substitution commutes with it with no
-- scoping side condition), and Γ ∣ t ≈g u implies μ f t ≈ μ f u for
-- every f (`sound-top`). In particular distinct variables are never
-- ≈g-equal (`var-distinct`), so the instance is not the trivial one.
-- (Full soundness, ≈g ⊆ image equality of whole towers on typed terms,
-- is Lemma 1.3 of the note and is not proved here.)

private
  Gv : (Nat → Bag) → Tuple → Bag
  Gv g (v ∷ []) = g v
  Gv g _        = []

  cohμ : Ctx → Ty → (Nat → Bag) → Bag
  cohμ Δ A g = if suc (dim A) ==ℕ dimCtx Δ then cm (Gv g) (Wb Δ (dimCtx Δ)) else []

mutual
  μ : (Nat → Bag) → Tm → Bag
  μ f (var i)             = f i
  μ f (coh Δ ⋆ τ)         = []
  μ f (coh Δ (arr A _ _) τ) = cohμ Δ A (μsub f τ)
  μ f (cst ())

  μsub : (Nat → Bag) → Sub → Nat → Bag
  μsub f ⟨⟩       v = []
  μsub f (τ ,ₛ t) v = if v ==ℕ lenₛ τ then μ f t else μsub f τ v

private
  cohμ-ext : ∀ Δ A g g′ → (∀ v → g v ≈ g′ v) → cohμ Δ A g ≈ cohμ Δ A g′
  cohμ-ext Δ A g g′ p with suc (dim A) ==ℕ dimCtx Δ
  ... | true  = cm-ext' (Gv g) (Gv g′) (Wb Δ (dimCtx Δ)) pt
    where
    pt : ∀ w → Gv g w ≈ Gv g′ w
    pt []          = ≈-refl
    pt (v ∷ [])    = p v
    pt (v ∷ _ ∷ _) = ≈-refl
  ... | false = ≈-refl

  cohμ-dim : ∀ Δ A A′ g → dim A ≡ dim A′ → cohμ Δ A g ≡ cohμ Δ A′ g
  cohμ-dim Δ A A′ g e rewrite e = refl

mutual
  μ-ext : ∀ f f′ t → (∀ i → f i ≈ f′ i) → μ f t ≈ μ f′ t
  μ-ext f f′ (var i)               p = p i
  μ-ext f f′ (coh Δ ⋆ τ)           p = ≈-refl
  μ-ext f f′ (coh Δ (arr A _ _) τ) p = cohμ-ext Δ A (μsub f τ) (μsub f′ τ) (μsub-ext f f′ τ p)
  μ-ext f f′ (cst ())              p

  μsub-ext : ∀ f f′ τ → (∀ i → f i ≈ f′ i) → ∀ v → μsub f τ v ≈ μsub f′ τ v
  μsub-ext f f′ ⟨⟩       p v = ≈-refl
  μsub-ext f f′ (τ ,ₛ t) p v with v ==ℕ lenₛ τ
  ... | true  = μ-ext f f′ t p
  ... | false = μsub-ext f f′ τ p v

-- The valuation a substitution induces.
μval : (Nat → Bag) → Sub → Nat → Bag
μval f σ i = μ f (lookupₛ σ i)

mutual
  μ-sub : ∀ f t σ → μ f (t [ σ ]tm) ≈ μ (μval f σ) t
  μ-sub f (var i)               σ = ≈-refl
  μ-sub f (coh Δ ⋆ τ)           σ = ≈-refl
  μ-sub f (coh Δ (arr A _ _) τ) σ = cohμ-ext Δ A _ _ (μsub-∘ f τ σ)
  μ-sub f (cst ())              σ

  μsub-∘ : ∀ f τ σ v → μsub f (τ ∘ σ) v ≈ μsub (μval f σ) τ v
  μsub-∘ f ⟨⟩       σ v = ≈-refl
  μsub-∘ f (τ ,ₛ t) σ v rewrite SubstM.lenₛ-∘ ∅ cattSide τ σ with v ==ℕ lenₛ τ
  ... | true  = μ-sub f t σ
  ... | false = μsub-∘ f τ σ v

------------------------------------------------------------------------
-- μ agrees with the top chains of images.

open import CaTTExp.Surface.Image cattSide D.closed cohTP using (⟦_⟧; ⟦_⟧ₛ; η; gen; lenₑ-⟦⟧ₛ; lenₑ-η)
import CaTTExp.Subst ∅ cattSide as Sb
open import CaTTExp.Surface.Conservativity ∅ cattSide D.closed using (Pw; pw⟨⟩; pw,)
open import CaTTExp.Typing ∅ using (_⊢tm_∶_)

private
  -- a valuation f agrees below n with an environment ρ, through G
  Agree : Nat → (Nat → Bag) → (Tuple → Bag) → Env → Set
  Agree n f G ρ = ∀ v → T (v <ℕ n) → f v ≈ cm G (top (lookupₑ ρ v))

mutual
  nat : ∀ n f G ρ t → Agree n f G ρ → Sb.ScTm n t → μ f t ≈ cm G (top (⟦ t ⟧ ρ))
  nat n f G ρ (var i)               h p = h i p
  nat n f G ρ (coh Δ ⋆ τ)           h p = ≈-refl
  nat n f G ρ (coh Δ (arr A s u) τ) h p with suc (dim A) ==ℕ dimCtx Δ
  ... | true  =
    ≈-trans (cm-ext' (Gv (μsub f τ)) (λ w → cm G (Fv (⟦ τ ⟧ₛ ρ) w)) W pt)
            (≡→≈ (sym (cm-fuse G (Fv (⟦ τ ⟧ₛ ρ)) W)))
    where
    W = Wb Δ (dimCtx Δ)
    pt : ∀ w → Gv (μsub f τ) w ≈ cm G (Fv (⟦ τ ⟧ₛ ρ) w)
    pt []          = ≈-refl
    pt (v ∷ [])    = natsub n f G ρ τ h p v
    pt (v ∷ _ ∷ _) = ≈-refl
  ... | false = ≈-refl
  nat n f G ρ (cst ()) h p

  natsub : ∀ n f G ρ τ → Agree n f G ρ → Sb.ScSub n τ → ∀ v →
           μsub f τ v ≈ cm G (top (lookupₑ (⟦ τ ⟧ₛ ρ) v))
  natsub n f G ρ ⟨⟩       h p v = ≈-refl
  natsub n f G ρ (τ ,ₛ t) h (p , q) v with v ==ℕ lenₛ τ in e
  ... | true  = subst (λ Y → μ f t ≈ cm G (top Y))
                  (sym (lk-snoc (⟦ τ ⟧ₛ ρ) (⟦ t ⟧ ρ) v (trans (cong (v ==ℕ_) (lenₑ-⟦⟧ₛ τ ρ)) e)))
                  (nat n f G ρ t h q)
  ... | false = subst (λ Y → μsub f τ v ≈ cm G (top Y))
                  (sym (lk-snoc (⟦ τ ⟧ₛ ρ) (⟦ t ⟧ ρ) v (trans (cong (v ==ℕ_) (lenₑ-⟦⟧ₛ τ ρ)) e)))
                  (natsub n f G ρ τ h p v)

  lk-snoc : ∀ E X v {b} → (v ==ℕ lenₑ E) ≡ b → lookupₑ (E ,ₑ X) v ≡ (if b then X else lookupₑ E v)
  lk-snoc E X v e rewrite e = refl

private
  top-gen : ∀ v A ρ → top (gen v A ρ) ≡ tup v ∷ []
  top-gen v ⋆           ρ = refl
  top-gen v (arr A s u) ρ = refl

  ==→≡′ : ∀ a b → (a ==ℕ b) ≡ true → a ≡ b
  ==→≡′ a b e = ==ℕ-sound a b (subst T (sym e) tt)

  top-η : ∀ Γ v → T (v <ℕ len Γ) → top (lookupₑ (η Γ) v) ≡ tup v ∷ []
  top-η ε       v p = ⊥-elim (no<0 v p)
  top-η (Γ ▸ A) v p with v ==ℕ len Γ in e
  ... | true  = trans (cong top (lk-snoc (η Γ) (gen (len Γ) A (η Γ)) v (trans (cong (v ==ℕ_) (lenₑ-η Γ)) e)))
                      (trans (top-gen (len Γ) A (η Γ)) (cong (λ m → tup m ∷ []) (sym (==→≡′ v (len Γ) e))))
  ... | false = trans (cong top (lk-snoc (η Γ) (gen (len Γ) A (η Γ)) v (trans (cong (v ==ℕ_) (lenₑ-η Γ)) e)))
                      (top-η Γ v (<suc-≢ v (len Γ) p e))

  agree-η : ∀ Γ f → Agree (len Γ) f (Gv f) (η Γ)
  agree-η Γ f v p rewrite top-η Γ v p = ≡→≈ (sym (++-[]L (f v)))

-- On typed terms, μ f is the top chain of the image pushed along f.
μ-img : ∀ {Γ t A} → Γ ⊢tm t ∶ A → ∀ f → μ f t ≈ cm (Gv f) (top (⟦ t ⟧ (η Γ)))
μ-img {Γ} {t} dt f = nat (len Γ) f (Gv f) (η Γ) t (agree-η Γ f) (Sb.tm-sc D.closed dt)

------------------------------------------------------------------------
-- Soundness.

private
  pw-len : ∀ {Γ σ σ′} → Pw (Γ ∣_≈g_) σ σ′ → lenₛ σ ≡ lenₛ σ′
  pw-len pw⟨⟩      = refl
  pw-len (pw, p _) = cong suc (pw-len p)

mutual
  sound-top : ∀ {Γ t u} → Γ ∣ t ≈g u → ∀ f → μ f t ≈ μ f u
  sound-top (g-base (_ , _ , dt , du , img)) f =
    ≈-trans (μ-img dt f)
   (≈-trans (cm-cong (Gv f) _ _ (≈w-top _ _ img)) (≈-sym (μ-img du f)))
  sound-top g-refl          f = ≈-refl
  sound-top (g-sym p)       f = ≈-sym (sound-top p f)
  sound-top (g-trans p q)   f = ≈-trans (sound-top p f) (sound-top q f)
  sound-top (g-coh G⋆ pw)   f = ≈-refl
  sound-top (g-coh {Δ = Δ} {σ = σ} {σ′} (Garr {A = A} {A′} e _ _) pw) f =
    ≈-trans (cohμ-ext Δ A (μsub f σ) (μsub f σ′) (sound-pw pw f))
            (≡→≈ (cohμ-dim Δ A A′ (μsub f σ′) (dim-≈ e)))
  sound-top (g-sub {σ = σ} {t} {u} _ p) f =
    ≈-trans (μ-sub f t σ) (≈-trans (sound-top p (μval f σ)) (≈-sym (μ-sub f u σ)))

  sound-pw : ∀ {Γ σ σ′} → Pw (Γ ∣_≈g_) σ σ′ → ∀ f v → μsub f σ v ≈ μsub f σ′ v
  sound-pw pw⟨⟩ f v = ≈-refl
  sound-pw (pw, {σ} {σ′} p q) f v rewrite pw-len p with v ==ℕ lenₛ σ′
  ... | true  = sound-top q f
  ... | false = sound-pw p f v

-- Distinct variables are never ≈g-equal: the instance is not trivial.
var-distinct : ∀ {Γ} i j → (i ==ℕ j) ≡ false → ¬ (Γ ∣ var i ≈g var j)
var-distinct i j ne p with at (sound-top p (λ v → (v ∷ []) ∷ [])) (i ∷ [])
... | e rewrite ==-refl i | ne = z (sym e)
  where
  z : zero ≡ suc zero → ⊥
  z ()
