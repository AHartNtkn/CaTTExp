------------------------------------------------------------------------
-- Support restriction for relative coherence (ledger S20 (i), stage 2;
-- notes/rc-generator.md §1).
--
-- A query  Γ ⊢ t, u : A  is answered in the sub-context generated by
-- its support, and the answer is pulled back along the inclusion. For
-- any keep-predicate on levels that is closed under dependencies
-- (DownClosed) we build
--
--   * the restricted context Γ′ (the kept entries, renumbered),
--   * the renaming ρ (a substitution taking Γ-syntax to Γ′-syntax), and
--   * the inclusion ι with  Γ ⊢sub ι ∶ Γ′,
--
-- and prove: a term typed in Γ whose variables are kept is typed in Γ′
-- after renaming (the partial substitution lemma `ptm[]`), and
-- renaming then including is the identity on kept syntax (`idOn-*`).
-- So any procedure on Γ′ gives answers on Γ, typed by proof
-- (`viaSupport`). The support of a query is the dependency closure
-- `close` of the free variables of A, t and u, proved down-closed and
-- to contain them.
--
-- Everything here is for an arbitrary signature and side condition, so
-- it applies to plain CaTT and to the Gray-style instances alike.
------------------------------------------------------------------------
open import CaTTExp.Prelude
open import CaTTExp.Signature

module CaTTExp.RCProc.Support
  (𝕊 : Signature)
  (side : Signature.Ctx 𝕊 → Signature.Ty 𝕊 → Signature.Tm 𝕊 → Signature.Tm 𝕊 → Bool)
  where

open Signature 𝕊
open import CaTTExp.TypingWith 𝕊 side
import CaTTExp.Subst 𝕊 side as Sb
open import CaTTExp.Weakening 𝕊 side using (wk-tm; wk-sub; lookup-top; lookup-wk)

------------------------------------------------------------------------
-- Small logic.

data _⊎_ (A B : Set) : Set where
  inl : A → A ⊎ B
  inr : B → A ⊎ B

private
  ≡→T : ∀ {b} → b ≡ true → T b
  ≡→T refl = tt

  T→≡ : ∀ {b} → T b → b ≡ true
  T→≡ {true} _ = refl

  just-inj : ∀ {A : Set} {x y : A} → just x ≡ just y → x ≡ y
  just-inj refl = refl

  ∨-l : ∀ {a b} → T a → T (a ∨ b)
  ∨-l {true} _ = tt

  ∨-r : ∀ {a b} → T b → T (a ∨ b)
  ∨-r {true}  _ = tt
  ∨-r {false} p = p

  ∨-e : ∀ a b → T (a ∨ b) → T a ⊎ T b
  ∨-e true  b _ = inl tt
  ∨-e false b p = inr p

  <-irr : ∀ n → ¬ T (n <ℕ n)
  <-irr zero    ()
  <-irr (suc n) p = <-irr n p

  <-suc : ∀ i n → T (i <ℕ n) → T (i <ℕ suc n)
  <-suc zero    (suc n) _ = tt
  <-suc (suc i) (suc n) p = <-suc i n p

  <-pred : ∀ i n → T (i <ℕ suc n) → (i ==ℕ n) ≡ false → T (i <ℕ n)
  <-pred zero    zero    _ ()
  <-pred zero    (suc n) _ _ = tt
  <-pred (suc i) zero    () _
  <-pred (suc i) (suc n) p q = <-pred i n p q

  <→≢ : ∀ i n → T (i <ℕ n) → (i ==ℕ n) ≡ false
  <→≢ zero    (suc n) _ = refl
  <→≢ (suc i) (suc n) p = <→≢ i n p

  ==-refl : ∀ n → (n ==ℕ n) ≡ true
  ==-refl zero    = refl
  ==-refl (suc n) = ==-refl n

  ==→≡ : ∀ {i n} → (i ==ℕ n) ≡ true → i ≡ n
  ==→≡ {i} {n} p = ==ℕ-sound i n (≡→T p)

------------------------------------------------------------------------
-- Lists as finite sets.

Every : (Nat → Set) → List Nat → Set
Every P []       = ⊤
Every P (x ∷ xs) = P x × Every P xs

every-++ : ∀ {P} xs ys → Every P (xs ++ ys) → Every P xs × Every P ys
every-++ []       ys e       = tt , e
every-++ (x ∷ xs) ys (p , e) = let r = every-++ xs ys e in (p , fst r) , snd r

++-every : ∀ {P} xs ys → Every P xs → Every P ys → Every P (xs ++ ys)
++-every []       ys _       e = e
++-every (x ∷ xs) ys (p , a) e = p , ++-every xs ys a e

every-map : ∀ {P Q : Nat → Set} → (∀ i → P i → Q i) → ∀ xs → Every P xs → Every Q xs
every-map f []       _       = tt
every-map f (x ∷ xs) (p , e) = f x p , every-map f xs e

every-zip : ∀ {P Q : Nat → Set} xs → Every P xs → Every Q xs → Every (λ i → P i × Q i) xs
every-zip []       _       _       = tt
every-zip (x ∷ xs) (p , a) (q , b) = (p , q) , every-zip xs a b

elem-++l : ∀ i xs ys → T (elem i xs) → T (elem i (xs ++ ys))
elem-++l i (x ∷ xs) ys p with ∨-e (i ==ℕ x) (elem i xs) p
... | inl q = ∨-l q
... | inr q = ∨-r {i ==ℕ x} (elem-++l i xs ys q)

elem-++r : ∀ i xs ys → T (elem i ys) → T (elem i (xs ++ ys))
elem-++r i []       ys p = p
elem-++r i (x ∷ xs) ys p = ∨-r {i ==ℕ x} (elem-++r i xs ys p)

elem-++ : ∀ i xs ys → T (elem i (xs ++ ys)) → T (elem i xs) ⊎ T (elem i ys)
elem-++ i []       ys p = inr p
elem-++ i (x ∷ xs) ys p with ∨-e (i ==ℕ x) (elem i (xs ++ ys)) p
... | inl q = inl (∨-l q)
... | inr q with elem-++ i xs ys q
...   | inl r = inl (∨-r {i ==ℕ x} r)
...   | inr r = inr r

elem-every : ∀ {P : Nat → Set} i xs → Every P xs → T (elem i xs) → P i
elem-every {P} i (x ∷ xs) (p , e) h with ∨-e (i ==ℕ x) (elem i xs) h
... | inl q = subst P (sym (==ℕ-sound i x q)) p
... | inr q = elem-every i xs e q

every-elem : ∀ xs → Every (λ i → T (elem i xs)) xs
every-elem []       = tt
every-elem (x ∷ xs) = ∨-l (==ℕ-refl x) , every-map (λ i p → ∨-r {i ==ℕ x} p) xs (every-elem xs)

-- Scoped syntax has its free variables below the bound.
mutual
  sc-ty-every : ∀ n A → Sb.ScTy n A → Every (λ i → T (i <ℕ n)) (fvTy A)
  sc-ty-every n ⋆           _           = tt
  sc-ty-every n (arr A t u) (a , p , q) =
    ++-every (fvTy A) _ (sc-ty-every n A a) (++-every (fvTm t) (fvTm u) (sc-tm-every n t p) (sc-tm-every n u q))

  sc-tm-every : ∀ n t → Sb.ScTm n t → Every (λ i → T (i <ℕ n)) (fvTm t)
  sc-tm-every n (var i)     p = p , tt
  sc-tm-every n (coh _ _ σ) p = sc-sub-every n σ p
  sc-tm-every n (cst _)     _ = tt

  sc-sub-every : ∀ n σ → Sb.ScSub n σ → Every (λ i → T (i <ℕ n)) (fvSub σ)
  sc-sub-every n ⟨⟩       _       = tt
  sc-sub-every n (σ ,ₛ t) (p , q) = ++-every (fvSub σ) (fvTm t) (sc-sub-every n σ p) (sc-tm-every n t q)

------------------------------------------------------------------------
-- Lookup in a snoc substitution.

lk-hit : ∀ σ s i → i ≡ lenₛ σ → lookupₛ (σ ,ₛ s) i ≡ s
lk-hit σ s i refl rewrite ==-refl (lenₛ σ) = refl

lk-miss : ∀ σ s i → (i ==ℕ lenₛ σ) ≡ false → lookupₛ (σ ,ₛ s) i ≡ lookupₛ σ i
lk-miss σ s i e rewrite e = refl

------------------------------------------------------------------------
-- Renaming followed by inclusion is the identity on syntax whose free
-- variables are fixed.

Fixes : Sub → Sub → Nat → Set
Fixes ρ ι i = lookupₛ ρ i [ ι ]tm ≡ var i

mutual
  idOn-tm : ∀ ρ ι t → Every (Fixes ρ ι) (fvTm t) → t [ ρ ]tm [ ι ]tm ≡ t
  idOn-tm ρ ι (var i)     (e , _) = e
  idOn-tm ρ ι (coh Θ B τ) ev      = cong (coh Θ B) (idOn-sub ρ ι τ ev)
  idOn-tm ρ ι (cst k)     _       = refl

  idOn-sub : ∀ ρ ι τ → Every (Fixes ρ ι) (fvSub τ) → (τ ∘ ρ) ∘ ι ≡ τ
  idOn-sub ρ ι ⟨⟩       _  = refl
  idOn-sub ρ ι (τ ,ₛ t) ev =
    let r = every-++ (fvSub τ) (fvTm t) ev in
    cong₂ _,ₛ_ (idOn-sub ρ ι τ (fst r)) (idOn-tm ρ ι t (snd r))

idOn-ty : ∀ ρ ι A → Every (Fixes ρ ι) (fvTy A) → A [ ρ ]ty [ ι ]ty ≡ A
idOn-ty ρ ι ⋆           _  = refl
idOn-ty ρ ι (arr A t u) ev =
  let r = every-++ (fvTy A) _ ev
      s = every-++ (fvTm t) (fvTm u) (snd r) in
  cong₂ (λ X (Y : Tm × Tm) → arr X (fst Y) (snd Y))
    (idOn-ty ρ ι A (fst r)) (cong₂ _,_ (idOn-tm ρ ι t (fst s)) (idOn-tm ρ ι u (snd s)))

------------------------------------------------------------------------
-- Keep-predicates closed under dependencies, and the support closure.

Keep : (Nat → Bool) → Nat → Set
Keep keep i = T (keep i)

DownClosed : (Nat → Bool) → Ctx → Set
DownClosed keep Γ = ∀ i A → T (keep i) → lookup Γ i ≡ just A → Every (Keep keep) (fvTy A)

-- The dependency closure of a set of levels: walking down Γ, a kept
-- entry adds the variables of its type.
close : Ctx → List Nat → List Nat
close ε       S = S
close (Γ ▸ A) S = close Γ (if elem (len Γ) S then fvTy A ++ S else S)

close-mono : ∀ Γ S i → T (elem i S) → T (elem i (close Γ S))
close-mono ε       S i p = p
close-mono (Γ ▸ A) S i p with elem (len Γ) S
... | true  = close-mono Γ (fvTy A ++ S) i (elem-++r i (fvTy A) S p)
... | false = close-mono Γ S i p

------------------------------------------------------------------------
-- Partial substitutions: typed on the kept variables only.

record PSub (keep : Nat → Bool) (Δ : Ctx) (σ : Sub) (Γ : Ctx) : Set where
  field
    pctx : Δ ⊢ctx
    plen : lenₛ σ ≡ len Γ
    pvar : ∀ i A → T (keep i) → lookup Γ i ≡ just A → Δ ⊢tm lookupₛ σ i ∶ A [ σ ]ty
open PSub

-- The restricted context, the renaming and the inclusion.
record Restr : Set where
  constructor mkR
  field
    rctx : Ctx
    ren  : Sub
    inc  : Sub
open Restr

step : Bool → Restr → Ty → Nat → Restr
step true  (mkR Γ′ ρ ι) A n = mkR (Γ′ ▸ A [ ρ ]ty) (ρ ,ₛ var (len Γ′)) (ι ,ₛ var n)
step false (mkR Γ′ ρ ι) A n = mkR Γ′ (ρ ,ₛ var 0) ι

restr : (Nat → Bool) → Ctx → Restr
restr keep ε       = mkR ε ⟨⟩ ⟨⟩
restr keep (Γ ▸ A) = step (keep (len Γ)) (restr keep Γ) A (len Γ)

record RestrOK (keep : Nat → Bool) (Γ : Ctx) (R : Restr) : Set where
  field
    psub    : PSub keep (rctx R) (ren R) Γ
    inc-len : lenₛ (inc R) ≡ len (rctx R)
    inc-wf  : Γ ⊢sub inc R ∶ rctx R
    back    : ∀ i → T (keep i) → T (i <ℕ len Γ) → Fixes (ren R) (inc R) i
open RestrOK

------------------------------------------------------------------------
-- The theorems.

module _ (closed : Sb.Closed) where

  tm-ctx′ : ∀ {Γ t A} → Γ ⊢tm t ∶ A → Γ ⊢ctx
  tm-ctx′ (var-wf w _)        = w
  tm-ctx′ (coh-wf _ _ _ _ s)  = Sb.sub-ctx closed s
  tm-ctx′ (cst-wf w _)        = w

  -- The partial substitution lemma: only the variables a term uses
  -- need typed images.
  mutual
    ptm[] : ∀ {keep Γ Δ t A σ} → Γ ⊢tm t ∶ A → Every (Keep keep) (fvTm t) →
            PSub keep Δ σ Γ → Δ ⊢tm t [ σ ]tm ∶ A [ σ ]ty
    ptm[] (var-wf {i} {A} _ eq) (k , _) s = pvar s i A k eq
    ptm[] {Δ = Δ} {σ = σ} (coh-wf {Δ = Θ} {A} {t} {u} {τ} p w a ok sτ) ev s =
      subst (Δ ⊢tm coh Θ (arr A t u) (τ ∘ σ) ∶_)
        (sym (Sb.assoc-ty (arr A t u) τ σ
               (subst (λ n → Sb.ScTy n (arr A t u)) (sym (snd (Sb.sub-sc closed sτ))) (Sb.ty-sc closed a))))
        (coh-wf p w a ok (psub∘ w sτ ev s))
    ptm[] {Δ = Δ} {σ = σ} (cst-wf {k} _ v) _ s =
      subst (Δ ⊢tm cst k ∶_) (sym (Sb.closed-ty (ty k) σ (closed k))) (cst-wf (pctx s) v)

    psub∘ : ∀ {keep Θ Γ Δ τ σ} → Θ ⊢ctx → Γ ⊢sub τ ∶ Θ → Every (Keep keep) (fvSub τ) →
            PSub keep Δ σ Γ → Δ ⊢sub τ ∘ σ ∶ Θ
    psub∘ _ (⟨⟩-wf _) _ s = ⟨⟩-wf (pctx s)
    psub∘ {Θ = Θ ▸ A} {Δ = Δ} {τ = τ ,ₛ t} {σ} (▸-wf w a) (,-wf sτ d) ev s =
      let r = every-++ (fvSub τ) (fvTm t) ev in
      ,-wf (psub∘ w sτ (fst r) s)
        (subst (Δ ⊢tm t [ σ ]tm ∶_)
          (Sb.assoc-ty A τ σ (subst (λ n → Sb.ScTy n A) (sym (snd (Sb.sub-sc closed sτ))) (Sb.ty-sc closed a)))
          (ptm[] d (snd r) s))

  pty[] : ∀ {keep Γ Δ A σ} → Γ ⊢ty A → Every (Keep keep) (fvTy A) → PSub keep Δ σ Γ → Δ ⊢ty A [ σ ]ty
  pty[] (⋆-wf _) _ s = ⋆-wf (pctx s)
  pty[] {A = arr A t u} (arr-wf d e) ev s =
    let r = every-++ (fvTy A) _ ev
        q = every-++ (fvTm t) (fvTm u) (snd r) in
    arr-wf (ptm[] d (fst q) s) (ptm[] e (snd q) s)

  ----------------------------------------------------------------------
  -- The support closure is down-closed.

  close-big : ∀ {Γ} → Γ ⊢ctx → ∀ S i → ¬ T (i <ℕ len Γ) → T (elem i (close Γ S)) → T (elem i S)
  close-big ε-wf S i _ p = p
  close-big {Γ ▸ A} (▸-wf w a) S i ni p with elem (len Γ) S
  ... | true with elem-++ i (fvTy A) S (close-big w (fvTy A ++ S) i (λ q → ni (<-suc i (len Γ) q)) p)
  ...   | inl q = ⊥-elim (ni (<-suc i (len Γ) (elem-every i (fvTy A) (sc-ty-every (len Γ) A (Sb.ty-sc closed a)) q)))
  ...   | inr q = q
  close-big {Γ ▸ A} (▸-wf w a) S i ni p | false = close-big w S i (λ q → ni (<-suc i (len Γ) q)) p

  private
    dc-top : ∀ {Γ A} → Γ ⊢ctx → ∀ S → T (elem (len Γ) (close (Γ ▸ A) S)) →
             Every (λ j → T (elem j (close (Γ ▸ A) S))) (fvTy A)
    dc-top {Γ} {A} w S k with elem (len Γ) S in e
    ... | true  = every-map (λ j p → close-mono Γ (fvTy A ++ S) j (elem-++l j (fvTy A) S p)) (fvTy A) (every-elem (fvTy A))
    ... | false = ⊥-elim (subst T e (close-big w S (len Γ) (<-irr (len Γ)) k))

  dc-close : ∀ {Γ} → Γ ⊢ctx → ∀ S → DownClosed (λ i → elem i (close Γ S)) Γ
  dc-close ε-wf S i B k ()
  dc-close {Γ ▸ A} (▸-wf w a) S i B k eq with i ==ℕ len Γ in e
  ... | true  =
    subst (λ X → Every (λ j → T (elem j (close (Γ ▸ A) S))) (fvTy X)) (just-inj eq)
      (dc-top {Γ} {A} w S (subst (λ j → T (elem j (close (Γ ▸ A) S))) (==→≡ e) k))
  ... | false = dc-close w _ i B k eq

  ----------------------------------------------------------------------
  -- The restriction is well formed.

  private
    lookup-ex : ∀ {Γ} → Γ ⊢ctx → ∀ i → T (i <ℕ len Γ) → Σ Ty λ B → lookup Γ i ≡ just B
    lookup-ex {Γ ▸ A} (▸-wf w a) i p with i ==ℕ len Γ in e
    ... | true  = A , refl
    ... | false = lookup-ex w i (<-pred i (len Γ) p e)

    dc-wk : ∀ {keep Γ A} → DownClosed keep (Γ ▸ A) → DownClosed keep Γ
    dc-wk {Γ = Γ} {A} dc i B k eq = dc i B k (lookup-wk Γ i A eq)

  -- The restriction of a well-formed context along a down-closed
  -- predicate is well formed, with a typed inclusion.
  restr-ok : ∀ {keep Γ} → Γ ⊢ctx → DownClosed keep Γ → RestrOK keep Γ (restr keep Γ)
  restr-ok {keep} {ε} ε-wf dc = record
    { psub    = record { pctx = ε-wf ; plen = refl ; pvar = λ i A k () }
    ; inc-len = refl
    ; inc-wf  = ⟨⟩-wf ε-wf
    ; back    = λ i k () }
  restr-ok {keep} {Γ ▸ A} (▸-wf w a) dc with keep (len Γ) in e
  ... | true  = record
    { psub    = record { pctx = w″ ; plen = cong suc (plen P) ; pvar = pv }
    ; inc-len = cong suc (inc-len ok)
    ; inc-wf  = ,-wf (wk-sub (inc-wf ok) wΓA)
                  (subst (Γ ▸ A ⊢tm var (len Γ) ∶_) (sym (idOn-ty ρ ι A (fixes (fvTy A) kA scA)))
                    (var-wf wΓA (lookup-top Γ A)))
    ; back    = bk }
    where
    ok  = restr-ok w (dc-wk dc)
    P   = psub ok
    R   = restr keep Γ
    Γ′  = rctx R
    ρ   = ren R
    ι   = inc R
    wΓA = ▸-wf w a
    scA : Every (λ i → T (i <ℕ len Γ)) (fvTy A)
    scA = sc-ty-every (len Γ) A (Sb.ty-sc closed a)
    kA : Every (Keep keep) (fvTy A)
    kA = dc (len Γ) A (≡→T e) (lookup-top Γ A)
    fixes : ∀ xs → Every (Keep keep) xs → Every (λ i → T (i <ℕ len Γ)) xs → Every (Fixes ρ ι) xs
    fixes xs k s = every-map (λ i p → back ok i (fst p) (snd p)) xs (every-zip xs k s)
    A′ = A [ ρ ]ty
    w″ : (Γ′ ▸ A′) ⊢ctx
    w″ = ▸-wf (pctx P) (pty[] a kA P)
    v  = var (len Γ′)
    pv : ∀ i B → T (keep i) → lookup (Γ ▸ A) i ≡ just B → (Γ′ ▸ A′) ⊢tm lookupₛ (ρ ,ₛ v) i ∶ B [ ρ ,ₛ v ]ty
    pv i B k eq with i ==ℕ len Γ in e′
    ... | true  =
      subst (λ X → (Γ′ ▸ A′) ⊢tm X ∶ B [ ρ ,ₛ v ]ty) (sym (lk-hit ρ v i (trans (==→≡ e′) (sym (plen P)))))
        (subst (λ X → (Γ′ ▸ A′) ⊢tm v ∶ X)
          (sym (trans (cong (_[ ρ ,ₛ v ]ty) (sym (just-inj eq)))
                      (Sb.ext-ty A ρ v (subst (λ n → Sb.ScTy n A) (sym (plen P)) (Sb.ty-sc closed a)))))
          (var-wf w″ (lookup-top Γ′ A′)))
    ... | false =
      subst (λ X → (Γ′ ▸ A′) ⊢tm X ∶ B [ ρ ,ₛ v ]ty) (sym (lk-miss ρ v i (subst (λ n → (i ==ℕ n) ≡ false) (sym (plen P)) e′)))
        (subst (λ X → (Γ′ ▸ A′) ⊢tm lookupₛ ρ i ∶ X)
          (sym (Sb.ext-ty B ρ v (subst (λ n → Sb.ScTy n B) (sym (plen P)) (snd (Sb.ctx-lookup closed w eq)))))
          (wk-tm (pvar P i B k eq) w″))
    bk : ∀ i → T (keep i) → T (i <ℕ suc (len Γ)) → Fixes (ρ ,ₛ v) (ι ,ₛ var (len Γ)) i
    bk i k lt with i ==ℕ len Γ in e′
    ... | true  =
      trans (cong (_[ ι ,ₛ var (len Γ) ]tm) (lk-hit ρ v i (trans (==→≡ e′) (sym (plen P)))))
        (trans (lk-hit ι (var (len Γ)) (len Γ′) (sym (inc-len ok))) (cong var (sym (==→≡ e′))))
    ... | false =
      let lt′ = <-pred i (len Γ) lt e′
          B,e = lookup-ex w i lt′
          sc  = Sb.tm-sc closed (pvar P i (fst B,e) k (snd B,e)) in
      trans (cong (_[ ι ,ₛ var (len Γ) ]tm) (lk-miss ρ v i (subst (λ n → (i ==ℕ n) ≡ false) (sym (plen P)) e′)))
        (trans (Sb.ext-tm (lookupₛ ρ i) ι (var (len Γ)) (subst (λ n → Sb.ScTm n (lookupₛ ρ i)) (sym (inc-len ok)) sc))
          (back ok i k lt′))
  ... | false = record
    { psub    = record { pctx = pctx P ; plen = cong suc (plen P) ; pvar = pv }
    ; inc-len = inc-len ok
    ; inc-wf  = wk-sub (inc-wf ok) (▸-wf w a)
    ; back    = bk }
    where
    ok  = restr-ok w (dc-wk dc)
    P   = psub ok
    R   = restr keep Γ
    Γ′  = rctx R
    ρ   = ren R
    ι   = inc R
    v   = var 0
    notTop : ∀ i → T (keep i) → (i ==ℕ len Γ) ≡ true → ⊥
    notTop i k q = subst T e (subst (λ j → T (keep j)) (==→≡ q) k)
    pv : ∀ i B → T (keep i) → lookup (Γ ▸ A) i ≡ just B → Γ′ ⊢tm lookupₛ (ρ ,ₛ v) i ∶ B [ ρ ,ₛ v ]ty
    pv i B k eq with i ==ℕ len Γ in e′
    ... | true  = ⊥-elim (notTop i k e′)
    ... | false =
      subst (λ X → Γ′ ⊢tm X ∶ B [ ρ ,ₛ v ]ty) (sym (lk-miss ρ v i (subst (λ n → (i ==ℕ n) ≡ false) (sym (plen P)) e′)))
        (subst (λ X → Γ′ ⊢tm lookupₛ ρ i ∶ X)
          (sym (Sb.ext-ty B ρ v (subst (λ n → Sb.ScTy n B) (sym (plen P)) (snd (Sb.ctx-lookup closed w eq)))))
          (pvar P i B k eq))
    bk : ∀ i → T (keep i) → T (i <ℕ suc (len Γ)) → Fixes (ρ ,ₛ v) ι i
    bk i k lt with i ==ℕ len Γ in e′
    ... | true  = ⊥-elim (notTop i k e′)
    ... | false =
      trans (cong (_[ ι ]tm) (lk-miss ρ v i (subst (λ n → (i ==ℕ n) ≡ false) (sym (plen P)) e′)))
        (back ok i k (<-pred i (len Γ) lt e′))

  ----------------------------------------------------------------------
  -- Restricting a query and pulling an answer back.

  module Query {keep Γ A t u} (wΓ : Γ ⊢ctx) (dc : DownClosed keep Γ)
               (kA : Every (Keep keep) (fvTy A)) (kt : Every (Keep keep) (fvTm t)) (ku : Every (Keep keep) (fvTm u))
               (dt : Γ ⊢tm t ∶ A) (du : Γ ⊢tm u ∶ A) where
    R  = restr keep Γ
    Γ′ = rctx R
    ρ  = ren R
    ι  = inc R
    ok = restr-ok wΓ dc

    dt′ : Γ′ ⊢tm t [ ρ ]tm ∶ A [ ρ ]ty
    dt′ = ptm[] dt kt (psub ok)

    du′ : Γ′ ⊢tm u [ ρ ]tm ∶ A [ ρ ]ty
    du′ = ptm[] du ku (psub ok)

    private
      fixes : ∀ xs → Every (Keep keep) xs → Every (λ i → T (i <ℕ len Γ)) xs → Every (Fixes ρ ι) xs
      fixes xs k s = every-map (λ i p → back ok i (fst p) (snd p)) xs (every-zip xs k s)

      eqA : A [ ρ ]ty [ ι ]ty ≡ A
      eqA = idOn-ty ρ ι A (fixes (fvTy A) kA (sc-ty-every (len Γ) A (Sb.tm-ty-sc closed dt)))

      eqt : t [ ρ ]tm [ ι ]tm ≡ t
      eqt = idOn-tm ρ ι t (fixes (fvTm t) kt (sc-tm-every (len Γ) t (Sb.tm-sc closed dt)))

      equ : u [ ρ ]tm [ ι ]tm ≡ u
      equ = idOn-tm ρ ι u (fixes (fvTm u) ku (sc-tm-every (len Γ) u (Sb.tm-sc closed du)))

    -- An answer in the restricted context gives one in Γ.
    pull : ∀ {w} → Γ′ ⊢tm w ∶ arr (A [ ρ ]ty) (t [ ρ ]tm) (u [ ρ ]tm) → Γ ⊢tm w [ ι ]tm ∶ arr A t u
    pull {w} dw =
      subst (Γ ⊢tm w [ ι ]tm ∶_)
        (cong₂ (λ X (Y : Tm × Tm) → arr X (fst Y) (snd Y)) eqA (cong₂ _,_ eqt equ))
        (Sb.tm[] closed dw (inc-wf ok))

  ----------------------------------------------------------------------
  -- The support of a query.

  supp : Ty → Tm → Tm → List Nat
  supp A t u = fvTy A ++ fvTm t ++ fvTm u

  keepOf : Ctx → Ty → Tm → Tm → Nat → Bool
  keepOf Γ A t u i = elem i (close Γ (supp A t u))

  private
    inS : ∀ Γ S xs → Every (λ i → T (elem i S)) xs → Every (Keep (λ i → elem i (close Γ S))) xs
    inS Γ S xs = every-map (λ i p → close-mono Γ S i p) xs

  module Support {Γ A t u} (dt : Γ ⊢tm t ∶ A) (du : Γ ⊢tm u ∶ A) where
    private
      wΓ = tm-ctx′ dt
      S  = supp A t u
      eS = every-++ (fvTy A) (fvTm t ++ fvTm u) (every-elem S)
      eT = every-++ (fvTm t) (fvTm u) (snd eS)
    open Query {keepOf Γ A t u} {Γ} {A} {t} {u} wΓ (dc-close wΓ S)
                 (inS Γ S (fvTy A) (fst eS)) (inS Γ S (fvTm t) (fst eT)) (inS Γ S (fvTm u) (snd eT)) dt du
      public

  Ans : Ctx → Ty → Tm → Tm → Set
  Ans Γ A t u = Σ Tm λ w → Γ ⊢tm w ∶ arr A t u

  Proc : Set
  Proc = ∀ {Γ A t u} → Γ ⊢tm t ∶ A → Γ ⊢tm u ∶ A → Maybe (Ans Γ A t u)

  -- Answer a query in the context generated by its support, by any
  -- procedure, and pull the answer back.
  viaSupport : Proc → Proc
  viaSupport f dt du =
    f (Support.dt′ dt du) (Support.du′ dt du) >>= λ a →
    just (fst a [ Support.ι dt du ]tm , Support.pull dt du (snd a))

  -- viaSupport answers whenever the procedure answers the restricted
  -- query.
  viaSupport-just : ∀ (f : Proc) {Γ A t u} (dt : Γ ⊢tm t ∶ A) (du : Γ ⊢tm u ∶ A) →
                    T (is-just (f (Support.dt′ dt du) (Support.du′ dt du))) → T (is-just (viaSupport f dt du))
  viaSupport-just f dt du p with f (Support.dt′ dt du) (Support.du′ dt du)
  ... | just _ = tt
