------------------------------------------------------------------------
-- Decidability of the untyped step-conversion ≈ generated by N, β and
-- η (D18): given decidable equality of formula factors and of
-- generator labels, every word has a computable normal form, and ≈ is
-- decidable.  For typed words this is 1-cell equality in 𝒢 (the
-- theorem of §1 of the 2026-11-19 answer) via subject reduction in
-- `Typing`: the Church–Rosser joins of a typed word stay typed.
------------------------------------------------------------------------
open import CaTTExp.Gray.NBE.Base

module CaTTExp.Gray.NBE.Decide
  (Fac G : Set)
  (_≟F_ : (x y : Fac) → Dec (x ≡ y))
  (_≟G_ : (x y : G) → Dec (x ≡ y))
  where

open import CaTTExp.Gray.NBE.Syntax Fac G
open import CaTTExp.Gray.NBE.Lemmas Fac G
open import CaTTExp.Gray.NBE.Termination Fac G using (sn)
open import CaTTExp.Gray.NBE.Confluence Fac G

------------------------------------------------------------------------
-- Decidable equality

DecEq : Set → Set
DecEq A = (x y : A) → Dec (x ≡ y)

_≟L_ : DecEq Formula
[]       ≟L []       = yes refl
[]       ≟L (y ∷ ys) = no λ ()
(x ∷ xs) ≟L []       = no λ ()
(x ∷ xs) ≟L (y ∷ ys) with x ≟F y | xs ≟L ys
... | yes refl | yes refl = yes refl
... | no n     | _        = no λ e → n (∷-injˡ e)
... | yes _    | no n     = no λ e → n (∷-injʳ e)

_≟D_ : DecEq Dir
Ld ≟D Ld = yes refl
Ld ≟D Rd = no λ ()
Rd ≟D Ld = no λ ()
Rd ≟D Rd = yes refl

mutual
  _≟P_ : DecEq Prim
  gen x ≟P gen y with x ≟G y
  ... | yes refl = yes refl
  ... | no n     = no λ { refl → n refl }
  gen _ ≟P ev _ _ _    = no λ ()
  gen _ ≟P cur _ _ _ _ = no λ ()
  ev _ _ _ ≟P gen _    = no λ ()
  ev d A Z ≟P ev d' A' Z' with d ≟D d' | A ≟L A' | Z ≟L Z'
  ... | yes refl | yes refl | yes refl = yes refl
  ... | no n | _ | _ = no λ { refl → n refl }
  ... | yes _ | no n | _ = no λ { refl → n refl }
  ... | yes _ | yes _ | no n = no λ { refl → n refl }
  ev _ _ _ ≟P cur _ _ _ _ = no λ ()
  cur _ _ _ _ ≟P gen _    = no λ ()
  cur _ _ _ _ ≟P ev _ _ _ = no λ ()
  cur d A Z b ≟P cur d' A' Z' b' with d ≟D d' | A ≟L A' | Z ≟L Z' | b ≟W b'
  ... | yes refl | yes refl | yes refl | yes refl = yes refl
  ... | no n | _ | _ | _ = no λ { refl → n refl }
  ... | yes _ | no n | _ | _ = no λ { refl → n refl }
  ... | yes _ | yes _ | no n | _ = no λ { refl → n refl }
  ... | yes _ | yes _ | yes _ | no n = no λ { refl → n refl }

  _≟T_ : DecEq Triple
  tri l q r ≟T tri l' q' r' with l ≟L l' | q ≟P q' | r ≟L r'
  ... | yes refl | yes refl | yes refl = yes refl
  ... | no n | _ | _ = no λ { refl → n refl }
  ... | yes _ | no n | _ = no λ { refl → n refl }
  ... | yes _ | yes _ | no n = no λ { refl → n refl }

  _≟W_ : DecEq Word
  []       ≟W []       = yes refl
  []       ≟W (y ∷ ys) = no λ ()
  (x ∷ xs) ≟W []       = no λ ()
  (x ∷ xs) ≟W (y ∷ ys) with x ≟T y | xs ≟W ys
  ... | yes refl | yes refl = yes refl
  ... | no n     | _        = no λ e → n (∷-injˡ e)
  ... | yes _    | no n     = no λ e → n (∷-injʳ e)

------------------------------------------------------------------------
-- Prefix and suffix decomposition of formulas

prefix? : (xs ys : Formula) → Dec (Σ Formula λ zs → ys ≡ xs ++ zs)
prefix? []       ys       = yes (ys , refl)
prefix? (x ∷ xs) []       = no λ { (_ , ()) }
prefix? (x ∷ xs) (y ∷ ys) with x ≟F y | prefix? xs ys
... | yes refl | yes (zs , e) = yes (zs , cong (x ∷_) e)
... | no n     | _            = no λ { (_ , e) → n (sym (∷-injˡ e)) }
... | yes _    | no n         = no λ { (zs , e) → n (zs , ∷-injʳ e) }

suffix? : (xs ys : Formula) → Dec (Σ Formula λ zs → ys ≡ zs ++ xs)
suffix? xs ys with ys ≟L xs
... | yes e = yes ([] , e)
suffix? xs []       | no n = no λ { ([] , e) → n e ; (_ ∷ _ , ()) }
suffix? xs (y ∷ ys) | no n with suffix? xs ys
... | yes (zs , e) = yes (y ∷ zs , cong (y ∷_) e)
... | no m = no λ { ([] , e) → n e ; (z ∷ zs , e) → m (zs , ∷-injʳ e) }

------------------------------------------------------------------------
-- Head redexes

data NRedex : Triple → Word → Set where
  nred : ∀ {DL DR CL CR D0L D0R q d A Z b w}
    → DL ≡ CL ++ D0L → DR ≡ D0R ++ CR
    → NRedex (tri DL q DR) (tri CL (cur d A Z b) CR ∷ w)

data BRedex : Triple → Word → Set where
  bred : ∀ {l r CL CR d A Z b w}
    → l ≡ CL ++ pre d A → r ≡ post d A ++ CR
    → BRedex (tri l (cur d A Z b) r) (tri CL (ev d A Z) CR ∷ w)

data ERedex : Triple → Set where
  ered : ∀ {CL CR d A Z b g}
    → b ≡ map (wrap d A) g ++ (evT d A Z ∷ [])
    → ERedex (tri CL (cur d A Z b) CR)

data Cong : ∀ {u v} → u ⟶ v → Set where
  cskip : ∀ {t w w'} (s : w ⟶ w') → Cong (skip {t = t} s)
  cbody : ∀ {l r d A Z b b' w} (s : b ⟶ b') → Cong (body {l = l} {r = r} {d = d} {A = A} {Z = Z} {w = w} s)

classify : ∀ {t w v} (s : t ∷ w ⟶ v)
  → NRedex t w ⊎ BRedex t w ⊎ ERedex t ⊎ Cong s
classify (N e f)  = inl (nred e f)
classify (β e f)  = inr (inl (bred e f))
classify (η p)    = inr (inr (inl (ered p)))
classify (skip s) = inr (inr (inr (cskip s)))
classify (body s) = inr (inr (inr (cbody s)))

fireN : ∀ {t w} → NRedex t w → Σ Word λ v → t ∷ w ⟶ v
fireN (nred e f) = _ , N e f

fireB : ∀ {t w} → BRedex t w → Σ Word λ v → t ∷ w ⟶ v
fireB (bred e f) = _ , β e f

fireE : ∀ {t w} → ERedex t → Σ Word λ v → t ∷ w ⟶ v
fireE (ered p) = _ , η p

N? : ∀ t w → Dec (NRedex t w)
N? t [] = no λ ()
N? (tri DL q DR) (tri CL (cur d A Z b) CR ∷ w) with prefix? CL DL | suffix? CR DR
... | yes (_ , e) | yes (_ , f) = yes (nred e f)
... | no n | _ = no λ { (nred e f) → n (_ , e) }
... | yes _ | no n = no λ { (nred e f) → n (_ , f) }
N? t (tri _ (gen _) _ ∷ w)    = no λ ()
N? t (tri _ (ev _ _ _) _ ∷ w) = no λ ()

B? : ∀ t w → Dec (BRedex t w)
B? t [] = no λ ()
B? (tri l (cur d A Z b) r) (tri CL (ev d' A' Z') CR ∷ w)
  with d ≟D d' | A ≟L A' | Z ≟L Z'
... | no n | _ | _ = no λ { (bred _ _) → n refl }
... | yes _ | no n | _ = no λ { (bred _ _) → n refl }
... | yes _ | yes _ | no n = no λ { (bred _ _) → n refl }
... | yes refl | yes refl | yes refl
  with l ≟L (CL ++ pre d A) | r ≟L (post d A ++ CR)
...   | yes e | yes f = yes (bred e f)
...   | no n | _ = no λ { (bred e _) → n e }
...   | yes _ | no n = no λ { (bred _ f) → n f }
B? (tri _ (gen _) _) (_ ∷ _) = no λ ()
B? (tri _ (ev _ _ _) _) (_ ∷ _) = no λ ()
B? (tri _ (cur _ _ _ _) _) (tri _ (gen _) _ ∷ _) = no λ ()
B? (tri _ (cur _ _ _ _) _) (tri _ (cur _ _ _ _) _ ∷ _) = no λ ()

-- Is t the image of some triple under wrap d A?
strip? : ∀ d A t → Dec (Σ Triple λ t0 → t ≡ wrap d A t0)
strip? d A (tri l q r) with prefix? (pre d A) l | suffix? (post d A) r
... | yes (l0 , e) | yes (r0 , f) = yes (tri l0 q r0 , cong₂ (λ x y → tri x q y) e f)
... | no n | _ = no λ { (tri l0 _ _ , e) → n (l0 , cong tri-l e) }
... | yes _ | no n = no λ { (tri _ _ r0 , e) → n (r0 , cong tri-r e) }

-- Is b of the form T_a[g] ; e_{a,Z}?
body? : ∀ d A Z b → Dec (Σ Word λ g → b ≡ map (wrap d A) g ++ (evT d A Z ∷ []))
body? d A Z [] = no λ { ([] , ()) ; (_ ∷ _ , ()) }
body? d A Z (t ∷ []) with t ≟T evT d A Z
... | yes e = yes ([] , cong (_∷ []) e)
... | no n = no λ { ([] , e) → n (∷-injˡ e)
                  ; (_ ∷ [] , ()) ; (_ ∷ _ ∷ _ , ()) }
body? d A Z (t ∷ t' ∷ b) with strip? d A t | body? d A Z (t' ∷ b)
... | yes (t0 , e) | yes (g , f) = yes (t0 ∷ g , cong₂ _∷_ e f)
... | no n | _ = no λ { ([] , ()) ; (t0 ∷ g , e) → n (t0 , ∷-injˡ e) }
... | yes _ | no n = no λ { ([] , ()) ; (t0 ∷ g , e) → n (g , ∷-injʳ e) }

E? : ∀ t → Dec (ERedex t)
E? (tri CL (cur d A Z b) CR) with body? d A Z b
... | yes (g , p) = yes (ered p)
... | no n = no λ { (ered p) → n (_ , p) }
E? (tri _ (gen _) _)    = no λ ()
E? (tri _ (ev _ _ _) _) = no λ ()

------------------------------------------------------------------------
-- Progress: a word steps, or it is normal.

progress : ∀ w → (Σ Word λ v → w ⟶ v) ⊎ Normal w
progressT : ∀ t w → Normal w → (Σ Word λ v → t ∷ w ⟶ v) ⊎ Normal (t ∷ w)

progress []      = inr λ ()
progress (t ∷ w) with progress w
... | inl (v , s) = inl (t ∷ v , skip s)
... | inr nw      = progressT t w nw

progressT t w nw with N? t w | B? t w | E? t
... | yes r | _ | _ = inl (fireN r)
... | no _ | yes r | _ = inl (fireB r)
... | no _ | no _ | yes r = inl (fireE r)
progressT (tri l (cur d A Z b) r) w nw | no nN | no nB | no nE with progress b
... | inl (b' , s) = inl (_ , body s)
... | inr nb = inr λ s → stuck s
  where
    stuck : ∀ {v} (s : tri l (cur d A Z b) r ∷ w ⟶ v) → ⊥
    stuck s with classify s
    ... | inl x = nN x
    ... | inr (inl x) = nB x
    ... | inr (inr (inl x)) = nE x
    ... | inr (inr (inr (cskip s'))) = nw s'
    ... | inr (inr (inr (cbody s'))) = nb s'
progressT (tri l (gen x) r) w nw | no nN | no nB | no nE = inr λ s → stuck s
  where
    stuck : ∀ {v} (s : tri l (gen x) r ∷ w ⟶ v) → ⊥
    stuck s with classify s
    ... | inl x = nN x
    ... | inr (inl x) = nB x
    ... | inr (inr (inl x)) = nE x
    ... | inr (inr (inr (cskip s'))) = nw s'
progressT (tri l (ev d A Z) r) w nw | no nN | no nB | no nE = inr λ s → stuck s
  where
    stuck : ∀ {v} (s : tri l (ev d A Z) r ∷ w ⟶ v) → ⊥
    stuck s with classify s
    ... | inl x = nN x
    ... | inr (inl x) = nB x
    ... | inr (inr (inl x)) = nE x
    ... | inr (inr (inr (cskip s'))) = nw s'

------------------------------------------------------------------------
-- Normal forms

NF : Word → Set
NF w = Σ Word λ n → (w ⟶* n) × Normal n

nf-acc : ∀ w → SN w → NF w
nf-acc w (acc r) with progress w
... | inr nw = w , ε , nw
... | inl (v , s) with nf-acc v (r v s)
...   | n , p , nn = n , s ◅ p , nn

nf : ∀ w → NF w
nf w = nf-acc w (sn w)

normalize : Word → Word
normalize w = fst (nf w)

------------------------------------------------------------------------
-- Conversion, Church–Rosser, decidability

infix 4 _≈_
data _≈_ : Word → Word → Set where
  ≈-step  : ∀ {u v} → u ⟶ v → u ≈ v
  ≈-refl  : ∀ {u} → u ≈ u
  ≈-sym   : ∀ {u v} → u ≈ v → v ≈ u
  ≈-trans : ∀ {u v w} → u ≈ v → v ≈ w → u ≈ w

*→≈ : ∀ {u v} → u ⟶* v → u ≈ v
*→≈ ε       = ≈-refl
*→≈ (s ◅ p) = ≈-trans (≈-step s) (*→≈ p)

church-rosser : ∀ {u v} → u ≈ v → Join u v
church-rosser (≈-step s) = _ , one s , ε
church-rosser ≈-refl     = _ , ε , ε
church-rosser (≈-sym p) = swapJ (church-rosser p)
church-rosser (≈-trans p q) with church-rosser p | church-rosser q
... | x , a1 , a2 | y , b1 , b2 with confluence a2 b1
...   | z , c1 , c2 = z , a1 ◅◅ c1 , b2 ◅◅ c2

≈→nf : ∀ {u v} → u ≈ v → normalize u ≡ normalize v
≈→nf {u} {v} p with nf u | nf v | church-rosser p
... | n1 , p1 , nn1 | n2 , p2 , nn2 | x , a , b with confluence p1 a | confluence p2 b
...   | y , c1 , c2 | z , d1 , d2 =
  -- n1 ≡ y, n2 ≡ z, and x reaches both y and z, whose join is normal.
  let e1 = normal-stuck nn1 c1
      e2 = normal-stuck nn2 d1
      j  = confluence c2 d2
  in trans e1 (trans (normal-stuck (subst Normal e1 nn1) (fst (snd j)))
                     (sym (trans e2 (normal-stuck (subst Normal e2 nn2) (snd (snd j))))))

nf→≈ : ∀ {u v} → normalize u ≡ normalize v → u ≈ v
nf→≈ {u} {v} e with nf u | nf v
... | n1 , p1 , _ | n2 , p2 , _ =
  ≈-trans (*→≈ p1) (subst (λ k → k ≈ v) (sym e) (≈-sym (*→≈ p2)))

decide : ∀ u v → Dec (u ≈ v)
decide u v with normalize u ≟W normalize v
... | yes e = yes (nf→≈ e)
... | no n  = no λ p → n (≈→nf p)

------------------------------------------------------------------------
-- The typed restriction (via subject reduction in `Typing`)

open import CaTTExp.Gray.NBE.Typing Fac G using (NonEmpty; module Typed)

module TypedDecide
  (hom     : Dir → Formula → Formula → Fac)
  (src tgt : G → Formula)
  (src-ne  : ∀ x → NonEmpty (src x))
  where

  open Typed hom src tgt src-ne

  -- Convertible typed words are joined through typed words only.
  typed-church-rosser : ∀ {u v S T S' T'} → Ty u S T → Ty v S' T' → u ≈ v
    → Σ Word λ w → (u ⟶* w) × (v ⟶* w) × Ty w S T × Ty w S' T'
  typed-church-rosser tu tv p with church-rosser p
  ... | w , a , b = w , a , b , sr* tu a , sr* tv b

  -- The normal form of a typed word is typed, and `decide` decides
  -- conversion of typed words.
  normalize-typed : ∀ {u S T} → Ty u S T → Ty (normalize u) S T
  normalize-typed {u} tu = sr* tu (fst (snd (nf u)))

  typed-decide : ∀ {u v S T} → Ty u S T → Ty v S T → Dec (u ≈ v)
  typed-decide {u} {v} _ _ = decide u v
