------------------------------------------------------------------------
-- Normal forms of a finitely presented quotient
-- (r10 Response 3, "Building the normal forms"; ledger S3a, S20 (iii)).
--
-- r10 Response 3 builds each layer of F_{V+S}(Γ) the same way: list
-- the finitely many raw words over a given value (with fixed faces and
-- weight), join two words when one replaces the other by a single
-- application of an equation, and take as normal form the first word of
-- each connected component. This module proves that construction
-- correct once, for any carrier:
--
--   Presentation   raw words A with decidable equality; a one-step
--                  relation Step; a neighbour function nb listing the
--                  words one step away in either direction; and for
--                  every word a finite universe U x that contains x,
--                  is closed under nb, and is the same along a step
--                  (it depends only on conserved data such as faces
--                  and weight);
--   _≈_            the equivalence relation generated by Step;
--   eq?            ≈ is decidable;
--   nf             the first word of U x connected to x, with
--                  nf-≈ (nf x ≈ x), nf-cong (x ≈ y → nf x ≡ nf y),
--                  nf-complete (nf x ≡ nf y → x ≈ y) and nf-idem;
--   Compare        for a second presentation on the same words whose
--                  steps include the first's, the comparison map
--                  nf′ ∘ nf agrees with nf′, so it is well defined on
--                  classes and successive comparisons compose;
--   Cells, layerOf the normal forms as a type with decidable equality,
--                  and a Rule.Layer built from letters on raw words.
--
-- What is not here: the raw syntax of T₁₂ in every degree, its
-- equations and their finite grounding, which supply the Presentation
-- for each layer of F_{V+S} (ledger S3a). Grid.agda is the degree-4
-- instance on suspended grids, written before this module.
------------------------------------------------------------------------
open import CaTTExp.Prelude
open import CaTTExp.Join.Quiver using (_⊎_; inj₁; inj₂; Dec; yes; no)
open import CaTTExp.Join.Finite using (_∈L_; here; there; lengthL)
open import CaTTExp.Uniform.ListKit
open import CaTTExp.Uniform.Rule using (Layer)
import CaTTExp.Uniform.FiniteGraph as FG
open import CaTTExp.Uniform.Grid using (∈-filter⁺; ∈-filter⁻)

module CaTTExp.Uniform.Present where

record Presentation (A : Set) : Set₁ where
  field
    _≟_      : (x y : A) → Dec (x ≡ y)
    Step     : A → A → Set
    nb       : A → List A
    nb-sound : ∀ {x y} → y ∈L nb x → Step x y ⊎ Step y x
    nb-fwd   : ∀ {x y} → Step x y → y ∈L nb x
    nb-bwd   : ∀ {x y} → Step y x → y ∈L nb x
    U        : A → List A
    U-has    : ∀ x → x ∈L U x
    U-closed : ∀ {x y z} → y ∈L U x → z ∈L nb y → z ∈L U x
    U-step   : ∀ {x y} → Step x y → U x ≡ U y

module Present {A : Set} (P : Presentation A) where
  open Presentation P
  open FG _≟_ nb using (Star; ε; _◅_; _◅◅_; mem?; reachSet; reachSet-sound; module Saturate)

  infix 3 _≈_
  data _≈_ : A → A → Set where
    ≈-refl  : ∀ {x} → x ≈ x
    ≈-step  : ∀ {x y} → Step x y → x ≈ y
    ≈-sym   : ∀ {x y} → x ≈ y → y ≈ x
    ≈-trans : ∀ {x y z} → x ≈ y → y ≈ z → x ≈ z

  U-cong : ∀ {x y} → x ≈ y → U x ≡ U y
  U-cong ≈-refl        = refl
  U-cong (≈-step s)    = U-step s
  U-cong (≈-sym d)     = sym (U-cong d)
  U-cong (≈-trans d e) = trans (U-cong d) (U-cong e)

  private
    nb-≈ : ∀ {x y} → y ∈L nb x → x ≈ y
    nb-≈ m with nb-sound m
    ... | inj₁ s = ≈-step s
    ... | inj₂ s = ≈-sym (≈-step s)

    nb-sym : ∀ {x y} → y ∈L nb x → x ∈L nb y
    nb-sym m with nb-sound m
    ... | inj₁ s = nb-bwd s
    ... | inj₂ s = nb-fwd s

    star→≈ : ∀ {x y} → Star x y → x ≈ y
    star→≈ ε       = ≈-refl
    star→≈ (m ◅ s) = ≈-trans (nb-≈ m) (star→≈ s)

    star-snoc : ∀ {x y z} → Star x y → z ∈L nb y → Star x z
    star-snoc ε       m = m ◅ ε
    star-snoc (k ◅ s) m = k ◅ star-snoc s m

    star-rev : ∀ {x y} → Star x y → Star y x
    star-rev ε       = ε
    star-rev (m ◅ s) = star-snoc (star-rev s) (nb-sym m)

    ≈→star : ∀ {x y} → x ≈ y → Star x y
    ≈→star ≈-refl        = ε
    ≈→star (≈-step s)    = nb-fwd s ◅ ε
    ≈→star (≈-sym d)     = star-rev (≈→star d)
    ≈→star (≈-trans d e) = ≈→star d ◅◅ ≈→star e

  -- Connectivity, by breadth-first saturation inside U x.
  conn : A → A → Bool
  conn x y = isYes (mem? y (reachSet (lengthL (U x)) x))

  conn-sound : ∀ x y → T (conn x y) → x ≈ y
  conn-sound x y t = star→≈ (reachSet-sound (lengthL (U x)) x (isYes-sound (mem? y _) t))

  conn-complete : ∀ {x y} → x ≈ y → T (conn x y)
  conn-complete {x} {y} d =
    isYes-complete (mem? y _)
      (Saturate.reachSet-complete (U x) (λ {a} {b} → U-closed {x} {a} {b}) (U-has x) (≈→star d))

  eq? : ∀ x y → Dec (x ≈ y)
  eq? x y with T? (conn x y)
  ... | yes t = yes (conn-sound x y t)
  ... | no ¬t = no λ d → ¬t (conn-complete d)

  -- Normal forms: the first word of the component in U x.
  headOr : A → List A → A
  headOr d []      = d
  headOr d (x ∷ _) = x

  nf : A → A
  nf x = headOr x (filter (conn x) (U x))

  nf-≈ : ∀ x → nf x ≈ x
  nf-≈ x with filter (conn x) (U x) in e
  ... | []     = ≈-refl
  ... | y ∷ ys with ∈-filter⁻ (conn x) (U x) (subst (y ∈L_) (sym e) here)
  ...   | _ , t = ≈-sym (conn-sound x y t)

  private
    bool-ext : ∀ {a b} → (T a → T b) → (T b → T a) → a ≡ b
    bool-ext {true}  {true}  f g = refl
    bool-ext {false} {false} f g = refl
    bool-ext {true}  {false} f g = ⊥-elim (f tt)
    bool-ext {false} {true}  f g = ⊥-elim (g tt)

    filter-cong : ∀ {f g : A → Bool} → (∀ x → f x ≡ g x) → ∀ xs → filter f xs ≡ filter g xs
    filter-cong h [] = refl
    filter-cong {f} {g} h (x ∷ xs) rewrite h x with g x
    ... | true  = cong (x ∷_) (filter-cong h xs)
    ... | false = filter-cong h xs

    headOr-any : ∀ {d d′ x} xs → x ∈L xs → headOr d xs ≡ headOr d′ xs
    headOr-any (_ ∷ _) _ = refl

  nf-cong : ∀ {x y} → x ≈ y → nf x ≡ nf y
  nf-cong {x} {y} d =
    trans (headOr-any _ (∈-filter⁺ (conn x) (U x) (U-has x) (conn-complete ≈-refl)))
          (cong (headOr y) (trans (filter-cong same (U x)) (cong (filter (conn y)) (U-cong d))))
    where
    same : ∀ z → conn x z ≡ conn y z
    same z = bool-ext (λ t → conn-complete (≈-trans (≈-sym d) (conn-sound x z t)))
                      (λ t → conn-complete (≈-trans d (conn-sound y z t)))

  nf-complete : ∀ {x y} → nf x ≡ nf y → x ≈ y
  nf-complete {x} {y} e = ≈-trans (≈-sym (nf-≈ x)) (subst (_≈ y) (sym e) (nf-≈ y))

  nf-idem : ∀ x → nf (nf x) ≡ nf x
  nf-idem x = nf-cong (nf-≈ x)

  -- The classes as a type: words that are their own normal form.
  isNF : A → Bool
  isNF x = isYes (nf x ≟ x)

  Cell : Set
  Cell = Σ A λ x → T (isNF x)

  private
    T-irr : ∀ {b} (s t : T b) → s ≡ t
    T-irr {true} tt tt = refl

  cell-≡ : ∀ {c d : Cell} → fst c ≡ fst d → c ≡ d
  cell-≡ {x , s} {.x , t} refl = cong (x ,_) (T-irr s t)

  _≟C_ : (c d : Cell) → Dec (c ≡ d)
  (x , s) ≟C (y , t) with x ≟ y
  ... | yes refl = yes (cell-≡ refl)
  ... | no ne    = no λ e → ne (cong fst e)

  cellOf : A → Cell
  cellOf x = nf x , isYes-complete (nf (nf x) ≟ nf x) (nf-idem x)

  cellOf-≈ : ∀ x → fst (cellOf x) ≈ x
  cellOf-≈ = nf-≈

  -- Two words have the same cell exactly when they are equal.
  cellOf-sound : ∀ {x y} → cellOf x ≡ cellOf y → x ≈ y
  cellOf-sound e = nf-complete (cong fst e)

  cellOf-complete : ∀ {x y} → x ≈ y → cellOf x ≡ cellOf y
  cellOf-complete d = cell-≡ (nf-cong d)

  cellOf-self : ∀ (c : Cell) → cellOf (fst c) ≡ c
  cellOf-self (x , s) = cell-≡ (isYes-sound (nf x ≟ x) s)

------------------------------------------------------------------------
-- Comparison maps: a second presentation on the same words whose steps
-- include the first's.

module Compare {A : Set} (P P′ : Presentation A)
               (inc : ∀ {x y} → Presentation.Step P x y → Presentation.Step P′ x y) where
  module S  = Present P
  module S′ = Present P′

  ≈-mono : ∀ {x y} → x S.≈ y → x S′.≈ y
  ≈-mono S.≈-refl        = S′.≈-refl
  ≈-mono (S.≈-step s)    = S′.≈-step (inc s)
  ≈-mono (S.≈-sym d)     = S′.≈-sym (≈-mono d)
  ≈-mono (S.≈-trans d e) = S′.≈-trans (≈-mono d) (≈-mono e)

  -- The comparison on representatives: renormalize. It agrees with
  -- normalizing the original word, so it is well defined on classes.
  compare : A → A
  compare x = S′.nf (S.nf x)

  compare-nf : ∀ x → compare x ≡ S′.nf x
  compare-nf x = S′.nf-cong (≈-mono (S.nf-≈ x))

  compare-cong : ∀ {x y} → x S.≈ y → compare x ≡ compare y
  compare-cong d = trans (compare-nf _) (trans (S′.nf-cong (≈-mono d)) (sym (compare-nf _)))

-- Successive comparisons compose: going through a middle presentation
-- gives the same normal form as comparing directly.
module Compose {A : Set} (P P′ P″ : Presentation A)
               (i : ∀ {x y} → Presentation.Step P x y → Presentation.Step P′ x y)
               (j : ∀ {x y} → Presentation.Step P′ x y → Presentation.Step P″ x y) where
  private
    module C₁ = Compare P P′ i
    module C₂ = Compare P′ P″ j
    module C₃ = Compare P P″ (λ s → j (i s))

  compose : ∀ x → C₂.compare (C₁.compare x) ≡ C₃.compare x
  compose x = trans (C₂.compare-nf (C₁.compare x))
                (trans (C₂.S′.nf-cong (C₂.≈-mono (C₁.S′.nf-≈ (Present.nf P x))))
                       refl)

------------------------------------------------------------------------
-- A Rule.Layer whose cells are the normal forms of a presentation.
-- Letters, their targets (as raw words) and supports are read on the
-- representative of a cell.

record LayerData (A : Set) : Set₁ where
  field
    Letter : Set
    out₀   : A → List Letter
    tgt₀   : Letter → A
    Supp   : Set
    supp₀  : A → Supp
    suppL  : Letter → Supp
    _∪_    : Supp → Supp → Supp
    full   : Supp → Bool

layerOf : ∀ {A : Set} → Presentation A → LayerData A → Layer
layerOf P D = record
  { Cell   = Cell
  ; _≟_    = _≟C_
  ; Letter = Letter
  ; out    = λ c → out₀ (fst c)
  ; tgt    = λ ℓ → cellOf (tgt₀ ℓ)
  ; Supp   = Supp
  ; supp   = λ c → supp₀ (fst c)
  ; suppL  = suppL
  ; _∪_    = _∪_
  ; full   = full
  }
  where
  open Present P
  open LayerData D
