------------------------------------------------------------------------
-- Presheaves on codes used by the 𝔖̂ instance (S5): representables,
-- the Day tensor and the two closures.
--
--   y K₀     elements at K are the maps K → K₀; restriction is
--            precomposition.
--   A ⊛ B    the Day tensor, a coend: elements at K are (L, M, a, b, f)
--            with a at L, b at M and f : K → L ⊗ M, identified by the
--            equivalence generated by
--              (L, M, u^* a, v^* b, f) ∼ (L′, M′, a, b, (u ⊗ v) ∘ f).
--   A ⊸ C    the left closure: elements at K are families
--            φ_L : A(L) → C(L ⊗ K), natural in L and respecting ∼.
--   C ⟜ A    the right closure: families A(L) → C(K ⊗ L).
--
-- Restriction picks the element's code by a decision on codes; an
-- element not at the code of the map restricts to a fixed default.
------------------------------------------------------------------------
open import CaTTExp.Prelude using (Nat)
open import CaTTExp.Gray.Biclosed.Steiner.Codes using (FB)

module CaTTExp.Gray.Biclosed.Steiner.PshOps (nmFB : Nat → FB) where

open import CaTTExp.Prelude
open import CaTTExp.Gray.Biclosed.Steiner.Arith
open import CaTTExp.Gray.Biclosed.Steiner.Codes using (Code; AC; globe; named)
open import CaTTExp.Gray.Biclosed.Steiner.Psh nmFB

------------------------------------------------------------------------
-- Decidable equality of codes.

uipC : ∀ {A : Set} {a b : A} (p q : a ≡ b) → p ≡ q
uipC refl refl = refl

eqAC : AC → AC → Bool
eqAC (globe m) (globe n) = m ==ℕ n
eqAC (named m) (named n) = m ==ℕ n
eqAC _         _         = false

eqCode : Code → Code → Bool
eqCode []      []      = true
eqCode (a ∷ K) (b ∷ L) = eqAC a b ∧ eqCode K L
eqCode _       _       = false

private
  eqAC-sound : ∀ a b → T (eqAC a b) → a ≡ b
  eqAC-sound (globe m) (globe n) p = cong globe (==-sound m n p)
  eqAC-sound (named m) (named n) p = cong named (==-sound m n p)
  eqAC-sound (globe m) (named n) ()
  eqAC-sound (named m) (globe n) ()

  eqAC-refl : ∀ a → T (eqAC a a)
  eqAC-refl (globe n) = ==-refl n
  eqAC-refl (named n) = ==-refl n

  ∧I : ∀ {x y} → T x → T y → T (x ∧ y)
  ∧I {true} _ q = q

  eqCode-sound : ∀ K L → T (eqCode K L) → K ≡ L
  eqCode-sound []      []      _ = refl
  eqCode-sound (a ∷ K) (b ∷ L) p = cong₂ _∷_ (eqAC-sound a b (∧-fst p)) (eqCode-sound K L (∧-snd {eqAC a b} p))
  eqCode-sound []      (_ ∷ _) ()
  eqCode-sound (_ ∷ _) []      ()

  eqCode-refl : ∀ K → T (eqCode K K)
  eqCode-refl []      = tt
  eqCode-refl (a ∷ K) = ∧I (eqAC-refl a) (eqCode-refl K)

  decC-go : ∀ {K L : Code} (b : Bool) → (T b → K ≡ L) → Maybe (K ≡ L)
  decC-go true  s = just (s tt)
  decC-go false s = nothing

decCode : (K L : Code) → Maybe (K ≡ L)
decCode K L = decC-go (eqCode K L) (eqCode-sound K L)

decCode-refl : ∀ K → decCode K K ≡ just refl
decCode-refl K = go (eqCode K K) (eqCode-sound K K) (eqCode-refl K)
  where go : (b : Bool) (s : T b → K ≡ K) → T b → decC-go b s ≡ just refl
        go true  s _ = cong just (uipC (s tt) refl)
        go false s ()

------------------------------------------------------------------------
-- Representables.

module _ (K₀ : Code) where
  private
    YU : Set
    YU = Σ Code (λ K → Map K K₀)

    data _∼y_ : YU → YU → Set where
      ym : ∀ {K} {f g : Map K K₀} → f ≈M g → (K , f) ∼y (K , g)

    resY′ : ∀ {K₁ K₂ K′} → Maybe (K₂ ≡ K′) → Map K₁ K₂ → Map K′ K₀ → YU
    resY′ {K₁} (just refl) g f = K₁ , (f ∘M g)
    resY′      nothing     g f = K₀ , idMap K₀

    resY : ∀ {K₁ K₂} → Map K₁ K₂ → YU → YU
    resY {K₂ = K₂} g (K′ , f) = resY′ (decCode K₂ K′) g f

    resY-at : ∀ {K₁ K} (g : Map K₁ K) (f : Map K K₀) → resY g (K , f) ≡ (K₁ , (f ∘M g))
    resY-at {K = K} g f = cong (λ m → resY′ m g f) (decCode-refl K)

    ∼y-≡ : ∀ {x y} → x ≡ y → x ∼y y
    ∼y-≡ {K , f} refl = ym ≈M-refl

    ∼y-trans : ∀ {x y z} → x ∼y y → y ∼y z → x ∼y z
    ∼y-trans (ym e) (ym e′) = ym (≈M-trans _ e e′)

    rcong : ∀ {K₁ K₂} {g g′ : Map K₁ K₂} {x x′} → g ≈M g′ → x ∼y x′ → resY g x ∼y resY g′ x′
    rcong {K₂ = K₂} {g} {g′} eg (ym {K} {f} {f′} ef) = go (decCode K₂ K)
      where go : (m : Maybe (K₂ ≡ K)) → resY′ m g f ∼y resY′ m g′ f′
            go (just refl) = ym (∘M-cong ef eg)
            go nothing     = ym ≈M-refl

  yP : Psh
  yP = record
    { U = YU
    ; At = λ K x → fst x ≡ K
    ; _∼_ = _∼y_
    ; ∼-refl = ∼y-≡ refl
    ; ∼-sym = λ { (ym e) → ym (≈M-sym e) }
    ; ∼-trans = ∼y-trans
    ; res = resY
    ; res-cong = rcong
    ; At-res = λ { g {K , f} refl → cong fst (resY-at g f) }
    ; At-∼ = λ { (ym _) a → a }
    ; res-id = λ { {K} {.K , f} refl → ∼y-trans (∼y-≡ (resY-at (idMap K) f)) (ym (∘M-idr f)) }
    ; res-∘ = λ { {K} {L} {M} f g {.M , h} refl →
        ∼y-trans (∼y-≡ (resY-at (g ∘M f) h))
        (∼y-trans (ym (≈M-sym (∘M-assoc h g f)))
        (∼y-trans (∼y-≡ (sym (resY-at f (h ∘M g)))) (∼y-≡ (cong (resY f) (sym (resY-at g h)))))) }
    ; def = K₀ , idMap K₀
    }

------------------------------------------------------------------------
-- The Day tensor.

module _ (A B : Psh) where
  record DE : Set where
    constructor de
    field
      dK L₁ L₂ : Code
      da : U A
      db : U B
      df : Map dK (L₁ ++ (L₂ ++ []))

  infix 4 _∼D_
  data _∼D_ : DE → DE → Set where
    dcong  : ∀ {K L M a a′ b b′} {f f′ : Map K (L ++ (M ++ []))} →
             _∼_ A a a′ → _∼_ B b b′ → f ≈M f′ → de K L M a b f ∼D de K L M a′ b′ f′
    dgen   : ∀ {K L M L′ M′ a b} (u : Map L L′) (v : Map M M′) (f : Map K (L ++ (M ++ []))) →
             At A L′ a → At B M′ b →
             de K L M (res A u a) (res B v b) f ∼D de K L′ M′ a b ((u ⊗ₘ (v ⊗ₘ idMap [])) ∘M f)
    dsym   : ∀ {t t′} → t ∼D t′ → t′ ∼D t
    dtrans : ∀ {t t′ t″} → t ∼D t′ → t′ ∼D t″ → t ∼D t″

  AtD : Code → DE → Set
  AtD K (de K′ L M a b f) = (K′ ≡ K) × (At A L a × At B M b)

  defD : DE
  defD = de [] [] [] (def A) (def B) (idMap [])

  resD′ : ∀ {K₁ K₂ K′} → Maybe (K₂ ≡ K′) → Map K₁ K₂ → (L M : Code) → U A → U B → Map K′ (L ++ (M ++ [])) → DE
  resD′ {K₁} (just refl) g L M a b f = de K₁ L M a b (f ∘M g)
  resD′      nothing     g L M a b f = defD

  resD : ∀ {K₁ K₂} → Map K₁ K₂ → DE → DE
  resD {K₂ = K₂} g (de K′ L M a b f) = resD′ (decCode K₂ K′) g L M a b f

  resD-at : ∀ {K₁ K} (g : Map K₁ K) L M a b (f : Map K (L ++ (M ++ []))) → resD g (de K L M a b f) ≡ de K₁ L M a b (f ∘M g)
  resD-at {K = K} g L M a b f = cong (λ m → resD′ m g L M a b f) (decCode-refl K)

  ∼D-refl : ∀ {t} → t ∼D t
  ∼D-refl {de K L M a b f} = dcong (∼-refl A) (∼-refl B) ≈M-refl

  ∼D-≡ : ∀ {t t′} → t ≡ t′ → t ∼D t′
  ∼D-≡ refl = ∼D-refl

  private
    rcongD : ∀ {K₁ K₂} {g g′ : Map K₁ K₂} → g ≈M g′ → ∀ {t t′} → t ∼D t′ → resD g t ∼D resD g′ t′
    rcongD {K₂ = K₂} {g} {g′} eg (dcong {K} {L} {M} {a} {a′} {b} {b′} {f} {f′} ea eb ef) = go (decCode K₂ K)
      where go : (m : Maybe (K₂ ≡ K)) → resD′ m g L M a b f ∼D resD′ m g′ L M a′ b′ f′
            go (just refl) = dcong ea eb (∘M-cong ef eg)
            go nothing     = ∼D-refl
    rcongD {K₂ = K₂} {g} {g′} eg (dgen {K} {L} {M} {L′} {M′} {a} {b} u v f aa ab) = go (decCode K₂ K)
      where go : (m : Maybe (K₂ ≡ K)) → resD′ m g L M (res A u a) (res B v b) f ∼D resD′ m g′ L′ M′ a b ((u ⊗ₘ (v ⊗ₘ idMap [])) ∘M f)
            go (just refl) = dtrans (dgen u v (f ∘M g) aa ab)
                                    (dcong (∼-refl A) (∼-refl B)
                                      (≈M-trans _ (∘M-cong {g = u ⊗ₘ (v ⊗ₘ idMap [])} ≈M-refl (∘M-cong {g = f} ≈M-refl eg))
                                                  (≈M-sym (∘M-assoc (u ⊗ₘ (v ⊗ₘ idMap [])) f g′))))
            go nothing     = ∼D-refl
    rcongD eg (dsym p)     = dsym (rcongD (≈M-sym eg) p)
    rcongD eg (dtrans p q) = dtrans (rcongD eg p) (rcongD ≈M-refl q)

    at∼ : ∀ {t t′} → t ∼D t′ → ∀ {K} → (AtD K t → AtD K t′) × (AtD K t′ → AtD K t)
    at∼ (dcong ea eb ef) = (λ { (k , x , y) → k , At-∼ A ea x , At-∼ B eb y })
                         , (λ { (k , x , y) → k , At-∼ A (∼-sym A ea) x , At-∼ B (∼-sym B eb) y })
    at∼ (dgen u v f aa ab) = (λ { (k , _ , _) → k , aa , ab }) , (λ { (k , _ , _) → k , At-res A u aa , At-res B v ab })
    at∼ (dsym p) = snd (at∼ p) , fst (at∼ p)
    at∼ (dtrans p q) = (λ x → fst (at∼ q) (fst (at∼ p) x)) , (λ x → snd (at∼ p) (snd (at∼ q) x))

  Day : Psh
  Day = record
    { U = DE
    ; At = AtD
    ; _∼_ = _∼D_
    ; ∼-refl = ∼D-refl
    ; ∼-sym = dsym
    ; ∼-trans = dtrans
    ; res = resD
    ; res-cong = λ eg e → rcongD eg e
    ; At-res = λ { g {de K L M a b f} (refl , x , y) → subst (AtD _) (sym (resD-at g L M a b f)) (refl , x , y) }
    ; At-∼ = λ e a → fst (at∼ e) a
    ; res-id = λ { {K} {de .K L M a b f} (refl , _) →
        dtrans (∼D-≡ (resD-at (idMap K) L M a b f)) (dcong (∼-refl A) (∼-refl B) (∘M-idr f)) }
    ; res-∘ = λ { {K} {L₀} {M₀} f g {de .M₀ L M a b h} (refl , _) →
        dtrans (∼D-≡ (resD-at (g ∘M f) L M a b h))
        (dtrans (dcong (∼-refl A) (∼-refl B) (≈M-sym (∘M-assoc h g f)))
        (dtrans (∼D-≡ (sym (resD-at f L M a b (h ∘M g))))
                (∼D-≡ (cong (resD f) (sym (resD-at g L M a b h)))))) }
    ; def = defD
    }

------------------------------------------------------------------------
-- Map identities used by the closures.

private
  -- (h ⊗ 1) ∘ (1 ⊗ g) ≈ h ⊗ g ≈ (1 ⊗ g) ∘ (h ⊗ 1)
  ⊗-split₁ : ∀ {L L′ K K′} (h : Map L′ L) (g : Map K′ K) → ((h ⊗ₘ idMap K) ∘M (idMap L′ ⊗ₘ g)) ≈M (h ⊗ₘ g)
  ⊗-split₁ {L} {L′} {K} {K′} h g =
    ≈M-trans ((h ∘M idMap L′) ⊗ₘ (idMap K ∘M g)) (≈M-sym (⊗ₘ-∘ h (idMap L′) (idMap K) g))
             (⊗ₘ-cong (∘M-idr h) (∘M-idl g))

  ⊗-split₂ : ∀ {L L′ K K′} (h : Map L′ L) (g : Map K′ K) → ((idMap L ⊗ₘ g) ∘M (h ⊗ₘ idMap K′)) ≈M (h ⊗ₘ g)
  ⊗-split₂ {L} {L′} {K} {K′} h g =
    ≈M-trans ((idMap L ∘M h) ⊗ₘ (g ∘M idMap K′)) (≈M-sym (⊗ₘ-∘ (idMap L) h g (idMap K′)))
             (⊗ₘ-cong (∘M-idl h) (∘M-idr g))

  -- (1 ⊗ g) ∘ (1 ⊗ f) ≈ 1 ⊗ (g ∘ f), on either side
  ⊗-∘ʳ : ∀ {L K₁ K₂ K₃} (f : Map K₁ K₂) (g : Map K₂ K₃) → ((idMap L ⊗ₘ g) ∘M (idMap L ⊗ₘ f)) ≈M (idMap L ⊗ₘ (g ∘M f))
  ⊗-∘ʳ {L} f g = ≈M-trans ((idMap L ∘M idMap L) ⊗ₘ (g ∘M f)) (≈M-sym (⊗ₘ-∘ (idMap L) (idMap L) g f))
                          (⊗ₘ-cong (∘M-idl (idMap L)) ≈M-refl)

  ⊗-∘ˡ : ∀ {L K₁ K₂ K₃} (f : Map K₁ K₂) (g : Map K₂ K₃) → ((g ⊗ₘ idMap L) ∘M (f ⊗ₘ idMap L)) ≈M ((g ∘M f) ⊗ₘ idMap L)
  ⊗-∘ˡ {L} f g = ≈M-trans ((g ∘M f) ⊗ₘ (idMap L ∘M idMap L)) (≈M-sym (⊗ₘ-∘ g f (idMap L) (idMap L)))
                          (⊗ₘ-cong ≈M-refl (∘M-idl (idMap L)))

  ⊗-congˡ : ∀ {K K′ L L′} {f f′ : Map K K′} (g : Map L L′) → f ≈M f′ → (f ⊗ₘ g) ≈M (f′ ⊗ₘ g)
  ⊗-congˡ g e = ⊗ₘ-cong e ≈M-refl

------------------------------------------------------------------------
-- The left closure A ⊸ C: φ_L : A(L) → C(L ⊗ K).

module _ (A C : Psh) where
  LU : Set
  LU = Code → U A → U C

  record AtLH (K : Code) (φ : LU) : Set where
    constructor atlh
    field
      fat  : ∀ L x → At A L x → At C (L ++ K) (φ L x)
      fcg  : ∀ L x y → At A L x → At A L y → _∼_ A x y → _∼_ C (φ L x) (φ L y)
      fnat : ∀ {L′ L} (h : Map L′ L) x → At A L x → _∼_ C (φ L′ (res A h x)) (res C (h ⊗ₘ idMap K) (φ L x))
  open AtLH public

  _∼LH_ : LU → LU → Set
  φ ∼LH ψ = ∀ L x → At A L x → _∼_ C (φ L x) (ψ L x)

  resLH : ∀ {K′ K} → Map K′ K → LU → LU
  resLH g φ L x = res C (idMap L ⊗ₘ g) (φ L x)

  private
    C∼ = _∼_ C
    _⟨∼⟩_ : ∀ {x y z} → C∼ x y → C∼ y z → C∼ x z
    _⟨∼⟩_ = ∼-trans C
    infixr 5 _⟨∼⟩_

    atres : ∀ {K′ K} (g : Map K′ K) {φ} → AtLH K φ → AtLH K′ (resLH g φ)
    atres {K′} {K} g {φ} (atlh fa fc fn) = atlh
      (λ L x a → At-res C (idMap L ⊗ₘ g) (fa L x a))
      (λ L x y a b e → res-cong C ≈M-refl (fc L x y a b e))
      (λ {L′} {L} h x a →
         res-cong C ≈M-refl (fn h x a)
         ⟨∼⟩ ∼-sym C (res-∘ C (idMap L′ ⊗ₘ g) (h ⊗ₘ idMap K) (fa L x a))
         ⟨∼⟩ res-cong C (≈M-trans (h ⊗ₘ g) (⊗-split₁ h g) (≈M-sym (⊗-split₂ h g))) (∼-refl C)
         ⟨∼⟩ res-∘ C (h ⊗ₘ idMap K′) (idMap L ⊗ₘ g) (fa L x a))

    at∼ : ∀ {K φ ψ} → φ ∼LH ψ → AtLH K φ → AtLH K ψ
    at∼ {K} {φ} {ψ} e (atlh fa fc fn) = atlh
      (λ L x a → At-∼ C (e L x a) (fa L x a))
      (λ L x y a b ex → ∼-sym C (e L x a) ⟨∼⟩ fc L x y a b ex ⟨∼⟩ e L y b)
      (λ h x a → ∼-sym C (e _ (res A h x) (At-res A h a)) ⟨∼⟩ fn h x a ⟨∼⟩ res-cong C ≈M-refl (e _ x a))

  LH : Psh
  LH = record
    { U = LU
    ; At = AtLH
    ; _∼_ = _∼LH_
    ; ∼-refl = λ L x a → ∼-refl C
    ; ∼-sym = λ e L x a → ∼-sym C (e L x a)
    ; ∼-trans = λ e e′ L x a → ∼-trans C (e L x a) (e′ L x a)
    ; res = resLH
    ; res-cong = λ eg e L x a → res-cong C (⊗-congʳ (idMap L) eg) (e L x a)
    ; At-res = atres
    ; At-∼ = at∼
    ; res-id = λ { {K} {φ} at L x a → res-cong C (⊗ₘ-id L K) (∼-refl C) ⟨∼⟩ res-id C (fat at L x a) }
    ; res-∘ = λ { f g at L x a →
        res-cong C (≈M-sym (⊗-∘ʳ f g)) (∼-refl C) ⟨∼⟩ res-∘ C (idMap L ⊗ₘ f) (idMap L ⊗ₘ g) (fat at L x a) }
    ; def = λ _ _ → def C
    }

------------------------------------------------------------------------
-- The right closure C ⟜ A: φ_L : A(L) → C(K ⊗ L).

module _ (C A : Psh) where
  RU : Set
  RU = Code → U A → U C

  record AtRH (K : Code) (φ : RU) : Set where
    constructor atrh
    field
      gat  : ∀ L x → At A L x → At C (K ++ L) (φ L x)
      gcg  : ∀ L x y → At A L x → At A L y → _∼_ A x y → _∼_ C (φ L x) (φ L y)
      gnat : ∀ {L′ L} (h : Map L′ L) x → At A L x → _∼_ C (φ L′ (res A h x)) (res C (idMap K ⊗ₘ h) (φ L x))
  open AtRH public

  _∼RH_ : RU → RU → Set
  φ ∼RH ψ = ∀ L x → At A L x → _∼_ C (φ L x) (ψ L x)

  resRH : ∀ {K′ K} → Map K′ K → RU → RU
  resRH g φ L x = res C (g ⊗ₘ idMap L) (φ L x)

  private
    C∼ = _∼_ C
    _⟨∼⟩_ : ∀ {x y z} → C∼ x y → C∼ y z → C∼ x z
    _⟨∼⟩_ = ∼-trans C
    infixr 5 _⟨∼⟩_

    atres : ∀ {K′ K} (g : Map K′ K) {φ} → AtRH K φ → AtRH K′ (resRH g φ)
    atres {K′} {K} g {φ} (atrh fa fc fn) = atrh
      (λ L x a → At-res C (g ⊗ₘ idMap L) (fa L x a))
      (λ L x y a b e → res-cong C ≈M-refl (fc L x y a b e))
      (λ {L′} {L} h x a →
         res-cong C ≈M-refl (fn h x a)
         ⟨∼⟩ ∼-sym C (res-∘ C (g ⊗ₘ idMap L′) (idMap K ⊗ₘ h) (fa L x a))
         ⟨∼⟩ res-cong C (≈M-trans (g ⊗ₘ h) (⊗-split₂ g h) (≈M-sym (⊗-split₁ g h))) (∼-refl C)
         ⟨∼⟩ res-∘ C (idMap K′ ⊗ₘ h) (g ⊗ₘ idMap L) (fa L x a))

    at∼ : ∀ {K φ ψ} → φ ∼RH ψ → AtRH K φ → AtRH K ψ
    at∼ {K} {φ} {ψ} e (atrh fa fc fn) = atrh
      (λ L x a → At-∼ C (e L x a) (fa L x a))
      (λ L x y a b ex → ∼-sym C (e L x a) ⟨∼⟩ fc L x y a b ex ⟨∼⟩ e L y b)
      (λ h x a → ∼-sym C (e _ (res A h x) (At-res A h a)) ⟨∼⟩ fn h x a ⟨∼⟩ res-cong C ≈M-refl (e _ x a))

  RH : Psh
  RH = record
    { U = RU
    ; At = AtRH
    ; _∼_ = _∼RH_
    ; ∼-refl = λ L x a → ∼-refl C
    ; ∼-sym = λ e L x a → ∼-sym C (e L x a)
    ; ∼-trans = λ e e′ L x a → ∼-trans C (e L x a) (e′ L x a)
    ; res = resRH
    ; res-cong = λ eg e L x a → res-cong C (⊗-congˡ (idMap L) eg) (e L x a)
    ; At-res = atres
    ; At-∼ = at∼
    ; res-id = λ { {K} {φ} at L x a → res-cong C (⊗ₘ-id K L) (∼-refl C) ⟨∼⟩ res-id C (gat at L x a) }
    ; res-∘ = λ { f g at L x a →
        res-cong C (≈M-sym (⊗-∘ˡ f g)) (∼-refl C) ⟨∼⟩ res-∘ C (f ⊗ₘ idMap L) (g ⊗ₘ idMap L) (gat at L x a) }
    ; def = λ _ _ → def C
    }
