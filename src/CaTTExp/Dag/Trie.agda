------------------------------------------------------------------------
-- 4-ary tries keyed by natural numbers (generated by
-- tools/gen_dag_trie.py; do not edit).
--
-- A tnode stores at most one entry *together with its key*, and lookup
-- returns an entry only when the stored key equals the query. So the
-- soundness facts needed by the DAG checker are independent of how keys
-- are laid out:
--   lookup-All : All P t → lookupT k t ≡ just x → P k x
--   allT-All   : T (allT p t) → All (λ k x → T (p k x)) t
--   insert-All : All P t → P k x → All P (insert k x t)
-- Where keys are placed only matters for completeness (finding what
-- was inserted), never for soundness.
------------------------------------------------------------------------
open import CaTTExp.Prelude
open import Agda.Builtin.Nat using (div-helper; mod-helper)
open import Agda.Builtin.Strict using (primForce; primForceLemma)

module CaTTExp.Dag.Trie where

Entry : Set → Set
Entry A = Σ Nat (λ _ → A)

data Trie (A : Set) : Set where
  tleaf : Trie A
  tnode : Maybe (Entry A) → Trie A → Trie A → Trie A → Trie A → Trie A

dig : Nat → Nat
dig k = mod-helper 0 3 k 3

quo : Nat → Nat
quo k = div-helper 0 3 k 3

module _ {A : Set} where

  pick : Nat → Trie A → Trie A
  pick _ tleaf = tleaf
  pick 0 (tnode _ c0 c1 c2 c3) = c0
  pick 1 (tnode _ c0 c1 c2 c3) = c1
  pick 2 (tnode _ c0 c1 c2 c3) = c2
  pick 3 (tnode _ c0 c1 c2 c3) = c3
  pick _ (tnode _ _ _ _ _) = tleaf

  slot : Nat → Maybe (Entry A) → Maybe A
  slot o nothing        = nothing
  slot o (just (k , x)) = if k ==ℕ o then just x else nothing

  look : Nat → Nat → Nat → Trie A → Maybe A
  look zero    o k       t = nothing
  look (suc f) o zero    tleaf = nothing
  look (suc f) o zero    (tnode m _ _ _ _) = slot o m
  look (suc f) o (suc k) t = look f o (quo (suc k)) (pick (dig (suc k)) t)

  lookupT : Nat → Trie A → Maybe A
  lookupT k t = look 16 k k t

  setc : Nat → (Trie A → Trie A) → Trie A → Trie A
  setc 0 f tleaf = primForce (f tleaf) (λ x → tnode nothing x tleaf tleaf tleaf)
  setc 1 f tleaf = primForce (f tleaf) (λ x → tnode nothing tleaf x tleaf tleaf)
  setc 2 f tleaf = primForce (f tleaf) (λ x → tnode nothing tleaf tleaf x tleaf)
  setc 3 f tleaf = primForce (f tleaf) (λ x → tnode nothing tleaf tleaf tleaf x)
  setc 0 f (tnode m c0 c1 c2 c3) = primForce (f c0) (λ x → tnode m x c1 c2 c3)
  setc 1 f (tnode m c0 c1 c2 c3) = primForce (f c1) (λ x → tnode m c0 x c2 c3)
  setc 2 f (tnode m c0 c1 c2 c3) = primForce (f c2) (λ x → tnode m c0 c1 x c3)
  setc 3 f (tnode m c0 c1 c2 c3) = primForce (f c3) (λ x → tnode m c0 c1 c2 x)
  setc _ f t = t

  setm : Maybe (Entry A) → Trie A → Trie A
  setm m tleaf = tnode m tleaf tleaf tleaf tleaf
  setm m (tnode _ c0 c1 c2 c3) = tnode m c0 c1 c2 c3

  ins : Nat → Nat → Nat → A → Trie A → Trie A
  ins zero    o k       x t = t
  ins (suc f) o zero    x t = setm (just (o , x)) t
  ins (suc f) o (suc k) x t = setc (dig (suc k)) (ins f o (quo (suc k)) x) t

  insert : Nat → A → Trie A → Trie A
  insert k x t = ins 16 k k x t

  allM : (Nat → A → Bool) → Maybe (Entry A) → Bool
  allM p nothing        = true
  allM p (just (k , x)) = p k x

  allT : (Nat → A → Bool) → Trie A → Bool
  allT p tleaf = true
  allT p (tnode m c0 c1 c2 c3) = allM p m ∧ allT p c0 ∧ allT p c1 ∧ allT p c2 ∧ allT p c3

  ------------------------------------------------------------------
  -- All

  AllM : (Nat → A → Set) → Maybe (Entry A) → Set
  AllM P nothing        = ⊤
  AllM P (just (k , x)) = P k x

  All : (Nat → A → Set) → Trie A → Set
  All P tleaf = ⊤
  All P (tnode m c0 c1 c2 c3) = AllM P m × All P c0 × All P c1 × All P c2 × All P c3

  module _ {P : Nat → A → Set} where
    pick-All : ∀ d t → All P t → All P (pick d t)
    pick-All _ tleaf _ = tt
    pick-All 0 (tnode _ c0 c1 c2 c3) (_ , p0 , p1 , p2 , p3) = p0
    pick-All 1 (tnode _ c0 c1 c2 c3) (_ , p0 , p1 , p2 , p3) = p1
    pick-All 2 (tnode _ c0 c1 c2 c3) (_ , p0 , p1 , p2 , p3) = p2
    pick-All 3 (tnode _ c0 c1 c2 c3) (_ , p0 , p1 , p2 , p3) = p3
    pick-All (suc (suc (suc (suc d)))) (tnode _ _ _ _ _) _ = tt

    slot-All : ∀ o m {x} → AllM P m → slot o m ≡ just x → P o x
    slot-All o nothing _ ()
    slot-All o (just (k , y)) p e with k ==ℕ o in eq
    slot-All o (just (k , y)) p refl | true with ==ℕ-sound k o (subst T (sym eq) tt)
    ... | refl = p
    slot-All o (just (k , y)) p () | false

    look-All : ∀ f o k t {x} → All P t → look f o k t ≡ just x → P o x
    look-All zero    o k       t p ()
    look-All (suc f) o zero    tleaf p ()
    look-All (suc f) o zero    (tnode m _ _ _ _) (pm , _) e = slot-All o m pm e
    look-All (suc f) o (suc k) t p e =
      look-All f o (quo (suc k)) (pick (dig (suc k)) t) (pick-All (dig (suc k)) t p) e

    lookup-All : ∀ {k t x} → All P t → lookupT k t ≡ just x → P k x
    lookup-All {k} {t} p e = look-All 16 k k t p e

    tleaf-All : All P tleaf
    tleaf-All = tt

    setc-All : ∀ d f t → All P t → (∀ c → All P c → All P (f c)) → All P (setc d f t)
    setc-All 0 f tleaf _ h = subst (All P) (sym (primForceLemma (f tleaf) (λ x → tnode nothing x tleaf tleaf tleaf))) (tt , h tleaf tt , tt , tt , tt)
    setc-All 1 f tleaf _ h = subst (All P) (sym (primForceLemma (f tleaf) (λ x → tnode nothing tleaf x tleaf tleaf))) (tt , tt , h tleaf tt , tt , tt)
    setc-All 2 f tleaf _ h = subst (All P) (sym (primForceLemma (f tleaf) (λ x → tnode nothing tleaf tleaf x tleaf))) (tt , tt , tt , h tleaf tt , tt)
    setc-All 3 f tleaf _ h = subst (All P) (sym (primForceLemma (f tleaf) (λ x → tnode nothing tleaf tleaf tleaf x))) (tt , tt , tt , tt , h tleaf tt)
    setc-All 0 f (tnode m c0 c1 c2 c3) (pm , p0 , p1 , p2 , p3) h = subst (All P) (sym (primForceLemma (f c0) (λ x → tnode m x c1 c2 c3))) (pm , h c0 p0 , p1 , p2 , p3)
    setc-All 1 f (tnode m c0 c1 c2 c3) (pm , p0 , p1 , p2 , p3) h = subst (All P) (sym (primForceLemma (f c1) (λ x → tnode m c0 x c2 c3))) (pm , p0 , h c1 p1 , p2 , p3)
    setc-All 2 f (tnode m c0 c1 c2 c3) (pm , p0 , p1 , p2 , p3) h = subst (All P) (sym (primForceLemma (f c2) (λ x → tnode m c0 c1 x c3))) (pm , p0 , p1 , h c2 p2 , p3)
    setc-All 3 f (tnode m c0 c1 c2 c3) (pm , p0 , p1 , p2 , p3) h = subst (All P) (sym (primForceLemma (f c3) (λ x → tnode m c0 c1 c2 x))) (pm , p0 , p1 , p2 , h c3 p3)
    setc-All (suc (suc (suc (suc d)))) f tleaf p h = p
    setc-All (suc (suc (suc (suc d)))) f (tnode _ _ _ _ _) p h = p

    setm-All : ∀ m t → AllM P m → All P t → All P (setm m t)
    setm-All m tleaf pm _ = pm , tt , tt , tt , tt
    setm-All m (tnode _ c0 c1 c2 c3) pm (_ , p0 , p1 , p2 , p3) = pm , p0 , p1 , p2 , p3

    ins-All : ∀ f o k x t → All P t → P o x → All P (ins f o k x t)
    ins-All zero    o k       x t p q = p
    ins-All (suc f) o zero    x t p q = setm-All (just (o , x)) t q p
    ins-All (suc f) o (suc k) x t p q =
      setc-All (dig (suc k)) (ins f o (quo (suc k)) x) t p
        (λ c pc → ins-All f o (quo (suc k)) x c pc q)

    insert-All : ∀ {k x t} → All P t → P k x → All P (insert k x t)
    insert-All {k} {x} {t} p q = ins-All 16 k k x t p q

  All-map : ∀ {P Q : Nat → A → Set} → (∀ k x → P k x → Q k x) → ∀ t → All P t → All Q t
  All-map g tleaf _ = tt
  All-map g (tnode nothing c0 c1 c2 c3) (_ , p0 , p1 , p2 , p3) = tt , All-map g c0 p0 , All-map g c1 p1 , All-map g c2 p2 , All-map g c3 p3
  All-map g (tnode (just (k , x)) c0 c1 c2 c3) (pm , p0 , p1 , p2 , p3) = g k x pm , All-map g c0 p0 , All-map g c1 p1 , All-map g c2 p2 , All-map g c3 p3

  allM-All : ∀ (p : Nat → A → Bool) m → T (allM p m) → AllM (λ k x → T (p k x)) m
  allM-All p nothing        _ = tt
  allM-All p (just (k , x)) q = q

  allT-All : ∀ (p : Nat → A → Bool) t → T (allT p t) → All (λ k x → T (p k x)) t
  allT-All p tleaf _ = tt
  allT-All p (tnode m c0 c1 c2 c3) q =
    let q0 = ∧-snd {allM p m} q in
    let q1 = ∧-snd {allT p c0} q0 in
    let q2 = ∧-snd {allT p c1} q1 in
    let q3 = ∧-snd {allT p c2} q2 in
    allM-All p m (∧-fst q) , allT-All p c0 (∧-fst q0) , allT-All p c1 (∧-fst q1) , allT-All p c2 (∧-fst q2) , allT-All p c3 q3

