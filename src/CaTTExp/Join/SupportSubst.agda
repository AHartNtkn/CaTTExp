------------------------------------------------------------------------
-- Substitution closure of the support equations
-- (notes/conjectures/answered/lax-interchange-construction-or-
--  impossibility-2026-11-19.md, §4.3–4.4, equation (38)).
--
-- The theory T imposes, for every finite pasting diagram, equality of
-- parallel paths of contextual 4-edges that use the same set of edges.
-- A substitution sends each contextual edge to a path (possibly empty,
-- for an edge sent to an identity) and paths to concatenations.
--
--   edges-σ   (38): the edges of σ p are the union, over the edges e
--             of p, of the edges of σ e (both directions).
--   same-σ    equal edge sets have equal image edge sets.
--   ≈-σ       the congruence generated by the support equations is
--             carried into the target's support congruence, so the
--             support equations form one theory closed under every
--             substitution, degenerate ones included.
--
-- Everything is for arbitrary quivers: loops and repeated edges are
-- allowed, as in K_Γ, and no decidable equality is used.
------------------------------------------------------------------------
open import CaTTExp.Prelude
open import CaTTExp.Join.Quiver

module CaTTExp.Join.SupportSubst where

module _ {V : Set} {G : V → V → Set} where

  ∈E-++ˡ : ∀ {x y a b c} {h : G x y} (p : Path G a b) {q : Path G b c} →
           h ∈E p → h ∈E (p ++ᵖ q)
  ∈E-++ˡ (g ∷ p) here      = here
  ∈E-++ˡ (g ∷ p) (there m) = there (∈E-++ˡ p m)

  ∈E-++ʳ : ∀ {x y a b c} {h : G x y} (p : Path G a b) {q : Path G b c} →
           h ∈E q → h ∈E (p ++ᵖ q)
  ∈E-++ʳ []      m = m
  ∈E-++ʳ (g ∷ p) m = there (∈E-++ʳ p m)

  ∈E-++⁻ : ∀ {x y a b c} {h : G x y} (p : Path G a b) {q : Path G b c} →
           h ∈E (p ++ᵖ q) → (h ∈E p) ⊎ (h ∈E q)
  ∈E-++⁻ []      m         = inj₂ m
  ∈E-++⁻ (g ∷ p) here      = inj₁ here
  ∈E-++⁻ (g ∷ p) (there m) with ∈E-++⁻ p m
  ... | inj₁ m′ = inj₁ (there m′)
  ... | inj₂ m′ = inj₂ m′

  -- Same set of edges (proof-relevant memberships, both ways).
  SameEdges : ∀ {a b a′ b′} → Path G a b → Path G a′ b′ → Set
  SameEdges p q = (∀ {x y} {h : G x y} → h ∈E p → h ∈E q) ×
                  (∀ {x y} {h : G x y} → h ∈E q → h ∈E p)

  -- The support congruence: support equations between parallel paths,
  -- closed under context, symmetry and transitivity.
  infix 4 _≈s_
  data _≈s_ : ∀ {a b} → Path G a b → Path G a b → Set where
    supp   : ∀ {a b} {p q : Path G a b} → SameEdges p q → p ≈s q
    ctx    : ∀ {a b c d} (l : Path G a c) {p q : Path G c d} (r : Path G d b) →
             p ≈s q → l ++ᵖ (p ++ᵖ r) ≈s l ++ᵖ (q ++ᵖ r)
    rfl    : ∀ {a b} {p : Path G a b} → p ≈s p
    sym≈   : ∀ {a b} {p q : Path G a b} → p ≈s q → q ≈s p
    trans≈ : ∀ {a b} {p q r : Path G a b} → p ≈s q → q ≈s r → p ≈s r

module _ {V V′ : Set} {G : V → V → Set} {G′ : V′ → V′ → Set}
         (f₀ : V → V′)
         (σ : ∀ {a b} → G a b → Path G′ (f₀ a) (f₀ b)) where

  -- A substitution acts on paths by concatenating the edge images.
  σ* : ∀ {a b} → Path G a b → Path G′ (f₀ a) (f₀ b)
  σ* []      = []
  σ* (g ∷ p) = σ g ++ᵖ σ* p

  σ-++ : ∀ {a b c} (p : Path G a b) (q : Path G b c) → σ* (p ++ᵖ q) ≡ σ* p ++ᵖ σ* q
  σ-++ []      q = refl
  σ-++ (g ∷ p) q = trans (cong (σ g ++ᵖ_) (σ-++ p q)) (sym (++ᵖ-assoc (σ g) (σ* p) (σ* q)))

  -- (38), both inclusions.
  edges-σ⁻ : ∀ {a b x′ y′} (p : Path G a b) {h : G′ x′ y′} → h ∈E σ* p →
             Σ V λ x → Σ V λ y → Σ (G x y) λ g → (g ∈E p) × (h ∈E σ g)
  edges-σ⁻ []      ()
  edges-σ⁻ (g ∷ p) m with ∈E-++⁻ (σ g) m
  ... | inj₁ m′ = _ , _ , g , here , m′
  ... | inj₂ m′ with edges-σ⁻ p m′
  ...   | x , y , g′ , mg , mh = x , y , g′ , there mg , mh

  edges-σ⁺ : ∀ {a b x y x′ y′} (p : Path G a b) {g : G x y} {h : G′ x′ y′} →
             g ∈E p → h ∈E σ g → h ∈E σ* p
  edges-σ⁺ (g ∷ p) here      mh = ∈E-++ˡ (σ g) mh
  edges-σ⁺ (k ∷ p) (there m) mh = ∈E-++ʳ (σ k) (edges-σ⁺ p m mh)

  -- Equal edge sets have equal image edge sets.
  same-σ : ∀ {a b a′ b′} {p : Path G a b} {q : Path G a′ b′} →
           SameEdges p q → SameEdges (σ* p) (σ* q)
  same-σ {p = p} {q} (pq , qp) =
    (λ m → let (_ , _ , g , mg , mh) = edges-σ⁻ p m in edges-σ⁺ q (pq mg) mh) ,
    (λ m → let (_ , _ , g , mg , mh) = edges-σ⁻ q m in edges-σ⁺ p (qp mg) mh)

  -- The support congruence is carried into the target's.
  ≈-σ : ∀ {a b} {p q : Path G a b} → p ≈s q → σ* p ≈s σ* q
  ≈-σ (supp s) = supp (same-σ s)
  ≈-σ (ctx l {p} {q} r e) =
    subst₂′ (σ-++′ l p r) (σ-++′ l q r) (ctx (σ* l) (σ* r) (≈-σ e))
    where
    σ-++′ : ∀ {a c d b} (l : Path G a c) (p : Path G c d) (r : Path G d b) →
            σ* l ++ᵖ (σ* p ++ᵖ σ* r) ≡ σ* (l ++ᵖ (p ++ᵖ r))
    σ-++′ l p r = sym (trans (σ-++ l (p ++ᵖ r)) (cong (σ* l ++ᵖ_) (σ-++ p r)))
    subst₂′ : ∀ {a b} {x x′ y y′ : Path G′ a b} → x ≡ x′ → y ≡ y′ → x ≈s y → x′ ≈s y′
    subst₂′ refl refl e = e
  ≈-σ rfl          = rfl
  ≈-σ (sym≈ e)     = sym≈ (≈-σ e)
  ≈-σ (trans≈ e f) = trans≈ (≈-σ e) (≈-σ f)
