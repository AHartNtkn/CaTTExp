------------------------------------------------------------------------
-- The layer where the switches act: 4-cells of F_{V+S} on a suspended
-- inner grid, for every setting S (spec/02-lax-core.md §2.3,
-- "The switch settings" and example (b); ledger S3, E12).
--
-- Model (r10 Response 3, "Which equations the switches add" and the
-- check of `scripts/e6/interchange_fibre_decorations.py`,
-- `check_switch_settings`). Fix an m × n grid: inner cells a₁ … a_m
-- and b₁ … b_n in interchange position.
--   Words      the shuffles of the a's and b's, as Bool lists
--              (true = an a-letter, false = a b-letter; the indices are
--              determined by the order);
--   Edges      the generating 3-advances: a block crossing ⟨i , p , q⟩
--              replaces the b-run of length p+1 at position i, followed
--              by an a-run of length q+1, by the a-run then the b-run;
--   raw paths  lists of edges, valid when they run from b…b a…a to
--              a…a b…b;
--   equations  the switch laws of the setting, in every chronological
--              context (prefix and suffix):
--                left split (inner composite-crossing law, `icc`):
--                  ⟨i,p,a+1+b⟩ = ⟨i,p,a⟩ ; ⟨i+a+1,p,b⟩,
--                right split (R, `rsp`):
--                  ⟨i,a+1+b,q⟩ = ⟨i+a+1,b,q⟩ ; ⟨i,a,q⟩.
--              V itself adds no equation between raw paths here (the
--              generating 3-advances are pure, with no proper outer
--              crossing as partner), so in setting ∅ the 4-cells are
--              the raw paths.
--
-- In each setting the 4-cells are the classes of valid raw paths
-- under the equivalence relation `sw ⊢ p ≈ q` generated by the typed
-- switch steps (both sides valid). Proved here:
--   eq?         equality of 4-cells is decidable (connectivity in the
--               finite graph of one-step switch applications,
--               r10 Response 3 "Building the normal forms");
--   nf          normal forms: the first raw path of the class in a
--               fixed enumeration (the rank selection "first word in
--               each component"), with nf-≈, nf-cong, nf-complete;
--   ≈-mono,     the comparison maps F_{V+S} → F_{V+S′} for S ⊆ S′ are
--   nf-compare  well defined on normal forms and computable
--               (r10 Response 3 "Reachability and comparisons").
-- The class counts on the 1 × 2 and 2 × 3 grids are computed in
-- CaTTExp.Uniform.GridExamples.
--
-- Not modelled: letters one dimension up (5-cells between 4-paths).
-- So this module gives equality in the layer, i.e. the coherence case
-- of the side condition at degree four, not directed reachability by
-- 5-cells. See the module footer.
------------------------------------------------------------------------
open import CaTTExp.Prelude
open import CaTTExp.Join.Quiver using (_⊎_; inj₁; inj₂; Dec; yes; no)
open import CaTTExp.Join.Finite using (_∈L_; here; there; _≤_; z≤n; s≤s; lengthL; NoDup; []; _∷_)
open import CaTTExp.Join.SwitchLaws using (Switches; vS; iccS; rspS; allS)
open import CaTTExp.Uniform.ListKit
open import CaTTExp.Uniform.Arith
import CaTTExp.Uniform.FiniteGraph as FG

module CaTTExp.Uniform.Grid where

open Switches

------------------------------------------------------------------------
-- Decidable equality.

_≟B_ : (a b : Bool) → Dec (a ≡ b)
true  ≟B true  = yes refl
false ≟B false = yes refl
true  ≟B false = no λ ()
false ≟B true  = no λ ()

≟List : ∀ {A : Set} → ((x y : A) → Dec (x ≡ y)) → (xs ys : List A) → Dec (xs ≡ ys)
≟List d []       []       = yes refl
≟List d []       (_ ∷ _)  = no λ ()
≟List d (_ ∷ _)  []       = no λ ()
≟List d (x ∷ xs) (y ∷ ys) with d x y | ≟List d xs ys
... | yes refl | yes refl = yes refl
... | no ne    | _        = no λ { refl → ne refl }
... | yes _    | no ne    = no λ { refl → ne refl }

≟Maybe : ∀ {A : Set} → ((x y : A) → Dec (x ≡ y)) → (x y : Maybe A) → Dec (x ≡ y)
≟Maybe d nothing  nothing  = yes refl
≟Maybe d nothing  (just _) = no λ ()
≟Maybe d (just _) nothing  = no λ ()
≟Maybe d (just x) (just y) with d x y
... | yes refl = yes refl
... | no ne    = no λ { refl → ne refl }

------------------------------------------------------------------------
-- Words and edges.

Word : Set
Word = List Bool

_≟W_ : (w w′ : Word) → Dec (w ≡ w′)
_≟W_ = ≟List _≟B_

-- ⟨ i , p , q ⟩ crosses the b-run of length p + 1 starting at position
-- i past the a-run of length q + 1 that follows it.
record Edge : Set where
  constructor ⟨_,_,_⟩
  field
    pos pb qa : Nat
open Edge

_≟E_ : (e e′ : Edge) → Dec (e ≡ e′)
⟨ i , p , q ⟩ ≟E ⟨ i′ , p′ , q′ ⟩ with i ≟N i′ | p ≟N p′ | q ≟N q′
... | yes refl | yes refl | yes refl = yes refl
... | no ne | _ | _ = no λ { refl → ne refl }
... | yes _ | no ne | _ = no λ { refl → ne refl }
... | yes _ | yes _ | no ne = no λ { refl → ne refl }

RawPath : Set
RawPath = List Edge

_≟P_ : (p q : RawPath) → Dec (p ≡ q)
_≟P_ = ≟List _≟E_

rep : Nat → Bool → Word
rep zero    x = []
rep (suc k) x = x ∷ rep k x

-- Remove k leading copies of x.
strip : Nat → Bool → Word → Maybe Word
strip zero    x w       = just w
strip (suc k) x []      = nothing
strip (suc k) x (y ∷ w) with x ≟B y
... | yes _ = strip k x w
... | no _  = nothing

mapM : ∀ {A B : Set} → (A → B) → Maybe A → Maybe B
mapM f nothing  = nothing
mapM f (just x) = just (f x)

cross : Edge → Word → Maybe Word
cross ⟨ suc i , p , q ⟩ []      = nothing
cross ⟨ suc i , p , q ⟩ (x ∷ w) = mapM (x ∷_) (cross ⟨ i , p , q ⟩ w)
cross ⟨ zero  , p , q ⟩ w with strip (suc p) false w
... | nothing = nothing
... | just w₁ with strip (suc q) true w₁
...   | nothing = nothing
...   | just w₂ = just (rep (suc q) true ++ (rep (suc p) false ++ w₂))

run : Word → RawPath → Maybe Word
run w []       = just w
run w (e ∷ es) with cross e w
... | nothing = nothing
... | just w′ = run w′ es

------------------------------------------------------------------------
-- Every edge that applies to w lies in a finite list.

private
  strip-len : ∀ k x w {w′} → strip k x w ≡ just w′ → lengthL w ≡ k + lengthL w′
  strip-len zero    x w       refl = refl
  strip-len (suc k) x []      ()
  strip-len (suc k) x (y ∷ w) e with x ≟B y
  ... | yes _ = cong suc (strip-len k x w e)
  ... | no _  with e
  ...   | ()

  mapM-just : ∀ {A B : Set} (f : A → B) (m : Maybe A) {b} → mapM f m ≡ just b →
              Σ A λ a → m ≡ just a
  mapM-just f (just a) _ = a , refl

_<_ : Nat → Nat → Set
a < b = suc a ≤ b

cross-bound : ∀ i p q w {w′} → cross ⟨ i , p , q ⟩ w ≡ just w′ →
              (i < lengthL w) × (p < lengthL w) × (q < lengthL w)
cross-bound (suc i) p q [] ()
cross-bound (suc i) p q (x ∷ w) e with mapM-just (x ∷_) (cross ⟨ i , p , q ⟩ w) e
... | _ , e′ with cross-bound i p q w e′
...   | bi , bp , bq = s≤s bi , ≤-sucʳ bp , ≤-sucʳ bq
cross-bound zero p q w e with strip (suc p) false w in e₁
... | nothing = ⊥-elim (nothing≢ e)
  where nothing≢ : ∀ {w′ : Word} → _≡_ {A = Maybe Word} nothing (just w′) → ⊥
        nothing≢ ()
... | just w₁ with strip (suc q) true w₁ in e₂
...   | nothing = ⊥-elim (nothing≢ e)
  where nothing≢ : ∀ {w′ : Word} → _≡_ {A = Maybe Word} nothing (just w′) → ⊥
        nothing≢ ()
...   | just w₂ =
  subst (λ n → (0 < n) × (p < n) × (q < n)) (sym L₁)
    (s≤s z≤n , s≤s (≤-+ʳ p (lengthL w₁)) ,
     ≤-trans (subst (suc q ≤_) (sym L₂) (≤-+ʳ (suc q) (lengthL w₂))) (≤-+ˡ (suc p) (lengthL w₁)))
  where
  L₁ = strip-len (suc p) false w e₁
  L₂ = strip-len (suc q) true w₁ e₂

-- 0 … N−1.
range : Nat → List Nat
range zero    = []
range (suc N) = zero ∷ mapK suc (range N)

range-has : ∀ {a N} → a < N → a ∈L range N
range-has {zero}  {suc N} _       = here
range-has {suc a} {suc N} (s≤s l) = there (∈-map⁺ suc (range-has l))

triples : Nat → List Edge
triples N =
  concatK (mapK (λ i → concatK (mapK (λ p → mapK (λ q → ⟨ i , p , q ⟩) (range N)) (range N)))
                (range N))

triples-has : ∀ {i p q N} → i < N → p < N → q < N → ⟨ i , p , q ⟩ ∈L triples N
triples-has {i} {p} {q} {N} bi bp bq =
  ∈-concat⁺ _
    (∈-concat⁺ _ (∈-map⁺ (λ q → ⟨ i , p , q ⟩) (range-has bq))
                 (∈-map⁺ (λ p → mapK (λ q → ⟨ i , p , q ⟩) (range N)) (range-has bp)))
    (∈-map⁺ (λ i → concatK (mapK (λ p → mapK (λ q → ⟨ i , p , q ⟩) (range N)) (range N)))
            (range-has bi))

isJust : ∀ {A : Set} → Maybe A → Bool
isJust nothing  = false
isJust (just _) = true

∈-filter⁺ : ∀ {A : Set} (f : A → Bool) {x} xs → x ∈L xs → T (f x) → x ∈L filter f xs
∈-filter⁺ f (y ∷ xs) here t with f y
... | true = here
∈-filter⁺ f (y ∷ xs) (there m) t with f y
... | true  = there (∈-filter⁺ f xs m t)
... | false = ∈-filter⁺ f xs m t

∈-filter⁻ : ∀ {A : Set} (f : A → Bool) {x} xs → x ∈L filter f xs → (x ∈L xs) × T (f x)
∈-filter⁻ f (y ∷ xs) m with f y in e
∈-filter⁻ f (y ∷ xs) here      | true = here , subst T (sym e) tt
∈-filter⁻ f (y ∷ xs) (there m) | true with ∈-filter⁻ f xs m
... | m′ , t = there m′ , t
∈-filter⁻ f (y ∷ xs) m | false with ∈-filter⁻ f xs m
... | m′ , t = there m′ , t

edgesAt : Word → List Edge
edgesAt w = filter (λ e → isJust (cross e w)) (triples (lengthL w))

edgesAt-has : ∀ e w {w′} → cross e w ≡ just w′ → e ∈L edgesAt w
edgesAt-has ⟨ i , p , q ⟩ w c with cross-bound i p q w c
... | bi , bp , bq =
  ∈-filter⁺ (λ e → isJust (cross e w)) (triples (lengthL w)) (triples-has bi bp bq)
    (subst (λ m → T (isJust m)) (sym c) tt)

------------------------------------------------------------------------
-- All raw paths of length at most k from w to t.

hereP : Word → Word → List RawPath
hereP w t with w ≟W t
... | yes _ = [] ∷ []
... | no _  = []

mutual
  allPaths : Nat → Word → Word → List RawPath
  allPaths k w t = hereP w t ++ more k w t

  more : Nat → Word → Word → List RawPath
  more zero    w t = []
  more (suc k) w t = concatK (mapK (λ e → ext k t e (cross e w)) (edgesAt w))

  ext : Nat → Word → Edge → Maybe Word → List RawPath
  ext k t e nothing   = []
  ext k t e (just w′) = mapK (e ∷_) (allPaths k w′ t)

allPaths-has : ∀ k w t (es : RawPath) → run w es ≡ just t → lengthL es ≤ k →
               es ∈L allPaths k w t
allPaths-has k w t [] refl _ with w ≟W w
... | yes _ = here
... | no ne = ⊥-elim (ne refl)
allPaths-has (suc k) w t (e ∷ es) r (s≤s l) with cross e w in c
... | just w′ =
  ∈-++ʳ (hereP w t)
    (∈-concat⁺ _ (subst (λ mw → (e ∷ es) ∈L ext k t e mw) (sym c)
                        (∈-map⁺ (e ∷_) (allPaths-has k w′ t es r l)))
                 (∈-map⁺ (λ e → ext k t e (cross e w)) (edgesAt-has e w c)))

allPaths-sound : ∀ k w t {es : RawPath} → es ∈L allPaths k w t → run w es ≡ just t
allPaths-sound k w t {es} m with ∈-++⁻ (hereP w t) m
... | inj₁ h = here-sound w t h
  where
  here-sound : ∀ w t {es} → es ∈L hereP w t → run w es ≡ just t
  here-sound w t h with w ≟W t
  here-sound w t here | yes refl = refl
allPaths-sound (suc k) w t {es} m | inj₂ h with ∈-concat⁻ (mapK (λ e → ext k t e (cross e w)) (edgesAt w)) h
... | xs , mx , mxs with ∈-map⁻ (λ e → ext k t e (cross e w)) (edgesAt w) mxs
...   | e , _ , refl = ext-sound (cross e w) refl mx
  where
  ext-sound : ∀ mw → cross e w ≡ mw → es ∈L ext k t e mw → run w es ≡ just t
  ext-sound (just w′) c mx′ with ∈-map⁻ (e ∷_) (allPaths k w′ t) mx′
  ... | es′ , m′ , refl rewrite c = allPaths-sound k w′ t m′

------------------------------------------------------------------------
-- All runs of exactly k edges from w (to any word). If there is none
-- of length K + 1 from w, every path from w has length at most K, so
-- allPaths K lists all of them (allPaths-all).

mutual
  runs : Nat → Word → List RawPath
  runs zero    w = [] ∷ []
  runs (suc k) w = concatK (mapK (λ e → extR k e (cross e w)) (edgesAt w))

  extR : Nat → Edge → Maybe Word → List RawPath
  extR k e nothing   = []
  extR k e (just w′) = mapK (e ∷_) (runs k w′)

runs-has : ∀ k w (es : RawPath) {t} → run w es ≡ just t → lengthL es ≡ k → es ∈L runs k w
runs-has zero w [] r refl = here
runs-has (suc k) w (e ∷ es) r refl with cross e w in c
... | just w′ =
  ∈-concat⁺ _ (subst (λ mw → (e ∷ es) ∈L extR k e mw) (sym c)
                     (∈-map⁺ (e ∷_) (runs-has k w′ es r refl)))
              (∈-map⁺ (λ e → extR k e (cross e w)) (edgesAt-has e w c))

private
  run-prefix : ∀ w xs ys {t} → run w (xs ++ ys) ≡ just t → Σ Word λ w′ → run w xs ≡ just w′
  run-prefix w []       ys r = w , refl
  run-prefix w (x ∷ xs) ys r with cross x w
  ... | just w′ = run-prefix w′ xs ys r

  split-at : ∀ {A : Set} K (es : List A) → suc K ≤ lengthL es →
             Σ (List A) λ xs → Σ (List A) λ ys → (es ≡ xs ++ ys) × (lengthL xs ≡ suc K)
  split-at zero    (e ∷ es) _       = e ∷ [] , es , refl , refl
  split-at (suc K) (e ∷ es) (s≤s l) with split-at K es l
  ... | xs , ys , refl , lx = e ∷ xs , ys , refl , cong suc lx

  ≤-total : ∀ a b → (a ≤ b) ⊎ (suc b ≤ a)
  ≤-total zero    b       = inj₁ z≤n
  ≤-total (suc a) zero    = inj₂ (s≤s z≤n)
  ≤-total (suc a) (suc b) with ≤-total a b
  ... | inj₁ l = inj₁ (s≤s l)
  ... | inj₂ l = inj₂ (s≤s l)

  ∉[] : ∀ {A : Set} {x : A} {xs} → xs ≡ [] → ¬ (x ∈L xs)
  ∉[] refl ()

allPaths-all : ∀ K w t → runs (suc K) w ≡ [] →
               ∀ (es : RawPath) → run w es ≡ just t → es ∈L allPaths K w t
allPaths-all K w t none es r with ≤-total (lengthL es) K
... | inj₁ l = allPaths-has K w t es r l
... | inj₂ l with split-at K es l
...   | xs , ys , refl , lx with run-prefix w xs ys r
...     | w′ , rx = ⊥-elim (∉[] none (runs-has (suc K) w xs rx lx))

------------------------------------------------------------------------
-- The switch laws.

-- (a , b) with a + 1 + b + 1 = n + 1: the ways to cut a run of length
-- n + 1 into two nonempty runs, of lengths a + 1 and b + 1.
cuts : Nat → List (Nat × Nat)
cuts zero    = []
cuts (suc n) = (zero , n) ∷ mapK (λ ab → suc (fst ab) , snd ab) (cuts n)

cuts-sound : ∀ {a b} n → (a , b) ∈L cuts n → a + suc b ≡ n
cuts-sound (suc n) here = refl
cuts-sound (suc n) (there m) with ∈-map⁻ (λ ab → suc (fst ab) , snd ab) (cuts n) m
... | (a′ , b′) , m′ , refl = cong suc (cuts-sound n m′)

-- Left split (the inner composite-crossing law): the crossing of the
-- b-run past a composite a-run is the crossing past its first piece,
-- then past its second.
leftS : Edge → List RawPath
leftS ⟨ i , p , q ⟩ =
  mapK (λ ab → ⟨ i , p , fst ab ⟩ ∷ ⟨ i + suc (fst ab) , p , snd ab ⟩ ∷ []) (cuts q)

-- Right split R: the crossing of a composite b-run past the a-run is
-- the crossing of its second piece, then of its first.
rightS : Edge → List RawPath
rightS ⟨ i , p , q ⟩ =
  mapK (λ ab → ⟨ i + suc (fst ab) , snd ab , q ⟩ ∷ ⟨ i , fst ab , q ⟩ ∷ []) (cuts p)

when : ∀ {A : Set} → Bool → List A → List A
when true  xs = xs
when false xs = []

splits : Switches → Edge → List RawPath
splits sw e = when (icc sw) (leftS e) ++ when (rsp sw) (rightS e)

-- Every split is a two-letter path, and the split edge is one of two
-- candidates computed from its letters.
mergeCands : Edge → Edge → List Edge
mergeCands x y = ⟨ pos x , pb x , qa x + suc (qa y) ⟩ ∷ ⟨ pos y , pb y + suc (pb x) , qa y ⟩ ∷ []

private
  when-elim : ∀ {A : Set} b (xs : List A) {x} → x ∈L when b xs → x ∈L xs
  when-elim true xs m = m

  leftS-shape : ∀ e {r} → r ∈L leftS e →
                Σ Edge λ x → Σ Edge λ y → (r ≡ x ∷ y ∷ []) × (e ∈L mergeCands x y)
  leftS-shape ⟨ i , p , q ⟩ m with ∈-map⁻ _ (cuts q) m
  ... | (a , b) , m′ , refl rewrite sym (cuts-sound q m′) = _ , _ , refl , here

  rightS-shape : ∀ e {r} → r ∈L rightS e →
                 Σ Edge λ x → Σ Edge λ y → (r ≡ x ∷ y ∷ []) × (e ∈L mergeCands x y)
  rightS-shape ⟨ i , p , q ⟩ m with ∈-map⁻ _ (cuts p) m
  ... | (a , b) , m′ , refl rewrite sym (cuts-sound p m′) = _ , _ , refl , there here

splits-shape : ∀ sw e {r} → r ∈L splits sw e →
               Σ Edge λ x → Σ Edge λ y → (r ≡ x ∷ y ∷ []) × (e ∈L mergeCands x y)
splits-shape sw e m with ∈-++⁻ (when (icc sw) (leftS e)) m
... | inj₁ m′ = leftS-shape e (when-elim (icc sw) _ m′)
... | inj₂ m′ = rightS-shape e (when-elim (rsp sw) _ m′)

------------------------------------------------------------------------
-- Charge: the positive grading of a 4-path (block crossings weigh the
-- product of their operand lengths, (K52)). The switch laws preserve
-- it, and it bounds the length of a path.

chg : Edge → Nat
chg ⟨ i , p , q ⟩ = suc p * suc q

charge : RawPath → Nat
charge []       = zero
charge (e ∷ es) = chg e + charge es

charge-++ : ∀ xs ys → charge (xs ++ ys) ≡ charge xs + charge ys
charge-++ []       ys = refl
charge-++ (x ∷ xs) ys = trans (cong (chg x +_) (charge-++ xs ys)) (sym (+-assoc (chg x) _ _))

length≤charge : ∀ es → lengthL es ≤ charge es
length≤charge []                   = z≤n
length≤charge (⟨ i , p , q ⟩ ∷ es) =
  s≤s (≤-trans (length≤charge es) (≤-+ˡ (q + p * suc q) (charge es)))

private
  leftS-charge : ∀ e {r} → r ∈L leftS e → charge r ≡ chg e
  leftS-charge ⟨ i , p , q ⟩ m with ∈-map⁻ _ (cuts q) m
  ... | (a , b) , m′ , refl rewrite sym (cuts-sound q m′) =
    trans (cong (suc p * suc a +_) (+-zero (suc p * suc b)))
      (sym (*-distribˡ (suc p) (suc a) (suc b)))

  rightS-charge : ∀ e {r} → r ∈L rightS e → charge r ≡ chg e
  rightS-charge ⟨ i , p , q ⟩ m with ∈-map⁻ _ (cuts p) m
  ... | (a , b) , m′ , refl rewrite sym (cuts-sound p m′) =
    trans (cong (suc b * suc q +_) (+-zero (suc a * suc q)))
      (trans (+-comm (suc b * suc q) (suc a * suc q))
        (sym (*-distribʳ (suc a) (suc b) (suc q))))

splits-charge : ∀ sw e {r} → r ∈L splits sw e → charge r ≡ chg e
splits-charge sw e m with ∈-++⁻ (when (icc sw) (leftS e)) m
... | inj₁ m′ = leftS-charge e (when-elim (icc sw) _ m′)
... | inj₂ m′ = rightS-charge e (when-elim (rsp sw) _ m′)

------------------------------------------------------------------------
-- One switch application, in a chronological context.

data Step (sw : Switches) : RawPath → RawPath → Set where
  step : ∀ pre e post {r} → r ∈L splits sw e → Step sw (pre ++ e ∷ post) (pre ++ r ++ post)

step-charge : ∀ {sw p q} → Step sw p q → charge q ≡ charge p
step-charge {sw} (step pre e post {r} m) =
  trans (charge-++ pre (r ++ post))
    (trans (cong (charge pre +_) (trans (charge-++ r post) (cong (_+ charge post) (splits-charge sw e m))))
           (sym (charge-++ pre (e ∷ post))))

-- Decompositions of a list around one letter, and around two.
decomps : ∀ {A : Set} → List A → List (List A × A × List A)
decomps []       = []
decomps (x ∷ xs) = ([] , x , xs) ∷ mapK (λ d → (x ∷ fst d) , snd d) (decomps xs)

decomps-has : ∀ {A : Set} pre (e : A) post → (pre , e , post) ∈L decomps (pre ++ e ∷ post)
decomps-has []        e post = here
decomps-has (x ∷ pre) e post = there (∈-map⁺ (λ d → (x ∷ fst d) , snd d) (decomps-has pre e post))

decomps-sound : ∀ {A : Set} xs {pre} {e : A} {post} → (pre , e , post) ∈L decomps xs →
                xs ≡ pre ++ e ∷ post
decomps-sound (x ∷ xs) here = refl
decomps-sound (x ∷ xs) (there m) with ∈-map⁻ (λ d → (x ∷ fst d) , snd d) (decomps xs) m
... | (pre′ , e′ , post′) , m′ , refl = cong (x ∷_) (decomps-sound xs m′)

decomps2 : ∀ {A : Set} → List A → List (List A × A × A × List A)
decomps2 []           = []
decomps2 (x ∷ [])     = []
decomps2 (x ∷ y ∷ xs) =
  ([] , x , y , xs) ∷ mapK (λ d → (x ∷ fst d) , snd d) (decomps2 (y ∷ xs))

decomps2-has : ∀ {A : Set} pre (x y : A) post → (pre , x , y , post) ∈L decomps2 (pre ++ x ∷ y ∷ post)
decomps2-has []             x y post = here
decomps2-has (z ∷ [])       x y post = there (∈-map⁺ (λ d → (z ∷ fst d) , snd d) here)
decomps2-has (z ∷ z′ ∷ pre) x y post =
  there (∈-map⁺ (λ d → (z ∷ fst d) , snd d) (decomps2-has (z′ ∷ pre) x y post))

decomps2-sound : ∀ {A : Set} xs {pre} {x y : A} {post} → (pre , x , y , post) ∈L decomps2 xs →
                 xs ≡ pre ++ x ∷ y ∷ post
decomps2-sound (x ∷ y ∷ xs) here = refl
decomps2-sound (x ∷ y ∷ xs) (there m) with ∈-map⁻ (λ d → (x ∷ fst d) , snd d) (decomps2 (y ∷ xs)) m
... | _ , m′ , refl = cong (x ∷_) (decomps2-sound (y ∷ xs) m′)

-- All one-step applications forwards (split) and backwards (merge).
forward : Switches → RawPath → List RawPath
forward sw p =
  concatK (mapK (λ d → mapK (λ r → fst d ++ r ++ snd (snd d)) (splits sw (fst (snd d))))
                (decomps p))

forward-has : ∀ sw pre e post {r} → r ∈L splits sw e →
              (pre ++ r ++ post) ∈L forward sw (pre ++ e ∷ post)
forward-has sw pre e post m =
  ∈-concat⁺ _ (∈-map⁺ (λ r → pre ++ r ++ post) m)
    (∈-map⁺ (λ d → mapK (λ r → fst d ++ r ++ snd (snd d)) (splits sw (fst (snd d))))
            (decomps-has pre e post))

forward-sound : ∀ sw p {q} → q ∈L forward sw p → Step sw p q
forward-sound sw p mq with ∈-concat⁻ _ mq
... | qs , mq′ , mqs with ∈-map⁻ (λ d → mapK (λ r → fst d ++ r ++ snd (snd d)) (splits sw (fst (snd d)))) (decomps p) mqs
...   | (pre , e , post) , md , refl with ∈-map⁻ (λ r → pre ++ r ++ post) (splits sw e) mq′
...     | r , mr , refl rewrite decomps-sound p md = step pre e post mr

≟Path2 : (r r′ : RawPath) → Dec (r ≡ r′)
≟Path2 = _≟P_

memP : RawPath → List RawPath → Bool
memP r rs = isYes (FG.mem? _≟P_ (λ _ → []) r rs)

merges : Switches → Edge → Edge → List Edge
merges sw x y = filter (λ e → memP (x ∷ y ∷ []) (splits sw e)) (mergeCands x y)

backward : Switches → RawPath → List RawPath
backward sw p =
  concatK (mapK (λ d → mapK (λ e → fst d ++ e ∷ snd (snd (snd d)))
                            (merges sw (fst (snd d)) (fst (snd (snd d)))))
                (decomps2 p))

backward-has : ∀ sw pre e post {r} → r ∈L splits sw e →
               (pre ++ e ∷ post) ∈L backward sw (pre ++ r ++ post)
backward-has sw pre e post {r} m with splits-shape sw e m
... | x , y , refl , mc =
  ∈-concat⁺ _
    (∈-map⁺ (λ e → pre ++ e ∷ post)
      (∈-filter⁺ (λ e → memP (x ∷ y ∷ []) (splits sw e)) (mergeCands x y) mc
        (isYes-complete (FG.mem? _≟P_ (λ _ → []) (x ∷ y ∷ []) (splits sw e)) m)))
    (∈-map⁺ (λ d → mapK (λ e → fst d ++ e ∷ snd (snd (snd d)))
                        (merges sw (fst (snd d)) (fst (snd (snd d)))))
            (decomps2-has pre x y post))

backward-sound : ∀ sw p {q} → q ∈L backward sw p → Step sw q p
backward-sound sw p mq with ∈-concat⁻ _ mq
... | qs , mq′ , mqs with ∈-map⁻ (λ d → mapK (λ e → fst d ++ e ∷ snd (snd (snd d)))
                                               (merges sw (fst (snd d)) (fst (snd (snd d)))))
                                  (decomps2 p) mqs
...   | (pre , x , y , post) , md , refl with ∈-map⁻ (λ e → pre ++ e ∷ post) (merges sw x y) mq′
...     | e , me , refl with ∈-filter⁻ (λ e → memP (x ∷ y ∷ []) (splits sw e)) (mergeCands x y) me
...       | _ , t rewrite decomps2-sound p md =
  step pre e post (isYes-sound (FG.mem? _≟P_ (λ _ → []) (x ∷ y ∷ []) (splits sw e)) t)

------------------------------------------------------------------------
-- The grid.

module OnGrid (m n : Nat) where

  start end : Word
  start = rep n false ++ rep m true
  end   = rep m true ++ rep n false

  Valid : RawPath → Set
  Valid p = run start p ≡ just end

  valid? : (p : RawPath) → Dec (Valid p)
  valid? p = ≟Maybe _≟W_ (run start p) (just end)

  validB : RawPath → Bool
  validB p = isYes (valid? p)

  ----------------------------------------------------------------------
  -- Neighbours: the valid paths one switch application away, in either
  -- direction.

  nb : Switches → RawPath → List RawPath
  nb sw p with valid? p
  ... | yes _ = filter validB (forward sw p ++ backward sw p)
  ... | no _  = []

  nb-sound : ∀ sw p {q} → q ∈L nb sw p → Valid p × Valid q × (Step sw p q ⊎ Step sw q p)
  nb-sound sw p {q} mq with valid? p
  ... | yes vp with ∈-filter⁻ validB (forward sw p ++ backward sw p) mq
  ...   | m , t with ∈-++⁻ (forward sw p) m
  ...     | inj₁ f = vp , isYes-sound (valid? q) t , inj₁ (forward-sound sw p f)
  ...     | inj₂ b = vp , isYes-sound (valid? q) t , inj₂ (backward-sound sw p b)

  nb-fwd : ∀ {sw p q} → Valid p → Valid q → Step sw p q → q ∈L nb sw p
  nb-fwd {sw} {q = q} vp vq (step pre e post m) with valid? (pre ++ e ∷ post)
  ... | yes _ = ∈-filter⁺ validB _ (∈-++ˡ (backward sw (pre ++ e ∷ post)) (forward-has sw pre e post m))
                  (isYes-complete (valid? q) vq)
  ... | no ¬v = ⊥-elim (¬v vp)

  nb-bwd : ∀ {sw p q} → Valid p → Valid q → Step sw q p → q ∈L nb sw p
  nb-bwd {sw} {p} {q} vp vq (step pre e post {r} m) with valid? (pre ++ r ++ post)
  ... | yes _ = ∈-filter⁺ validB _ (∈-++ʳ (forward sw (pre ++ r ++ post)) (backward-has sw pre e post m))
                  (isYes-complete (valid? q) vq)
  ... | no ¬v = ⊥-elim (¬v vp)

  ----------------------------------------------------------------------
  -- Equality of 4-cells in setting sw: the equivalence relation
  -- generated by typed switch applications.

  infix 3 _⊢_≈_
  data _⊢_≈_ (sw : Switches) : RawPath → RawPath → Set where
    ≈-refl  : ∀ {p} → sw ⊢ p ≈ p
    ≈-step  : ∀ {p q} → Valid p → Valid q → Step sw p q → sw ⊢ p ≈ q
    ≈-sym   : ∀ {p q} → sw ⊢ p ≈ q → sw ⊢ q ≈ p
    ≈-trans : ∀ {p q r} → sw ⊢ p ≈ q → sw ⊢ q ≈ r → sw ⊢ p ≈ r

  ≈-charge : ∀ {sw p q} → sw ⊢ p ≈ q → charge p ≡ charge q
  ≈-charge ≈-refl           = refl
  ≈-charge (≈-step _ _ s)   = sym (step-charge s)
  ≈-charge (≈-sym e)        = sym (≈-charge e)
  ≈-charge (≈-trans e e′)   = trans (≈-charge e) (≈-charge e′)

  ≈-valid : ∀ {sw p q} → sw ⊢ p ≈ q → (Valid p → Valid q) × (Valid q → Valid p)
  ≈-valid ≈-refl          = (λ v → v) , (λ v → v)
  ≈-valid (≈-step vp vq _) = (λ _ → vq) , (λ _ → vp)
  ≈-valid (≈-sym e) with ≈-valid e
  ... | f , g = g , f
  ≈-valid (≈-trans e e′) with ≈-valid e | ≈-valid e′
  ... | f , g | f′ , g′ = (λ v → f′ (f v)) , (λ v → g (g′ v))

  -- The finite universe of a class: valid paths of the same charge.
  Uc : Nat → List RawPath
  Uc c = filter (λ q → isYes (charge q ≟N c)) (allPaths c start end)

  U : RawPath → List RawPath
  U p = Uc (charge p)

  U-has : ∀ {p} → Valid p → p ∈L U p
  U-has {p} vp =
    ∈-filter⁺ (λ q → isYes (charge q ≟N charge p)) _
      (allPaths-has (charge p) start end p vp (length≤charge p))
      (isYes-complete (charge p ≟N charge p) refl)

  module Setting (sw : Switches) where
    open FG _≟P_ (nb sw) public

    star→≈ : ∀ {p q} → Star p q → sw ⊢ p ≈ q
    star→≈ ε = ≈-refl
    star→≈ (m ◅ s) with nb-sound sw _ m
    ... | vp , vq , inj₁ st = ≈-trans (≈-step vp vq st) (star→≈ s)
    ... | vp , vq , inj₂ st = ≈-trans (≈-sym (≈-step vq vp st)) (star→≈ s)

    nb-sym : ∀ {p q} → q ∈L nb sw p → p ∈L nb sw q
    nb-sym m with nb-sound sw _ m
    ... | vp , vq , inj₁ st = nb-bwd vq vp st
    ... | vp , vq , inj₂ st = nb-fwd vq vp st

    star-rev : ∀ {p q} → Star p q → Star q p
    star-rev ε       = ε
    star-rev (m ◅ s) = star-rev s ◅◅ (nb-sym m ◅ ε)

    ≈→star : ∀ {p q} → sw ⊢ p ≈ q → Star p q
    ≈→star ≈-refl            = ε
    ≈→star (≈-step vp vq st) = nb-fwd vp vq st ◅ ε
    ≈→star (≈-sym e)         = star-rev (≈→star e)
    ≈→star (≈-trans e e′)    = ≈→star e ◅◅ ≈→star e′

    U-closed : ∀ {p q r} → q ∈L U p → r ∈L nb sw q → r ∈L U p
    U-closed {p} {q} {r} mq mr with ∈-filter⁻ (λ q → isYes (charge q ≟N charge p)) (allPaths (charge p) start end) mq
    ... | _ , t with nb-sound sw q mr
    ...   | _ , vr , st =
      ∈-filter⁺ (λ q → isYes (charge q ≟N charge p)) _
        (allPaths-has (charge p) start end r vr
          (subst (lengthL r ≤_) cr (length≤charge r)))
        (isYes-complete (charge r ≟N charge p) cr)
      where
      cq : charge q ≡ charge p
      cq = isYes-sound (charge q ≟N charge p) t
      cr : charge r ≡ charge p
      cr = trans (either st) cq
        where
        either : (Step sw q r ⊎ Step sw r q) → charge r ≡ charge q
        either (inj₁ s) = step-charge s
        either (inj₂ s) = sym (step-charge s)

    -- Connectivity, computed by breadth-first saturation.
    conn : RawPath → RawPath → Bool
    conn p q = isYes (mem? q (reachSet (lengthL (U p)) p))

    conn-sound : ∀ p q → T (conn p q) → sw ⊢ p ≈ q
    conn-sound p q t = star→≈ (reachSet-sound (lengthL (U p)) p (isYes-sound (mem? q _) t))

    conn-complete : ∀ {p q} → Valid p → sw ⊢ p ≈ q → T (conn p q)
    conn-complete {p} {q} vp e =
      isYes-complete (mem? q _)
        (Saturate.reachSet-complete (U p) (λ {x} {y} → U-closed {p} {x} {y}) (U-has vp) (≈→star e))

    -- Equality of 4-cells is decidable.
    eq? : ∀ {p} → Valid p → ∀ q → Dec (sw ⊢ p ≈ q)
    eq? {p} vp q with T? (conn p q)
    ... | yes t = yes (conn-sound p q t)
    ... | no ¬t = no λ e → ¬t (conn-complete vp e)

    -- Normal forms: the first path of the class in the enumeration.
    headOr : RawPath → List RawPath → RawPath
    headOr d []      = d
    headOr d (x ∷ _) = x

    -- (Computed through nfR so that the reachable set and the universe
    -- are computed once per path; nf-def says it is the definition above.)
    nfR : RawPath → List RawPath → List RawPath → RawPath
    nfR p R Up = headOr p (filter (λ x → isYes (mem? x R)) Up)

    nf : RawPath → RawPath
    nf p = nfU p (U p)
      where nfU : RawPath → List RawPath → RawPath
            nfU p Up = nfR p (reachSet (lengthL Up) p) Up

    nf-def : ∀ p → nf p ≡ headOr p (filter (conn p) (U p))
    nf-def p = refl

    nf-≈ : ∀ p → sw ⊢ nf p ≈ p
    nf-≈ p rewrite nf-def p with filter (conn p) (U p) in e
    ... | []     = ≈-refl
    ... | x ∷ xs with ∈-filter⁻ (conn p) (U p) (subst (x ∈L_) (sym e) here)
    ...   | _ , t = ≈-sym (conn-sound p x t)

    private
      bool-ext : ∀ {a b} → (T a → T b) → (T b → T a) → a ≡ b
      bool-ext {true}  {true}  f g = refl
      bool-ext {false} {false} f g = refl
      bool-ext {true}  {false} f g = ⊥-elim (f tt)
      bool-ext {false} {true}  f g = ⊥-elim (g tt)

      filter-cong : ∀ {A : Set} {f g : A → Bool} → (∀ x → f x ≡ g x) → ∀ xs → filter f xs ≡ filter g xs
      filter-cong h [] = refl
      filter-cong {f = f} {g} h (x ∷ xs) rewrite h x with g x
      ... | true  = cong (x ∷_) (filter-cong h xs)
      ... | false = filter-cong h xs

      headOr-any : ∀ {d d′ x} xs → x ∈L xs → headOr d xs ≡ headOr d′ xs
      headOr-any (_ ∷ _) _ = refl

    nf-cong : ∀ {p q} → Valid p → sw ⊢ p ≈ q → nf p ≡ nf q
    nf-cong {p} {q} vp e rewrite nf-def p | nf-def q =
      trans (headOr-any _ (∈-filter⁺ (conn p) (U p) (U-has vp) (conn-complete vp ≈-refl)))
        (cong (headOr q) (trans (filter-cong same (U p)) (cong (filter (conn q)) (cong Uc (≈-charge e)))))
      where
      vq : Valid q
      vq = fst (≈-valid e) vp
      same : ∀ x → conn p x ≡ conn q x
      same x = bool-ext (λ t → conn-complete vq (≈-trans (≈-sym e) (conn-sound p x t)))
                        (λ t → conn-complete vp (≈-trans e (conn-sound q x t)))

    nf-complete : ∀ {p q} → nf p ≡ nf q → sw ⊢ p ≈ q
    nf-complete {p} {q} eq = ≈-trans (≈-sym (nf-≈ p)) (subst (λ r → sw ⊢ r ≈ q) (sym eq) (nf-≈ q))

  open Setting using (nf; nf-≈; nf-cong; nf-complete; eq?) public

  ----------------------------------------------------------------------
  -- Comparison maps between settings (S ⊆ S′).

  _≤S_ : Switches → Switches → Set
  s ≤S s′ = (T (icc s) → T (icc s′)) × (T (rsp s) → T (rsp s′))

  private
    when-mono : ∀ {A : Set} {b b′} (xs : List A) {x} → (T b → T b′) → x ∈L when b xs → x ∈L when b′ xs
    when-mono {b = true} {true}  xs h m = m
    when-mono {b = true} {false} xs h m = ⊥-elim (h tt)

  splits-mono : ∀ {s s′} → s ≤S s′ → ∀ e {r} → r ∈L splits s e → r ∈L splits s′ e
  splits-mono {s} {s′} (i , j) e m with ∈-++⁻ (when (icc s) (leftS e)) m
  ... | inj₁ m′ = ∈-++ˡ (when (rsp s′) (rightS e)) (when-mono (leftS e) i m′)
  ... | inj₂ m′ = ∈-++ʳ (when (icc s′) (leftS e)) (when-mono (rightS e) j m′)

  ≈-mono : ∀ {s s′} → s ≤S s′ → ∀ {p q} → s ⊢ p ≈ q → s′ ⊢ p ≈ q
  ≈-mono le ≈-refl = ≈-refl
  ≈-mono le (≈-step vp vq (step pre e post m)) = ≈-step vp vq (step pre e post (splits-mono le e m))
  ≈-mono le (≈-sym x)     = ≈-sym (≈-mono le x)
  ≈-mono le (≈-trans x y) = ≈-trans (≈-mono le x) (≈-mono le y)

  -- The comparison F_{V+S} → F_{V+S′} on normal forms: renormalize the
  -- representative. It is well defined, and agrees with normalizing
  -- the original path directly.
  nf-compare : ∀ {s s′} → s ≤S s′ → ∀ {p} → Valid p → nf s′ (nf s p) ≡ nf s′ p
  nf-compare {s} {s′} le {p} vp =
    nf-cong s′ (snd (≈-valid (nf-≈ s p)) vp) (≈-mono le (nf-≈ s p))

  ----------------------------------------------------------------------
  -- The classes of a grid, from a complete repetition-free list of its
  -- valid paths: the paths that are their own normal form form a
  -- system of distinct representatives.

  nodup? : (xs : List RawPath) → Dec (NoDup xs)
  nodup? [] = yes []
  nodup? (x ∷ xs) with FG.mem? _≟P_ (λ _ → []) x xs | nodup? xs
  ... | yes m | _      = no λ { (¬m ∷ _) → ¬m m }
  ... | no ¬m | yes nd = yes (¬m ∷ nd)
  ... | no _  | no ¬nd = no λ { (_ ∷ nd) → ¬nd nd }

  nodup-filter : ∀ (f : RawPath → Bool) xs → NoDup xs → NoDup (filter f xs)
  nodup-filter f [] [] = []
  nodup-filter f (x ∷ xs) (¬m ∷ nd) with f x
  ... | true  = (λ m → ¬m (fst (∈-filter⁻ f xs m))) ∷ nodup-filter f xs nd
  ... | false = nodup-filter f xs nd

  module Classes (K : Nat) (sw : Switches) where
    raw : List RawPath
    raw = allPaths K start end

    reps : List RawPath
    reps = filter (λ p → isYes (nf sw p ≟P p)) raw

    reps-valid : ∀ {r} → r ∈L reps → Valid r
    reps-valid m = allPaths-sound K start end (fst (∈-filter⁻ _ raw m))

    reps-nf : ∀ {r} → r ∈L reps → nf sw r ≡ r
    reps-nf m = isYes-sound (nf sw _ ≟P _) (snd (∈-filter⁻ _ raw m))

    -- Distinct representatives are inequivalent.
    reps-apart : ∀ {r r′} → r ∈L reps → r′ ∈L reps → sw ⊢ r ≈ r′ → r ≡ r′
    reps-apart m m′ e =
      trans (sym (reps-nf m)) (trans (nf-cong sw (reps-valid m) e) (reps-nf m′))

    module _ (complete : runs (suc K) start ≡ []) where
      -- Every valid path is equivalent to a representative.
      reps-cover : ∀ {p} → Valid p → Σ RawPath λ r → (r ∈L reps) × (sw ⊢ p ≈ r)
      reps-cover {p} vp =
        nf sw p ,
        ∈-filter⁺ _ raw (allPaths-all K start end complete (nf sw p) vn)
          (isYes-complete (nf sw (nf sw p) ≟P nf sw p) (nf-cong sw vn (nf-≈ sw p))) ,
        ≈-sym (nf-≈ sw p)
        where
        vn : Valid (nf sw p)
        vn = snd (≈-valid (nf-≈ sw p)) vp

    reps-nodup : NoDup raw → NoDup reps
    reps-nodup = nodup-filter _ raw
