------------------------------------------------------------------------
-- The source-only joining completion of a quiver
-- (notes/conjectures/answered/directed-interchange-every-level-r7-
--  2026-11-18.md §1).
--
-- Q is a quiver with vertices V and two kinds of generating arrows:
-- inner arrows E and positive arrows P. For each positive α : s → t
-- and each inner path R : u → t we adjoin
--
--   j α R : s → u,          with j α [] the original α,
--
-- and impose, for e : u → v and R : v → t,
--
--   (1)   j α (e ∷ R) ; e  =  j α R.
--
-- Everything below holds for an ARBITRARY quiver (V, E, P): no
-- finiteness, no decidable equality, no acyclicity unless stated.
--
--   * The generators over α are indexed by the inner paths ending at
--     t α, by construction (Gen.jn). That is the count (2) of r7;
--     finiteness for a finite acyclic E is CaTTExp.Join.Finite.
--   * Orienting (1) as the contraction ⇒ gives a system with the
--     diamond property (diamond), hence confluence (confluent) and
--     Church–Rosser (church-rosser) with no termination argument;
--     ⇒ shortens words (⇒-len), so it terminates.
--   * Normal forms are unique (nf-unique). When inner arrows out of a
--     vertex have decidable equality they exist and are computed by
--     nf (module Normalise), and ~ is decided by comparing them.
--   * The equivalence ~ is the congruence generated by (1) (inst,
--     ~-++), so Word / ~ is the presented category C(Q).
--   * Original paths are normal (ι-normal) and the free path category
--     embeds faithfully (embed).
--   * Contractions keep the ordered list of positive seeds (seeds-~).
--   * Given a rank φ (inner arrows level, positive arrows strictly up)
--     and acyclic E, the completed quiver is acyclic (Rank.acyclic),
--     so supports of normal forms are injective (Rank.nf-supp).
--   * (5) C(Q)/(E = 1) ≅ Path(Q)/(E = 1), as the universal property:
--     functors to any category that kill E correspond, by restriction
--     along ι, to such functors out of Path(Q) (module Collapse).
------------------------------------------------------------------------
open import CaTTExp.Prelude
open import CaTTExp.Join.Quiver

module CaTTExp.Join.Completion {V : Set} (E P : V → V → Set) where

IPath : V → V → Set
IPath = Path E

-- Generating arrows of the completion.
data Gen : V → V → Set where
  inn : ∀ {a b} → E a b → Gen a b
  jn  : ∀ {s t u} → P s t → IPath u t → Gen s u

Word : V → V → Set
Word = Path Gen

-- Inner paths as words.
innW : ∀ {a b} → IPath a b → Word a b
innW []      = []
innW (e ∷ p) = inn e ∷ innW p

------------------------------------------------------------------------
-- The original quiver and its inclusion.

data Orig : V → V → Set where
  oe : ∀ {a b} → E a b → Orig a b
  op : ∀ {a b} → P a b → Orig a b

ιg : ∀ {a b} → Orig a b → Gen a b
ιg (oe e) = inn e
ιg (op α) = jn α []

ι : ∀ {a b} → Path Orig a b → Word a b
ι []      = []
ι (g ∷ p) = ιg g ∷ ι p

ι-++ : ∀ {a b c} (p : Path Orig a b) (q : Path Orig b c) → ι (p ++ᵖ q) ≡ ι p ++ᵖ ι q
ι-++ []      q = refl
ι-++ (g ∷ p) q = cong (ιg g ∷_) (ι-++ p q)

------------------------------------------------------------------------
-- Contraction: (1) oriented left to right, in any position.

infix 4 _⇒_ _⇒*_ _~_

data _⇒_ : ∀ {a b} → Word a b → Word a b → Set where
  ctr  : ∀ {s t u v c} (α : P s t) (e : E u v) (R : IPath v t) (w : Word v c) →
         jn α (e ∷ R) ∷ inn e ∷ w ⇒ jn α R ∷ w
  skip : ∀ {a b c} (g : Gen a b) {w w′ : Word b c} → w ⇒ w′ → g ∷ w ⇒ g ∷ w′

⇒-len : ∀ {a b} {w w′ : Word a b} → w ⇒ w′ → len w ≡ suc (len w′)
⇒-len (ctr α e R w) = refl
⇒-len (skip g s)    = cong suc (⇒-len s)

-- Closed under appending on the right.
⇒-++ʳ : ∀ {a b c} {w w′ : Word a b} (r : Word b c) → w ⇒ w′ → w ++ᵖ r ⇒ w′ ++ᵖ r
⇒-++ʳ r (ctr α e R w) = ctr α e R (w ++ᵖ r)
⇒-++ʳ r (skip g s)    = skip g (⇒-++ʳ r s)

⇒-++ˡ : ∀ {a b c} (l : Word a b) {w w′ : Word b c} → w ⇒ w′ → l ++ᵖ w ⇒ l ++ᵖ w′
⇒-++ˡ []      s = s
⇒-++ˡ (g ∷ l) s = skip g (⇒-++ˡ l s)

-- Every instance of (1) in context is one step.
inst : ∀ {a s t u v c} (l : Word a s) (α : P s t) (e : E u v) (R : IPath v t)
       (r : Word v c) →
       l ++ᵖ (jn α (e ∷ R) ∷ inn e ∷ r) ⇒ l ++ᵖ (jn α R ∷ r)
inst l α e R r = ⇒-++ˡ l (ctr α e R r)

-- Reflexive–transitive closure.
data _⇒*_ {a b} : Word a b → Word a b → Set where
  ε   : ∀ {w} → w ⇒* w
  _◅_ : ∀ {w w₁ w₂} → w ⇒ w₁ → w₁ ⇒* w₂ → w ⇒* w₂
infixr 5 _◅_ _◅◅_

_◅◅_ : ∀ {a b} {w w₁ w₂ : Word a b} → w ⇒* w₁ → w₁ ⇒* w₂ → w ⇒* w₂
ε       ◅◅ q = q
(s ◅ p) ◅◅ q = s ◅ (p ◅◅ q)

⇒*-skip : ∀ {a b c} (g : Gen a b) {w w′ : Word b c} → w ⇒* w′ → g ∷ w ⇒* g ∷ w′
⇒*-skip g ε       = ε
⇒*-skip g (s ◅ p) = skip g s ◅ ⇒*-skip g p

⇒*-++ˡ : ∀ {a b c} (l : Word a b) {w w′ : Word b c} → w ⇒* w′ → l ++ᵖ w ⇒* l ++ᵖ w′
⇒*-++ˡ l ε       = ε
⇒*-++ˡ l (s ◅ p) = ⇒-++ˡ l s ◅ ⇒*-++ˡ l p

⇒*-++ʳ : ∀ {a b c} {w w′ : Word a b} (r : Word b c) → w ⇒* w′ → w ++ᵖ r ⇒* w′ ++ᵖ r
⇒*-++ʳ r ε       = ε
⇒*-++ʳ r (s ◅ p) = ⇒-++ʳ r s ◅ ⇒*-++ʳ r p

-- The equivalence generated by ⇒.
data _~_ {a b} : Word a b → Word a b → Set where
  fwd    : ∀ {w w′} → w ⇒ w′ → w ~ w′
  rfl    : ∀ {w} → w ~ w
  sym~   : ∀ {w w′} → w ~ w′ → w′ ~ w
  trans~ : ∀ {w w′ w″} → w ~ w′ → w′ ~ w″ → w ~ w″

⇒*→~ : ∀ {a b} {w w′ : Word a b} → w ⇒* w′ → w ~ w′
⇒*→~ ε       = rfl
⇒*→~ (s ◅ p) = trans~ (fwd s) (⇒*→~ p)

-- ~ is a congruence for composition, so Word / ~ is the category
-- presented by the generators Gen and the equations (1).
~-++ˡ : ∀ {a b c} (l : Word a b) {w w′ : Word b c} → w ~ w′ → l ++ᵖ w ~ l ++ᵖ w′
~-++ˡ l (fwd s)      = fwd (⇒-++ˡ l s)
~-++ˡ l rfl          = rfl
~-++ˡ l (sym~ p)     = sym~ (~-++ˡ l p)
~-++ˡ l (trans~ p q) = trans~ (~-++ˡ l p) (~-++ˡ l q)

~-++ʳ : ∀ {a b c} {w w′ : Word a b} (r : Word b c) → w ~ w′ → w ++ᵖ r ~ w′ ++ᵖ r
~-++ʳ r (fwd s)      = fwd (⇒-++ʳ r s)
~-++ʳ r rfl          = rfl
~-++ʳ r (sym~ p)     = sym~ (~-++ʳ r p)
~-++ʳ r (trans~ p q) = trans~ (~-++ʳ r p) (~-++ʳ r q)

~-++ : ∀ {a b c} {w w′ : Word a b} {r r′ : Word b c} → w ~ w′ → r ~ r′ →
       w ++ᵖ r ~ w′ ++ᵖ r′
~-++ {w′ = w′} {r = r} p q = trans~ (~-++ʳ r p) (~-++ˡ w′ q)

------------------------------------------------------------------------
-- Confluence. Left-hand sides have types (positive, inner), so two of
-- them never overlap: ⇒ has the diamond property.

diamond : ∀ {a b} {w w₁ w₂ : Word a b} → w ⇒ w₁ → w ⇒ w₂ →
          (w₁ ≡ w₂) ⊎ Σ (Word a b) λ w₃ → (w₁ ⇒ w₃) × (w₂ ⇒ w₃)
diamond (ctr α e R w) (ctr .α .e .R .w) = inj₁ refl
diamond (ctr α e R w) (skip _ (skip _ s)) = inj₂ (_ , skip _ s , ctr α e R _)
diamond (skip _ (skip _ s)) (ctr α e R w) = inj₂ (_ , ctr α e R _ , skip _ s)
diamond (skip g s) (skip .g s′) with diamond s s′
... | inj₁ refl           = inj₁ refl
... | inj₂ (w₃ , p , q)   = inj₂ (g ∷ w₃ , skip g p , skip g q)

private
  -- One step against many.
  strip : ∀ {a b} {w w₁ w₂ : Word a b} → w ⇒ w₁ → w ⇒* w₂ →
          Σ (Word a b) λ c → (w₁ ⇒* c) × ((w₂ ≡ c) ⊎ (w₂ ⇒ c))
  strip s ε = _ , ε , inj₂ s
  strip s (t ◅ p) with diamond s t
  ... | inj₁ refl = _ , p , inj₁ refl
  ... | inj₂ (d , s′ , t′) with strip t′ p
  ...   | c , q , r = c , s′ ◅ q , r

confluent : ∀ {a b} {w w₁ w₂ : Word a b} → w ⇒* w₁ → w ⇒* w₂ →
            Σ (Word a b) λ c → (w₁ ⇒* c) × (w₂ ⇒* c)
confluent ε q = _ , q , ε
confluent (s ◅ p) q with strip s q
... | d , q′ , inj₁ refl with confluent p q′
...   | c , x , y = c , x , y
confluent (s ◅ p) q | d , q′ , inj₂ t with confluent p q′
...   | c , x , y = c , x , t ◅ y

church-rosser : ∀ {a b} {w w′ : Word a b} → w ~ w′ →
                Σ (Word a b) λ c → (w ⇒* c) × (w′ ⇒* c)
church-rosser (fwd s) = _ , s ◅ ε , ε
church-rosser rfl     = _ , ε , ε
church-rosser (sym~ p) with church-rosser p
... | c , x , y = c , y , x
church-rosser (trans~ p q) with church-rosser p | church-rosser q
... | c , x , y | d , y′ , z with confluent y y′
...   | f , u , v = f , x ◅◅ u , z ◅◅ v

------------------------------------------------------------------------
-- Normal forms are unique.

Normal : ∀ {a b} → Word a b → Set
Normal w = ∀ w′ → ¬ (w ⇒ w′)

normal-⇒* : ∀ {a b} {n c : Word a b} → Normal n → n ⇒* c → n ≡ c
normal-⇒* nn ε       = refl
normal-⇒* nn (s ◅ _) = ⊥-elim (nn _ s)

nf-unique : ∀ {a b} {n n′ : Word a b} → Normal n → Normal n′ → n ~ n′ → n ≡ n′
nf-unique nn nn′ p with church-rosser p
... | c , x , y = trans (normal-⇒* nn x) (sym (normal-⇒* nn′ y))

------------------------------------------------------------------------
-- Original paths are irreducible, and Path(Q) embeds faithfully.

ι-normal : ∀ {a b} (p : Path Orig a b) → Normal (ι p)
ι-normal (oe e ∷ p) _ (skip _ s) = ι-normal p _ s
ι-normal (op α ∷ p) _ (skip _ s) = ι-normal p _ s

private
  hd : ∀ {a b} → Word a b → Maybe (Σ V (Gen a))
  hd []      = nothing
  hd (g ∷ w) = just (_ , g)

  tl : ∀ {a b} → Word a b → Σ V λ c → Word c b
  tl {a} []  = a , []
  tl (g ∷ w) = _ , w

  Σ-inj : ∀ {A : Set} {B : A → Set} {x} {y z : B x} →
          _≡_ {A = Σ A B} (x , y) (x , z) → y ≡ z
  Σ-inj refl = refl

  ιg-inj : ∀ {a c c′} (g : Orig a c) (h : Orig a c′) →
           _≡_ {A = Maybe (Σ V (Gen a))} (just (c , ιg g)) (just (c′ , ιg h)) →
           _≡_ {A = Σ V (Orig a)} (c , g) (c′ , h)
  ιg-inj (oe e) (oe .e) refl = refl
  ιg-inj (op α) (op .α) refl = refl
  ιg-inj (oe e) (op α)  ()
  ιg-inj (op α) (oe e)  ()

ι-inj : ∀ {a b} (p q : Path Orig a b) → ι p ≡ ι q → p ≡ q
ι-inj []      []      _ = refl
ι-inj []      (h ∷ q) ()
ι-inj (g ∷ p) []      ()
ι-inj (g ∷ p) (h ∷ q) eq with ιg-inj g h (cong hd eq)
... | refl = cong (g ∷_) (ι-inj p q (Σ-inj (cong tl eq)))

embed : ∀ {a b} (p q : Path Orig a b) → ι p ~ ι q → p ≡ q
embed p q r = ι-inj p q (nf-unique (ι-normal p) (ι-normal q) r)

------------------------------------------------------------------------
-- Contractions keep the ordered list of positive seeds.

record Seed : Set where
  constructor seed
  field
    {from to} : V
    arrow     : P from to

seeds : ∀ {a b} → Word a b → List Seed
seeds []           = []
seeds (inn e ∷ w)  = seeds w
seeds (jn α R ∷ w) = seed α ∷ seeds w

seeds-⇒ : ∀ {a b} {w w′ : Word a b} → w ⇒ w′ → seeds w ≡ seeds w′
seeds-⇒ (ctr α e R w)     = refl
seeds-⇒ (skip (inn e) s)  = seeds-⇒ s
seeds-⇒ (skip (jn α R) s) = cong (seed α ∷_) (seeds-⇒ s)

seeds-~ : ∀ {a b} {w w′ : Word a b} → w ~ w′ → seeds w ≡ seeds w′
seeds-~ (fwd s)      = seeds-⇒ s
seeds-~ rfl          = refl
seeds-~ (sym~ p)     = sym (seeds-~ p)
seeds-~ (trans~ p q) = trans (seeds-~ p) (seeds-~ q)

------------------------------------------------------------------------
-- Existence of normal forms, when inner arrows out of each vertex have
-- decidable equality.

module Normalise (decE : ∀ {u} (x y : Σ V (E u)) → Dec (x ≡ y)) where

  -- Put a generator in front of a normal word.
  push : ∀ {a b c} → Gen a b → Word b c → Word a c
  push (inn e)        w             = inn e ∷ w
  push (jn α [])      w             = jn α [] ∷ w
  push (jn α (e ∷ R)) []            = jn α (e ∷ R) ∷ []
  push (jn α (e ∷ R)) (jn β S ∷ w)  = jn α (e ∷ R) ∷ jn β S ∷ w
  push (jn α (e ∷ R)) (inn e′ ∷ w) with decE (_ , e) (_ , e′)
  ... | yes refl = push (jn α R) w
  ... | no _     = jn α (e ∷ R) ∷ inn e′ ∷ w

  push-red : ∀ {a b c} (g : Gen a b) (w : Word b c) → g ∷ w ⇒* push g w
  push-red (inn e)        w            = ε
  push-red (jn α [])      w            = ε
  push-red (jn α (e ∷ R)) []           = ε
  push-red (jn α (e ∷ R)) (jn β S ∷ w) = ε
  push-red (jn α (e ∷ R)) (inn e′ ∷ w) with decE (_ , e) (_ , e′)
  ... | yes refl = ctr α e R w ◅ push-red (jn α R) w
  ... | no _     = ε

  push-nf : ∀ {a b c} (g : Gen a b) (w : Word b c) → Normal w → Normal (push g w)
  push-nf (inn e)        w            nw _ (skip _ s) = nw _ s
  push-nf (jn α [])      w            nw _ (skip _ s) = nw _ s
  push-nf (jn α (e ∷ R)) []           nw _ (skip _ s) = nw _ s
  push-nf (jn α (e ∷ R)) (jn β S ∷ w) nw _ (skip _ s) = nw _ s
  push-nf (jn α (e ∷ R)) (inn e′ ∷ w) nw with decE (_ , e) (_ , e′)
  ... | yes refl = push-nf (jn α R) w (λ w′ s → nw _ (skip _ s))
  ... | no ne = λ { _ (ctr _ _ _ _) → ne refl ; _ (skip _ s) → nw _ s }

  nf : ∀ {a b} → Word a b → Word a b
  nf []      = []
  nf (g ∷ w) = push g (nf w)

  nf-red : ∀ {a b} (w : Word a b) → w ⇒* nf w
  nf-red []      = ε
  nf-red (g ∷ w) = ⇒*-skip g (nf-red w) ◅◅ push-red g (nf w)

  nf-normal : ∀ {a b} (w : Word a b) → Normal (nf w)
  nf-normal []      _ ()
  nf-normal (g ∷ w) = push-nf g (nf w) (nf-normal w)

  -- ~ is decided by normal forms.
  nf-sound : ∀ {a b} {w w′ : Word a b} → w ~ w′ → nf w ≡ nf w′
  nf-sound {w = w} {w′} p =
    nf-unique (nf-normal w) (nf-normal w′)
      (trans~ (sym~ (⇒*→~ (nf-red w))) (trans~ p (⇒*→~ (nf-red w′))))

  nf-complete : ∀ {a b} {w w′ : Word a b} → nf w ≡ nf w′ → w ~ w′
  nf-complete {w = w} {w′} eq =
    trans~ (⇒*→~ (nf-red w))
      (subst (λ z → z ~ w′) (sym eq) (sym~ (⇒*→~ (nf-red w′))))

------------------------------------------------------------------------
-- A rank makes the completed quiver acyclic, so supports of normal
-- forms are injective.

module Rank (O : Set) (_<_ : O → O → Set)
            (<-trans : ∀ {x y z} → x < y → y < z → x < z)
            (<-irrefl : ∀ {x} → ¬ (x < x))
            (φ : V → O)
            (φE : ∀ {a b} → E a b → φ a ≡ φ b)
            (φP : ∀ {a b} → P a b → φ a < φ b)
            (acycE : ∀ {a} (p : IPath a a) → p ≡ []) where

  φI : ∀ {a b} → IPath a b → φ a ≡ φ b
  φI []      = refl
  φI (e ∷ p) = trans (φE e) (φI p)

  -- Every joining generator j α R : s → u strictly raises φ.
  φJ : ∀ {s t u} (α : P s t) (R : IPath u t) → φ s < φ u
  φJ α R = subst (φ _ <_) (sym (φI R)) (φP α)

  -- A word is all inner, or strictly raises φ.
  classify : ∀ {a b} (w : Word a b) →
             (Σ (IPath a b) λ p → w ≡ innW p) ⊎ (φ a < φ b)
  classify [] = inj₁ ([] , refl)
  classify {b = b} (inn e ∷ w) with classify w
  ... | inj₁ (p , refl) = inj₁ (e ∷ p , refl)
  ... | inj₂ lt         = inj₂ (subst (λ x → x < φ b) (sym (φE e)) lt)
  classify (jn α R ∷ w) with classify w
  ... | inj₁ (p , _) = inj₂ (subst (φ _ <_) (φI p) (φJ α R))
  ... | inj₂ lt      = inj₂ (<-trans (φJ α R) lt)

  acyclic : ∀ {a} (w : Word a a) → w ≡ []
  acyclic w with classify w
  ... | inj₂ lt = ⊥-elim (<-irrefl lt)
  ... | inj₁ (p , refl) with acycE p
  ...   | refl = refl

  open Acyclic Gen acyclic public

  -- Same-hom version: normal forms with the same support coincide, so
  -- the words they normalise are equal in the completion.
  nf-supp : ∀ {a b} {w w′ n n′ : Word a b} →
            w ⇒* n → Normal n → w′ ⇒* n′ → Normal n′ → SameSupp n n′ → w ~ w′
  nf-supp {w′ = w′} r nn r′ nn′ s with supp-inj _ _ s
  ... | refl = trans~ (⇒*→~ r) (sym~ (⇒*→~ r′))

------------------------------------------------------------------------
-- (5): C(Q)/(E = 1) ≅ Path(Q)/(E = 1), as a universal property.
--
-- A functor out of a free category is a map of generators, and a
-- functor that sends each inner arrow e : a → b to an identity is a
-- vertex map with F a ≡ F b, sent to the transported identity. With
-- the unit law, (1) then says F(j α (e ∷ R)) = F(j α R) after that
-- transport. So for any category with objects Ob and homs Hom, the
-- E-killing functors out of Path(Q) are KillQ and those out of C(Q)
-- are KillC below, and restriction along ι is a bijection between them
-- (extend, restrict-extend, extend-unique), pointwise on generators.

module Collapse (Ob : Set) (Hom : Ob → Ob → Set) where

  record KillQ : Set where
    field
      F₀  : V → Ob
      Feq : ∀ {a b} → E a b → F₀ a ≡ F₀ b
      FP  : ∀ {s t} → P s t → Hom (F₀ s) (F₀ t)

  record KillC : Set where
    field
      F₀  : V → Ob
      Feq : ∀ {a b} → E a b → F₀ a ≡ F₀ b
      FJ  : ∀ {s t u} → P s t → IPath u t → Hom (F₀ s) (F₀ u)
      F1  : ∀ {s t u v} (α : P s t) (e : E u v) (R : IPath v t) →
            subst (Hom (F₀ s)) (Feq e) (FJ α (e ∷ R)) ≡ FJ α R

  private
    Feq* : ∀ {F₀ : V → Ob} (Feq : ∀ {a b} → E a b → F₀ a ≡ F₀ b) →
           ∀ {u t} → IPath u t → F₀ u ≡ F₀ t
    Feq* Feq []      = refl
    Feq* Feq (e ∷ R) = trans (Feq e) (Feq* Feq R)

    tr-tr : ∀ {A : Set} (H : A → Set) {x y z : A} (p : x ≡ y) (r : y ≡ z) (h : H z) →
            subst H p (subst H (sym (trans p r)) h) ≡ subst H (sym r) h
    tr-tr H refl refl h = refl

    tr-back : ∀ {A : Set} (H : A → Set) {x y z : A} (p : x ≡ y) (r : y ≡ z)
              {h : H x} {k : H z} →
              subst H p h ≡ subst H (sym r) k → h ≡ subst H (sym (trans p r)) k
    tr-back H refl refl q = q

  -- Restriction along ι.
  restrict : KillC → KillQ
  restrict F = record { F₀ = F₀ ; Feq = Feq ; FP = λ α → FJ α [] }
    where open KillC F

  -- The unique extension.
  extend : KillQ → KillC
  extend F = record
    { F₀ = F₀ ; Feq = Feq
    ; FJ = λ {s} α R → subst (Hom (F₀ s)) (sym (Feq* Feq R)) (FP α)
    ; F1 = λ {s} α e R → tr-tr (Hom (F₀ s)) (Feq e) (Feq* Feq R) (FP α) }
    where open KillQ F

  restrict-extend : ∀ (F : KillQ) {s t} (α : P s t) →
                    KillQ.FP (restrict (extend F)) α ≡ KillQ.FP F α
  restrict-extend F α = refl

  -- Any E-killing functor out of C(Q) is the extension of its
  -- restriction: it is determined by the images of the original seeds.
  extend-unique : ∀ (F : KillC) {s t u} (α : P s t) (R : IPath u t) →
                  KillC.FJ F α R ≡ KillC.FJ (extend (restrict F)) α R
  extend-unique F α []      = refl
  extend-unique F {s} α (e ∷ R) =
    tr-back (Hom (F₀ s)) (Feq e) (Feq* Feq R)
      (trans (F1 α e R) (extend-unique F α R))
    where open KillC F
